local function Toggle(name, default, cb)
    local state = default
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 32)
    b.BackgroundColor3 = state and Color3.fromRGB(60, 180, 90) or Color3.fromRGB(45, 45, 55)
