-- ============ SERVER HOP (как Infinite Yield) ============
local function ServerHop()
    QueueNext() -- чтобы скрипт сам запустился на новом сервере
    local placeId = PLACE_ID
    local cursor = ""
    local visited = getgenv and getgenv()._GiantRaidVisited or {}
    local myJob = game.JobId
    visited[myJob] = true
    Notify("Giant Raid", "Гигантов нет, хопаю...")
    task.wait(1)
    local ok, err = pcall(function()
        local tries = 0
        while tries < 5 do
            tries = tries + 1
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
            local resp = game:HttpGet(url)
            local data = HttpService:JSONDecode(resp)
            cursor = data.nextPageCursor or ""
            if data.data then
                for _, s in ipairs(data.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= myJob and not visited[s.id] then
                        visited[s.id] = true
                        TeleportService:TeleportToPlaceInstance(placeId, s.id, LocalPlayer)
                        task.wait(3)
                        return
                    end
                end
            end
            if cursor == "" or cursor == nil then break end
        end
        -- если все обошли / не нашли - просто ре-телепорт в этот же плейс (другой сервер)
        TeleportService:Teleport(placeId, LocalPlayer)
    end)
    if not ok then
        Notify("Giant Raid", "Хоп не вышел, пробую обычный Teleport")
        pcall(function() TeleportService:Teleport(placeId, LocalPlayer) end)
    end
end

-- ============ MAIN LOOP ============
task.spawn(function()
    local timer = 0
    QueueNext() -- сразу ставим в очередь, чтобы работало после хопа
    while gui.Parent do
        task.wait(1)
        if not running then
            Status.Text = "Пауза. Нажми Стоп/Старт."
        else
            if hopNow then hopNow = false timer = 999 end
            local giants = {}
            pcall(function() giants = FindGiants() end)
            if #giants > 0 then
                timer = 0
                local g = giants[1]
                Status.Text = "НАШЁЛ ГИГАНТА: " .. g.name .. " | " .. g.hp .. "/" .. g.maxHp .. "HP (" .. g.reason .. ")"
                Notify("GIANT FOUND", g.name .. " " .. g.hp .. "HP")
                -- подсветка
                pcall(function()
                    local c = g.player and g.player.Character or nil
                    if c and not c:FindFirstChild("_GIANT_HL") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "_GIANT_HL"
                        hl.FillColor = Color3.fromRGB(170, 60, 255)
                        hl.OutlineColor = Color3.fromRGB(220, 170, 255)
                        hl.FillTransparency = 0.4
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = c
                    end
                end)
                -- авто-тп
                if AUTO_TP_TO_GIANT and g.hrp then
                    pcall(function()
                        local my = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if my then my.CFrame = g.hrp.CFrame + Vector3.new(0, 3, 6) end
                    end)
                end
                task.wait(5) -- не спамим, даём время на рейд
            else
                timer = timer + 1
                local left = math.max(0, HOP_DELAY - timer)
                Status.Text = "Гигантов: 0 | Онлайн: " .. #Players:GetPlayers() .. " | Хоп через " .. left .. "с"
                if AUTO_HOP and timer >= HOP_DELAY then
                    timer = 0
                    ServerHop()
                    task.wait(5)
                end
            end
        end
    end
end)

