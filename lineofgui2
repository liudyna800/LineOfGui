local activeRows = {} -- созданные строки: чистим точно их, дубли исключены
local function RefreshGiantsList(giants)
    pcall(function()
        for _, r in ipairs(activeRows) do
            pcall(function() r:Destroy() end)
        end
        activeRows = {}
        for _, ch in ipairs(GiantsList:GetChildren()) do
            if ch.Name == "_GRow" then
                pcall(function() ch:Destroy() end)
            end
        end
        ListTitle.Text = "Гиганты на сервере: " .. #giants
        local maxRows = 6 -- 6x30 + отступы = 200px ровно
        for i = 1, math.min(#giants, maxRows) do
            local g = giants[i]
            local l = Instance.new("TextButton")
            l.Name = "_GRow"
            l.Size = UDim2.new(1, -8, 0, 30)
            l.BackgroundColor3 = Color3.fromRGB(50, 35, 75)
            l.BorderSizePixel = 0
            l.Active = true
            l.AutoButtonColor = true
            l.Font = Enum.Font.GothamBold
            l.TextSize = 11
            l.TextColor3 = Color3.new(1, 1, 1)
            l.TextWrapped = true
            l.TextTruncate = Enum.TextTruncate.AtEnd
            local mark = (flinging and flingTarget == g.player) and "> " or ""
            l.Text = mark .. i .. ". " .. g.name .. " " .. g.hp .. "/" .. g.maxHp
            l.Parent = GiantsList
            table.insert(activeRows, l)
            Instance.new("UICorner", l).CornerRadius = UDim.new(0, 6)
            local target = g.player
            local t0 = 0
            local function onTap()
                local now = tick()
                if now - t0 < 0.4 then return end
                t0 = now
                if target == nil then return end
                if flinging and flingTarget == target then
                    StopFling(false)
                else
                    StartFling(target)
                end
            end
            l.Activated:Connect(onTap)
            l.MouseButton1Click:Connect(onTap)
            l.TouchTap:Connect(onTap)
        end
        if #giants > maxRows then
            ListTitle.Text = "Гиганты: " .. #giants .. " (первые " .. maxRows .. ")"
        end
    end)
end

-- ============ SERVER HOP (как Infinite Yield) ============
local function ServerHop()
    QueueSelf() -- очередь ПЕРЕД телепортом, иначе авто-запуска не будет
    if not IsCurrentGen() then return end -- нас уже сменила новая копия, не хопаем
    StopFling(true) -- снять флинг перед хопом
    local placeId = PLACE_ID
    local cursor = ""
    local visited = getgenv and getgenv()._GiantRaidVisited or {}
    local myJob = game.JobId
    visited[myJob] = true
    Notify("Giant Raid", "Гигантов нет, ищу сервер 8+ ...")
    task.wait(1)
    local ok, err = pcall(function()
        -- Desc = сначала самые полные. Баг был: Asc брал мелкие 1-5.
        local tries = 0
        local bestMedium, bestMediumInfo, bestAny, bestAnyInfo = nil, nil, nil, nil
        while tries < 5 and bestMedium == nil do
            tries = tries + 1
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
            local resp = game:HttpGet(url)
            local data = HttpService:JSONDecode(resp)
            cursor = data.nextPageCursor or ""
            if data.data then
                for _, s in ipairs(data.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= myJob and not visited[s.id] then
                        if bestAny == nil then bestAny, bestAnyInfo = s.id, s.playing .. "/" .. s.maxPlayers end
                        if s.playing >= MIN_PLAYERS then
                            bestMedium, bestMediumInfo = s.id, s.playing .. "/" .. s.maxPlayers
                            break
                        end
                    end
                end
            end
            if cursor == "" or cursor == nil then break end
        end
        local target, info = bestMedium, bestMediumInfo
        if target == nil then target, info = bestAny, bestAnyInfo end
        if target ~= nil then
            visited[target] = true
            Notify("Giant Raid", "Хоп на сервер (" .. tostring(info) .. ")")
            TeleportService:TeleportToPlaceInstance(placeId, target, LocalPlayer)
            task.wait(3)
            return
        end
        TeleportService:Teleport(placeId, LocalPlayer)
    end)
    if not ok then
        Notify("Giant Raid", "Хоп не вышел, пробую обычный Teleport")
        pcall(function() TeleportService:Teleport(placeId, LocalPlayer) end)
    end
end

