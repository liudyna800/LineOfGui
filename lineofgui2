-- Определение смайлера: Team + атрибуты + лицо
local function IsSmiler(plr)
    if not plr or not plr.Character then return false end
    local ok, res = pcall(function()
        -- 1. Team
        if plr.Team and plr.Team.Name then
            local t = string.lower(plr.Team.Name)
            if string.find(t, "smile") or string.find(t, "infect") or string.find(t, "monster") then
                return true
            end
            if string.find(t, "human") or string.find(t, "surviv") then
                return false
            end
        end
        -- 2. Атрибуты / Values
        local c = plr.Character
        if c:GetAttribute("Infected") == true then return true end
        if c:GetAttribute("Smiler") == true then return true end
        if c:GetAttribute("IsSmile") == true then return true end
        if c:GetAttribute("IsSmiler") == true then return true end
        if plr:GetAttribute("Infected") == true then return true end
        if plr:GetAttribute("IsSmiler") == true then return true end
        if c:FindFirstChild("Infected") or c:FindFirstChild("Smiler") or c:FindFirstChild("IsSmiler") then return true end
        if plr:FindFirstChild("IsSmiler") or plr:FindFirstChild("Infected") then return true end
        local role = plr:FindFirstChild("Role") or c:FindFirstChild("Role")
        if role and role.Value then
            local rv = string.lower(tostring(role.Value))
            if string.find(rv, "smile") or string.find(rv, "infect") then return true end
        end
        -- 3. Лицо Winning Smile (ID 20573078 / 180399745 и варианты)
        local head = c:FindFirstChild("Head")
        if head then
            for _, d in ipairs(head:GetChildren()) do
                if d:IsA("Decal") and d.Texture then
                    local tx = string.lower(d.Texture)
                    if string.find(tx, "20573078") or string.find(tx, "180399745")
                    or string.find(tx, "264235874") or string.find(tx, "winning") then
                        return true
                    end
                end
            end
        end
        return nil -- неизвестно
    end)
    if not ok then return false end
    if res == nil then return false end
    return res
end

-- Поиск ремоутов для аур / нокулдауна
local GrabRemotes = {}
local HitRemotes = {}
do
    pcall(function()
        for _, d in ipairs(game:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                local n = string.lower(d.Name)
                if string.find(n, "grab") or string.find(n, "infect") or string.find(n, "smile") or string.find(n, "bite") then
                    table.insert(GrabRemotes, d)
                end
                if string.find(n, "hit") or string.find(n, "attack") or string.find(n, "damage") or string.find(n, "swing") or string.find(n, "weapon") then
                    table.insert(HitRemotes, d)
                end
            end
        end
    end)
end

local function FireRemotes(list, ...)
    for _, r in ipairs(list) do
        pcall(function()
            if r:IsA("RemoteEvent") then r:FireServer(...) end
        end)
    end
end

local function GetTool()
    local c = GetChar()
    if not c then return nil end
    local t = c:FindFirstChildOfClass("Tool")
    if t then return t end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then return tool end
        end
    end
    return nil
end

local function EquipTool(tool)
    if not tool then return end
    pcall(function()
        local hum = GetHum()
        if hum and tool.Parent ~= GetChar() then
            hum:EquipTool(tool)
        end
    end)
end

