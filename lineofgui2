local function SliderBtn(name, min, max, default, cb)
    local val = default
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 32)
    b.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    b.Font = Enum.Font.GothamBold
