-- ============ REMOTES SCAN ============
local InfectRemotes, DoorRemotes, TrapRemotes, MorphRemotes, MiscRemotes = {}, {}, {}, {}, {}
local function ScanRemotes()
    table.clear(InfectRemotes) table.clear(DoorRemotes) table.clear(TrapRemotes) table.clear(MorphRemotes) table.clear(MiscRemotes)
    pcall(function()
        for _, d in ipairs(game:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                local n = string.lower(d.Name)
                local full = string.lower(d:GetFullName())
                local function has(list)
                    for _, k in ipairs(list) do
                        if string.find(n, k, 1, true) or string.find(full, k, 1, true) then return true end
                    end
                    return false
                end
                if has({"infect", "kill", "catch", "jumpscare", "tag", "attack", "damage", "down"}) then table.insert(InfectRemotes, d) end
                if has({"door", "gate", "vent", "exit", "escape", "keydoor", "laser", "open", "close", "unlock", "lock"}) then table.insert(DoorRemotes, d) end
                if has({"trap", "place", "slow"}) then table.insert(TrapRemotes, d) end
                if has({"morph", "piggy", "skin", "character", "become", "spawnpiggy"}) then table.insert(MorphRemotes, d) end
                if has({"lever", "button", "switch", "plank", "key", "item", "pickup", "use", "interact", "prompt", "build"}) then table.insert(MiscRemotes, d) end
            end
        end
    end)
end
ScanRemotes()
pcall(function()
    game.DescendantAdded:Connect(function(d)
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then task.delay(1, ScanRemotes) end
    end)
end)

local function FireList(list, ...)
    local args = {...}
    for _, r in ipairs(list) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                if #args > 0 then r:FireServer(unpack(args)) else r:FireServer() end
            elseif r:IsA("RemoteFunction") then
                -- RemoteFunction не спамим без нужды (может виснуть), только с pcall+таймаут невозможен -> пропускаем
            end
        end)
    end
end

-- Поиск интерактивов в Build Mode картах
local function GetPrompts(maxDist, allMap)
    local out = {}
    local my = GetHRP()
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local par = d.Parent
                if par and par:IsA("BasePart") then
                    local dist = my and (my.Position - par.Position).Magnitude or 0
                    if allMap or (my and dist <= (maxDist or 30)) then
                        table.insert(out, {prompt = d, part = par, dist = dist, name = par.Name})
                    end
                elseif par and par:IsA("Model") then
                    local main = par:FindFirstChildWhichIsA("BasePart", true)
                    if main then
                        local dist = my and (my.Position - main.Position).Magnitude or 0
                        if allMap or (my and dist <= (maxDist or 30)) then
                            table.insert(out, {prompt = d, part = main, dist = dist, name = par.Name})
                        end
                    end
                end
            end
        end
    end)
    return out
end

local function GetClickDetectors(maxDist, allMap)
    local out = {}
    local my = GetHRP()
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ClickDetector") and d.Parent and d.Parent:IsA("BasePart") then
                local dist = my and (my.Position - d.Parent.Position).Magnitude or 0
                if allMap or (my and dist <= (maxDist or 30)) then
                    table.insert(out, {cd = d, part = d.Parent, dist = dist})
                end
            end
        end
    end)
    return out
end

local function GetDoors()
    local out = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("Model") then
                local n = string.lower(d.Name)
                if string.find(n, "door") or string.find(n, "gate") or string.find(n, "vent") or string.find(n, "exit") or string.find(n, "escape") then
                    local main = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
                    if main then table.insert(out, {model = d, pos = main.Position, name = d.Name}) end
                end
            elseif d:IsA("BasePart") then
                local n = string.lower(d.Name)
                if n == "exitdoor" or n == "exit" or string.find(n, "keydoor") then
                    table.insert(out, {model = d, pos = d.Position, name = d.Name})
                end
            end
        end
    end)
    return out
end

local function GetTraps()
    local out = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            local n = string.lower(d.Name)
            if d:IsA("Model") and (string.find(n, "trap") or string.find(n, "slow")) then
                local main = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
                if main then table.insert(out, {model = d, pos = main.Position, name = d.Name}) end
            elseif d:IsA("BasePart") and string.find(n, "trap") then
                table.insert(out, {model = d, pos = d.Position, name = d.Name})
            end
        end
    end)
    return out
end

local function SpamPrompts(list)
    if not fireproximityprompt then return 0 end
    local n = 0
    for _, e in ipairs(list) do
        pcall(function()
            if e.prompt and e.prompt.Enabled then
                -- fireproximityprompt не чекает дистанцию на части эксплоитов -> работает по всей карте
                fireproximityprompt(e.prompt)
                n = n + 1
            end
        end)
    end
    return n
end

local function SpamClicks(list)
    if not fireclickdetector then return 0 end
    local n = 0
    for _, e in ipairs(list) do
        pcall(function() fireclickdetector(e.cd) n = n + 1 end)
    end
    return n
end

local function TouchPlayer(targetPlr)
    -- заразить тачем: свой HRP/Tool.Handle -> чужой HRP/Head/Torso
    pcall(function()
        if not firetouchinterest then return end
        local myHRP = GetHRP()
        local tc = targetPlr.Character
        if not myHRP or not tc then return end
        local parts = {}
        for _, nm in ipairs({"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso"}) do
            local p = tc:FindFirstChild(nm)
            if p then table.insert(parts, p) end
        end
        local myTool = GetChar():FindFirstChildOfClass("Tool")
        local myHandle = myTool and myTool:FindFirstChild("Handle") or nil
        for _, tp in ipairs(parts) do
            firetouchinterest(myHRP, tp, 0) task.wait() firetouchinterest(myHRP, tp, 1)
            if myHandle then
                firetouchinterest(myHandle, tp, 0) task.wait() firetouchinterest(myHandle, tp, 1)
            end
        end
    end)
end

local function InfectPlayer(targetPlr)
    -- 1. ремоуты заражения
    FireList(InfectRemotes, targetPlr)
    FireList(InfectRemotes, targetPlr.Name)
    FireList(InfectRemotes)
    pcall(function()
        local tc = targetPlr.Character
        local hrp = tc and tc:FindFirstChild("HumanoidRootPart")
        if hrp then
            FireList(InfectRemotes, hrp)
            FireList(InfectRemotes, tc)
        end
    end)
    -- 2. тач-заражение
    TouchPlayer(targetPlr)
end

