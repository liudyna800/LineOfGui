    if not S.ItemRadar then return end
    pcall(function()
        for _,o in pairs(Workspace:GetDescendants()) do
            if o:IsA("Tool") or o:IsA("BasePart") and (o.Name:lower():find("potion") or o.Name:lower():find("taser") or o.Name:lower():find("coin")) then
                local m=o:IsA("Tool") and o or o.Parent
                local pos = o:IsA("BasePart") and o.Position or (o:IsA("Tool") and o.Handle and o.Handle.Position)
                local low=o.Name:lower()
