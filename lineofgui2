        end
    end)
end

-- Взять биту: сначала точный вендор из структуры игры, потом запасные пути
local function FetchBat()
    local myHRP = MyHRP()
    if not myHRP then return false end
    local wName = GetMainWeaponName()
    local have = FindBat()
    if have then EquipBat(have) return true end
    -- 1. точный вендор: Map.HumanBase.Vendor.BatCollection.
    -- Тепаемся в коллекцию ПОКА НЕ ВОЗЬМЁТ: если не взяло - теп ещё раз.
    -- Цикл зовётся каждый тик убийцы, так что добивка бесконечная.
    pcall(function()
        local col = workspace.Map.HumanBase.Vendor.BatCollection
        if col then
            local hb = col:FindFirstChild("HitBox")
            local det = col:FindFirstChild("ClickDetector")
            if hb and hb:IsA("BasePart") and det then
                local t0 = tick()
                local tries = 0
                repeat
                    task.wait(0.1)
                    myHRP = MyHRP()
                    if not myHRP then break end
                    tries = tries + 1
                    killerDbg = "вендор: теп " .. tries .. " (ищу " .. wName .. ")"
                    myHRP.CFrame = hb.CFrame + Vector3.new(0, 3, 0)
                    myHRP.Velocity = Vector3.new(0, 0, 0)
                    pcall(function()
                        det.MaxActivationDistance = 9e9
                        if fireclickdetector then fireclickdetector(det) end
                    end)
                    if FindBat() then
                        killerDbg = "взял " .. wName .. " с " .. tries .. " попытки"
                        break
                    end
                until tick() - t0 > 8
            else
                killerDbg = "вендор: нет HitBox/ClickDetector"
            end
        else
            killerDbg = "вендор: нет BatCollection"
        end
    end)
    local b = FindBat()
    if b then EquipBat(b) return true end
    -- 2. запасные: промпты выдачи рядом со спавном
    if spawnCF then pcall(function() myHRP.CFrame = spawnCF + Vector3.new(0, 3, 0) end) end
    task.wait(0.5)
    pcall(function()
        for _, pr in ipairs(workspace:GetDescendants()) do
            if pr:IsA("ProximityPrompt") then
                local an = pr.Parent
                local nm = an and string.lower(an.Name) or ""
                local pn = an and an.Parent and string.lower(an.Parent.Name) or ""
                local function hit(s) return string.find(s, "bat") or string.find(s, "weapon") or string.find(s, "club") or string.find(s, "baseball") or string.find(s, "melee") end
                if hit(nm) or hit(pn) then
                    local part = ((an:IsA("BasePart") and an) or (an and an:FindFirstChildWhichIsA("BasePart")))
                    if part and part:IsA("BasePart") and (spawnCF == nil or (part.Position - spawnCF.Position).Magnitude < 120) then
                        myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                        if fireproximityprompt then
                            pcall(function() fireproximityprompt(pr) end)
                        end
                        task.wait(0.4)
                    end
                    if FindBat() then break end
                end
            end
        end
    end)
    if FindBat() then EquipBat(FindBat()) return true end
    -- 3. кликдетекторы выдачи
    pcall(function()
        for _, cd in ipairs(workspace:GetDescendants()) do
            if cd:IsA("ClickDetector") then
                local an = cd.Parent
                local nm = an and string.lower(an.Name) or ""
                if string.find(nm, "bat") or string.find(nm, "weapon") or string.find(nm, "club") or string.find(nm, "baseball") then
                    local part = ((an:IsA("BasePart") and an) or (an and an:FindFirstChildWhichIsA("BasePart")))
                    if part and part:IsA("BasePart") and (spawnCF == nil or (part.Position - spawnCF.Position).Magnitude < 120) then
                        myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                        if fireclickdetector then pcall(function() fireclickdetector(cd) end) end
                        task.wait(0.4)
                    end
                    if FindBat() then break end
                end
            end
        end
    end)
    if FindBat() then EquipBat(FindBat()) return true end
    -- 4. лежащие биты: подойти и тронуть
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            local dn = string.lower(d.Name)
            if d:IsA("Tool") and (IsBatName(dn) or d.Name == wName) then
                local part = d:FindFirstChild("Handle") or d:FindFirstChildWhichIsA("BasePart")
                if part and part:IsA("BasePart") then
                    myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                    task.wait(0.25)
                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(myHRP, part, 0)
                            task.wait()
                            firetouchinterest(myHRP, part, 1)
                        end)
                    end
                    task.wait(0.25)
                    if FindBat() then break end
                end
            end
        end
    end)
    local b2 = FindBat()
    if b2 then EquipBat(b2) return true end
    return false
end

-- Один удар: вис над головой + раздутый хитбокс + SwingEvent в сервер
local function KillerHitOnce(bat, target)
    local ch = target.Character
    if not ch then return end
    local head = ch:FindFirstChild("Head")
    local thrp = ch:FindFirstChild("HumanoidRootPart")
    local myHRP = MyHRP()
    if not head or not thrp or not myHRP then return end
    NoCdBat(bat)
    ExpandBat(bat)
    local overPos = head.Position + Vector3.new(0, KILL_HEIGHT, 0)
    pcall(function()
        myHRP.CFrame = CFrame.new(overPos, head.Position)
        myHRP.Velocity = Vector3.new(0, 0, 0)
        myHRP.RotVelocity = Vector3.new(0, 0, 0)
    end)
    pcall(function()
        local se = bat:FindFirstChild("SwingEvent")
        if se then se:FireServer() end
    end)
    pcall(function() bat:Activate() end)
end

