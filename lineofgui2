                        elseif v:IsA("IntValue") then v.Value = 100 end
                    end
                end
                -- 2. атрибуты
                local function setAttr(holder, names)
                    for _, an in ipairs(names) do
                        pcall(function() if holder:GetAttribute(an) ~= nil then holder:SetAttribute(an, 100) end end)
                    end
                end
                if Config.AutoStats or Config.AutoEat or Config.AutoSleep or Config.AutoHygiene then
