        else
            if hopNow then hopNow = false hopTimer = 999 end
            local giants = {}
            pcall(function() giants = FindGiants() end)
            if #giants > 0 then
                hopTimer = 0
                Status.Text = "НАЙДЕНО ГИГАНТОВ: " .. #giants .. " (остаюсь) [" .. QueueStatus .. "]"
                RefreshGiantsList(giants)
                Notify("GIANT FOUND", "Гигантов: " .. #giants .. " - " .. giants[1].name)
                pcall(function()
                    for _, g in ipairs(giants) do
                        local c = g.player and g.player.Character or nil
