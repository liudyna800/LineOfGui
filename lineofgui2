-- ============ УБИЙЦА ГИГАНТА (бита, таргеттинг) ============
-- Тап по нику = бить этого гиганта пока не умрёт. Вис над головой,
-- удар только по частям гиганта. Бита кончилась = слетать на спавн
-- за новой и вернуться. Заразили/схватили = авто-ресет и дальше.
local KILL_HEIGHT = 3.5 -- высота над головой гиганта
local KILL_TICK = 0.15 -- темп ударов (без кулдауна)
local killerOn = false
local killTarget = nil
local spawnCF = nil
local killSweepN = 0

task.spawn(function()
    pcall(function()
        local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = c:WaitForChild("HumanoidRootPart", 10)
        if hrp then spawnCF = hrp.CFrame end
    end)
end)

local function MyChar() return LocalPlayer.Character end
local function MyHRP() local c = MyChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function MyHum() local c = MyChar() return c and c:FindFirstChildOfClass("Humanoid") end

local function ImGrabbed()
    local c = MyChar()
    if not c then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum and hum.Seated then return true end
    if c:GetAttribute("Grabbed") == true then return true end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in ipairs(hrp:GetChildren()) do
            if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then return true end
        end
    end
    return false
end

local function RespawnMe()
    pcall(function()
        local hum = MyHum()
        if hum then hum.Health = 0 end
    end)
    pcall(function()
        local c = MyChar()
        if c then c:BreakJoints() end
    end)
end

local function FindBat()
    local function scan(par)
        if par then
            for _, t in ipairs(par:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "bat") then return t end
            end
        end
        return nil
    end
    return scan(MyChar()) or scan(LocalPlayer:FindFirstChild("Backpack"))
end

local function EquipBat(tool)
    if tool == nil then return end
    pcall(function()
        local hum = MyHum()
        if hum and tool.Parent ~= MyChar() then hum:EquipTool(tool) end
    end)
end

local function NoCdBat(tool)
    pcall(function()
        for _, an in ipairs({"Cooldown", "AttackCooldown", "CooldownTime", "SwingCooldown", "HitCooldown", "Debounce", "LastAttack", "NextAttack"}) do
            if tool:GetAttribute(an) ~= nil then tool:SetAttribute(an, 0) end
        end
        tool.Enabled = true
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = string.lower(v.Name)
                if string.find(n, "cooldown") or string.find(n, "debounce") or string.find(n, "lastattack") or string.find(n, "nextattack") or string.find(n, "swing") or string.find(n, "reload") then
                    v.Value = 0
                end
            elseif v:IsA("BoolValue") then
                local n = string.lower(v.Name)
                if string.find(n, "debounce") or string.find(n, "cooldown") or string.find(n, "attacking") then
                    v.Value = false
                end
            end
        end
    end)
end

local function GiantAimPart(plr)
    local ch = plr and plr.Character
    if not ch then return nil end
    return ch:FindFirstChild("Head") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart")
end

-- Анти-заражение: гасим белые блоки локально (best effort) + авто-ресет при заражении
local function AntiLightSweep()
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") then
                local n = string.lower(d.Name)
                if string.find(n, "infect") then
                    pcall(function() d.CanTouch = false end)
                end
            end
        end
    end)
end

-- Слетать на спавн за новой битой
local function FetchBat()
    local myHRP = MyHRP()
    if not myHRP then return false end
    if spawnCF then pcall(function() myHRP.CFrame = spawnCF + Vector3.new(0, 3, 0) end) end
    task.wait(0.7)
    -- 1. стойка выдачи (промпт контейнера оружия)
    pcall(function()
        for _, pr in ipairs(workspace:GetDescendants()) do
            if pr:IsA("ProximityPrompt") then
                local an = pr.Parent
                local nm = an and string.lower(an.Name) or ""
                local pn = an and an.Parent and string.lower(an.Parent.Name) or ""
                if string.find(nm, "bat") or string.find(nm, "weapon") or string.find(pn, "bat") or string.find(pn, "weapon") then
                    local part = ((an:IsA("BasePart") and an) or (an and an:FindFirstChildWhichIsA("BasePart")))
                    if part and part:IsA("BasePart") and (spawnCF == nil or (part.Position - spawnCF.Position).Magnitude < 100) then
                        myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                        if fireproximityprompt then
                            pcall(function() fireproximityprompt(pr) end)
                        end
                        task.wait(0.4)
                    end
                    if FindBat() then break end
                end
            end
        end
    end)
    if FindBat() then EquipBat(FindBat()) return true end
    -- 2. лежащие биты: подойти и тронуть
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Tool") and string.find(string.lower(d.Name), "bat") then
                local part = d:FindFirstChild("Handle") or d:FindFirstChildWhichIsA("BasePart")
                if part and part:IsA("BasePart") then
                    myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                    task.wait(0.25)
                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(myHRP, part, 0)
                            task.wait()
                            firetouchinterest(myHRP, part, 1)
                        end)
                    end
                    task.wait(0.25)
                    if FindBat() then break end
                end
            end
        end
    end)
    local b = FindBat()
    if b then EquipBat(b) return true end
    return false
end

-- Один удар ТОЛЬКО по гиганту: вис над головой + касания его частей
local function KillerHitOnce(bat, target)
    local aim = GiantAimPart(target)
    local myHRP = MyHRP()
    if aim == nil or myHRP == nil then return end
    pcall(function()
        myHRP.CFrame = aim.CFrame + Vector3.new(0, KILL_HEIGHT, 0)
        myHRP.Velocity = Vector3.new(0, 0, 0)
        myHRP.RotVelocity = Vector3.new(0, 0, 0)
    end)
    NoCdBat(bat)
    pcall(function() bat:Activate() end)
    if firetouchinterest then
        local handle = bat:FindFirstChild("Handle")
        local ch = target.Character
        if handle and ch then
            for _, pn in ipairs({"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"}) do
                local part = ch:FindFirstChild(pn)
                if part and part:IsA("BasePart") then
                    pcall(function() firetouchinterest(handle, part, 0) end)
                end
            end
            task.wait()
            for _, pn in ipairs({"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"}) do
                local part = ch:FindFirstChild(pn)
                if part and part:IsA("BasePart") then
                    pcall(function() firetouchinterest(handle, part, 1) end)
                end
            end
        end
    end
end

-- Главный цикл убийцы
task.spawn(function()
    while gui.Parent and IsCurrentGen() do
        task.wait(KILL_TICK)
        if killerOn then
            pcall(function()
                if killTarget == nil or killTarget.Parent == nil then
                    local gs = FindGiants()
                    if #gs > 0 and gs[1].player then
                        killTarget = gs[1].player
                    else
                        return
                    end
                end
                if not IsPlayerGiant(killTarget) then
                    local gs = FindGiants()
                    if #gs > 0 and gs[1].player then
                        killTarget = gs[1].player
                        pcall(function() if TargetLabel then TargetLabel.Text = "Цель: " .. killTarget.DisplayName end end)
                    else
                        killTarget = nil
                    end
                    return
                end
                -- заразили = ресет и дальше мочить
                if IsSmiler(LocalPlayer) then
                    RespawnMe()
                    task.wait(2)
                    return
                end
                -- схватили (гигант или другие) = ресет и дальше
                if ImGrabbed() then
                    RespawnMe()
                    task.wait(2)
                    return
                end
                killSweepN = killSweepN + 1
                if killSweepN % 30 == 0 then AntiLightSweep() end
                local bat = FindBat()
                if bat == nil then
                    Notify("Killer", "Бита кончилась, лечу на спавн...")
                    FetchBat()
                    return
                end
                EquipBat(bat)
                KillerHitOnce(bat, killTarget)
            end)
        end
    end
end)

-- ============ SERVER HOP (как Infinite Yield) ============
local function ServerHop()
    QueueSelf() -- очередь ПЕРЕД телепортом, иначе авто-запуска не будет
    if not IsCurrentGen() then return end -- нас уже сменила новая копия, не хопаем
    -- убийца сам перевыберет цель на новом сервере
    local placeId = PLACE_ID
    local cursor = ""
    local visited = getgenv and getgenv()._GiantRaidVisited or {}
    local myJob = game.JobId
    visited[myJob] = true
    Notify("Giant Raid", "Гигантов нет, ищу сервер 8+ ...")
    task.wait(1)
    local ok, err = pcall(function()
        -- Desc = сначала самые полные. Баг был: Asc брал мелкие 1-5.
        local tries = 0
        local bestMedium, bestMediumInfo, bestAny, bestAnyInfo = nil, nil, nil, nil
        while tries < 5 and bestMedium == nil do
            tries = tries + 1
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
            local resp = game:HttpGet(url)
            local data = HttpService:JSONDecode(resp)
            cursor = data.nextPageCursor or ""
            if data.data then
                for _, s in ipairs(data.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= myJob and not visited[s.id] then
                        if bestAny == nil then bestAny, bestAnyInfo = s.id, s.playing .. "/" .. s.maxPlayers end
                        if s.playing >= MIN_PLAYERS then
                            bestMedium, bestMediumInfo = s.id, s.playing .. "/" .. s.maxPlayers
                            break
                        end
                    end
                end
            end
            if cursor == "" or cursor == nil then break end
        end
        local target, info = bestMedium, bestMediumInfo
        if target == nil then target, info = bestAny, bestAnyInfo end
        if target ~= nil then
            visited[target] = true
            Notify("Giant Raid", "Хоп на сервер (" .. tostring(info) .. ")")
            TeleportService:TeleportToPlaceInstance(placeId, target, LocalPlayer)
            task.wait(3)
            return
        end
        TeleportService:Teleport(placeId, LocalPlayer)
    end)
    if not ok then
        Notify("Giant Raid", "Хоп не вышел, пробую обычный Teleport")
        pcall(function() TeleportService:Teleport(placeId, LocalPlayer) end)
    end
end

