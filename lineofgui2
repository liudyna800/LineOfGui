-- Поиск еды/кроватей/комнат по именам в Workspace
local function FindPartsByKeys(keys, maxN)
    local out = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if #out >= (maxN or 25) then break end
            if d:IsA("BasePart") or d:IsA("Model") then
                local n = string.lower(d.Name)
                for _, k in ipairs(keys) do
                    if string.find(n, k) then
                        local pos = nil
                        if d:IsA("BasePart") then pos = d.Position
                        else
                            local p = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChild("Handle") or d:FindFirstChildWhichIsA("BasePart", true)
                            if p then pos = p.Position end
                        end
                        if pos then table.insert(out, {name = d.Name, pos = pos}) break end
                    end
                end
            elseif d:IsA("Tool") then
                local n = string.lower(d.Name)
                for _, k in ipairs(keys) do
                    if string.find(n, k) then
                        local h = d:FindFirstChild("Handle")
                        if h then table.insert(out, {name = d.Name, pos = h.Position}) break end
                    end
                end
            end
        end
    end)
    return out
end

