task.spawn(function()
    while gui.Parent and IsCurrentGen() do
        task.wait(0.2)
        if Config.AntiSnatch then
            pcall(function()
                local c = GetChar() local hrp = GetHRP() local hum = GetHum()
                if not c or not hrp or not hum then return end
                local grabbed = false
                if hum.Seated then grabbed = true end
                if c:GetAttribute("Grabbed") == true or c:GetAttribute("Carried") == true or c:GetAttribute("Held") == true then grabbed = true end
                for _, v in ipairs(hrp:GetChildren()) do
                    if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then grabbed = true v:Destroy() end
                end
                for _, v in ipairs(c:GetDescendants()) do
                    if v:IsA("Weld") or v:IsA("WeldConstraint") then
                        local n = string.lower(v.Name)
                        if string.find(n,"grab") or string.find(n,"hold") or string.find(n,"carry") or string.find(n,"snatch") then grabbed = true v:Destroy() end
                    end
                end
                if grabbed then
                    hum.Sit = false hum.PlatformStand = false
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, 4, 0) + hrp.CFrame.LookVector * -5
                    hrp.Velocity = Vector3.new(0, 50, 0)
                end
            end)
        end
        if Config.AntiTest then
            pcall(function()
                local hum = GetHum()
                if hum then hum.Sit = false hum.PlatformStand = false
                    if hum:GetState() == Enum.HumanoidStateType.Physics or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end
            end)
        end
    end
end)

