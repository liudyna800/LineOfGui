                if Config.AutoStats or Config.AutoEat then FireList(EatRemotes) FireList(StatRemotes, "eat") end
                if Config.AutoStats or Config.AutoSleep then FireList(SleepRemotes) FireList(StatRemotes, "sleep") end
                if Config.AutoHygiene then FireList(StatRemotes) end
