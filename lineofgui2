-- ============ REMOTES SCAN ============
local HackRemotes, ExitRemotes, PodRemotes, StaminaVals = {}, {}, {}, {}
local function ScanRemotes()
    table.clear(HackRemotes) table.clear(ExitRemotes) table.clear(PodRemotes)
    pcall(function()
        for _, d in ipairs(game:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                local n = string.lower(d.Name)
                local full = string.lower(d:GetFullName())
                local function has(list)
                    for _, k in ipairs(list) do
                        if string.find(n, k, 1, true) or string.find(full, k, 1, true) then return true end
                    end
                    return false
                end
                if has({"hack", "computer", "pc", "terminal", "qte", "skill", "type"}) then table.insert(HackRemotes, d) end
                if has({"exit", "door", "escape", "open"}) then table.insert(ExitRemotes, d) end
                if has({"pod", "capsule", "freeze", "capture", "chamber", "rescue", "struggle", "hammer", "beast"}) then table.insert(PodRemotes, d) end
            end
        end
    end)
end
ScanRemotes()
pcall(function()
    game.DescendantAdded:Connect(function(d)
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then task.delay(1, ScanRemotes) end
    end)
end)

local function FireList(list, ...)
    local args = {...}
    for _, r in ipairs(list) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                if #args > 0 then r:FireServer(unpack(args)) else r:FireServer() end
            end
        end)
    end
end

