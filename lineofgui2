-- Слетать на спавн за новой битой
local function FetchBat()
    local myHRP = MyHRP()
    if not myHRP then return false end
    if spawnCF then pcall(function() myHRP.CFrame = spawnCF + Vector3.new(0, 3, 0) end) end
    task.wait(0.7)
    -- 1. стойка выдачи (промпт контейнера оружия)
    pcall(function()
        for _, pr in ipairs(workspace:GetDescendants()) do
            if pr:IsA("ProximityPrompt") then
                local an = pr.Parent
                local nm = an and string.lower(an.Name) or ""
                local pn = an and an.Parent and string.lower(an.Parent.Name) or ""
                if string.find(nm, "bat") or string.find(nm, "weapon") or string.find(pn, "bat") or string.find(pn, "weapon") then
                    local part = ((an:IsA("BasePart") and an) or (an and an:FindFirstChildWhichIsA("BasePart")))
                    if part and part:IsA("BasePart") and (spawnCF == nil or (part.Position - spawnCF.Position).Magnitude < 100) then
                        myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                        if fireproximityprompt then
                            pcall(function() fireproximityprompt(pr) end)
                        end
                        task.wait(0.4)
                    end
                    if FindBat() then break end
                end
            end
        end
    end)
    if FindBat() then EquipBat(FindBat()) return true end
    -- 2. лежащие биты: подойти и тронуть
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Tool") and string.find(string.lower(d.Name), "bat") then
                local part = d:FindFirstChild("Handle") or d:FindFirstChildWhichIsA("BasePart")
                if part and part:IsA("BasePart") then
                    myHRP.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                    task.wait(0.25)
                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(myHRP, part, 0)
                            task.wait()
                            firetouchinterest(myHRP, part, 1)
                        end)
                    end
                    task.wait(0.25)
                    if FindBat() then break end
                end
            end
        end
    end)
    local b = FindBat()
    if b then EquipBat(b) return true end
    return false
end

-- Один удар ТОЛЬКО по гиганту: вис над головой + касания его частей
local function KillerHitOnce(bat, target)
    local aim = GiantAimPart(target)
    local myHRP = MyHRP()
    if aim == nil or myHRP == nil then return end
    pcall(function()
        myHRP.CFrame = aim.CFrame + Vector3.new(0, KILL_HEIGHT, 0)
        myHRP.Velocity = Vector3.new(0, 0, 0)
        myHRP.RotVelocity = Vector3.new(0, 0, 0)
    end)
    NoCdBat(bat)
    pcall(function() bat:Activate() end)
    if firetouchinterest then
        local handle = bat:FindFirstChild("Handle")
        local ch = target.Character
        if handle and ch then
            for _, pn in ipairs({"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"}) do
                local part = ch:FindFirstChild(pn)
                if part and part:IsA("BasePart") then
