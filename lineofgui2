task.spawn(function()
    while gui.Parent and IsCurrentGen() do
        task.wait(0.4)
        if Config.AutoHack then
            pcall(function()
                local my = GetHRP() if not my then return end
                -- 1) жмём ProximityPrompt компьютеров рядом
                if fireproximityprompt then
                    for _, d in ipairs(Workspace:GetDescendants()) do
                        if d:IsA("ProximityPrompt") then
                            local par = d.Parent
                            if par and par:IsA("BasePart") then
                                local an = d.Parent.Parent
                                local anName = an and string.lower(an.Name) or ""
                                local pn = string.lower(par.Name)
                                if string.find(anName, "computer") or string.find(anName, "pc") or string.find(pn, "screen") or string.find(pn, "keyboard") then
                                    if (my.Position - par.Position).Magnitude <= Config.HackDistance and d.Enabled then
                                        fireproximityprompt(d)
                                    end
                                end
                            end
                        end
                    end
                end
                -- 2) дожимаем ремоутами хака
                FireList(HackRemotes)
                -- 3) Auto-QTE: ищем GUI хака и жмём
                if Config.AutoQTE then
                    local pg = LocalPlayer:FindFirstChild("PlayerGui")
                    if pg then
                        for _, g in ipairs(pg:GetDescendants()) do
                            if g:IsA("TextButton") or g:IsA("ImageButton") then
                                local n = string.lower(g.Name)
                                if (string.find(n, "hack") or string.find(n, "qte") or string.find(n, "skill") or g.Text == "E") and g.Visible then
                                    -- проверяем что это окно хака активно
                                    local par = g.Parent
                                    if par and par.Visible ~= false then
                                        pcall(function()
                                            for _, c in ipairs({g.Activated, g.MouseButton1Click}) do end
                                            -- эмулируем клик через fire signal? проще: вызываем через clickdetector-фолбэк
                                        end)
                                        -- пробуем нажать через VirtualInput невозможен на Delta, поэтому жмём через firesignal если есть
                                        pcall(function()
                                            if firesignal then firesignal(g.MouseButton1Click) end
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
                -- 4) Anti-fail: не даём стамине упасть во время хака
                if Config.InfStamina then
                    local hum = GetHum()
                    if hum then hum.WalkSpeed = Config.SpeedEnabled and Config.SpeedValue or hum.WalkSpeed end
                end
            end)
        end
        if Config.AutoStruggle then
            pcall(function()
                -- спам struggle-ремоутов + прыжки чтобы вырваться из лап/капсулы
                FireList(PodRemotes)
                local hum = GetHum()
                if hum and hum.Seated then
                    hum.Jump = true
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
                -- кликаем кнопки Struggle/Escape в GUI
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                if pg and firesignal then
                    for _, g in ipairs(pg:GetDescendants()) do
                        if g:IsA("TextButton") and g.Visible then
                            local t = string.lower(g.Text)
                            if string.find(t, "struggle") or string.find(t, "escape") or string.find(t, "mash") or string.find(t, "free") then
                                firesignal(g.MouseButton1Click)
                            end
                        end
                    end
                end
            end)
            task.wait(0.2)
        end
    end
end)

