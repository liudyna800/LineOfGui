RunService.Heartbeat:Connect(function()
    if not S.DangerRadar then warnGui.Visible=false return end
    pcall(function()
        local myR=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if not myR then return end
        local best=9999
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local sm = p.Team and p.Team.Name:lower():find("smil")
                if sm or true then -- если команд нет, считаем всех угрозой в радиусе
                    local d=(p.Character.HumanoidRootPart.Position-myR.Position).Magnitude
                    if d<best then best=d end
                end
            end
        end
        if best<22 then warnGui.Visible=true warnGui.Text=string.format("⚠️ СМАЙЛ %.0fm! БЕГИ!",best)
        else warnGui.Visible=false end
    end)
end)

-- 6. AntiGrab + Auto-Escape с ножом (уникально: авто-экип ножа когда схватили)
RunService.Stepped:Connect(function()
    if not S.AntiGrabEscape then return end
    pcall(function()
        local ch=LocalPlayer.Character local h=ch and ch:FindFirstChildOfClass("Humanoid") if not ch or not h then return end
        local grabbed = h.Seated -- захват почти всегда сажает
        -- чистим weld захвата
        for _,v in pairs(ch:GetDescendants()) do
            if (v:IsA("Weld") or v:IsA("WeldConstraint")) and (v.Name:lower():find("grab") or v.Name:lower():find("hold") or v.Name:lower():find("grip")) then v:Destroy() end
        end
        if grabbed then
            h.Sit=false h.Jump=true
            -- авто-взять нож/пистолет (единственное что работает в грабе)
            for _,t in pairs(LocalPlayer.Backpack:GetChildren()) do
                if t:IsA("Tool") and (t.Name:lower():find("knife") or t.Name:lower():find("pistol") or t.Name:lower():find("bottle")) then
                    h:EquipTool(t) t:Activate() break
                end
            end
        end
    end)
end)

-- 7. Rescue Aura - авто-спасение друга: бьет смайла который держит человека
RunService.Heartbeat:Connect(function()
    if not S.RescueAura then return end
    pcall(function()
        local ch=LocalPlayer.Character local myR=ch and ch:FindFirstChild("HumanoidRootPart")
        local tool=ch and ch:FindFirstChildOfClass("Tool") if not myR then return end
        if tool then tool:Activate() end
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then
                local h=p.Character:FindFirstChildOfClass("Humanoid") local er=p.Character:FindFirstChild("HumanoidRootPart")
                if h and er and h.Seated and (er.Position-myR.Position).Magnitude<25 then
                    -- человек в грабе! телепортируем хит к смайлу рядом
                    for _,s in pairs(Players:GetPlayers()) do
                        if s~=p and s.Character and s.Character:FindFirstChild("HumanoidRootPart") then
                            local sr=s.Character.HumanoidRootPart
                            if (sr.Position-er.Position).Magnitude<12 then
                                local handle=tool and tool:FindFirstChild("Handle")
                                if handle then firetouchinterest(sr,handle,0) task.wait() firetouchinterest(sr,handle,1) end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

-- 8. Coin Farm - авто-подбор монет гиганта
RunService.Heartbeat:Connect(function()
    if not S.CoinFarm then return end
    pcall(function()
        local myR=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if not myR then return end
        for _,o in pairs(Workspace:GetDescendants()) do
            if o:IsA("BasePart") and o.Name:lower():find("coin") and (o.Position-myR.Position).Magnitude<40 then
                firetouchinterest(myR,o,0) task.wait() firetouchinterest(myR,o,1)
            end
            if o:IsA("Tool") and o.Name:lower():find("coin") and o:FindFirstChild("Handle") and (o.Handle.Position-myR.Position).Magnitude<40 then
                firetouchinterest(myR,o.Handle,0) task.wait() firetouchinterest(myR,o.Handle,1)
            end
        end
    end)
end)

