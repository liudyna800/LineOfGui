local function Toggle(name, default, cb)
    local state = default
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 32)
    b.Font = Enum.Font.GothamBold b.TextSize = 13
    b.TextColor3 = Color3.new(1,1,1)
    b.AutoButtonColor = true b.Active = true b.BorderSizePixel = 0
    b.Parent = Scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local function refresh()
        b.Text = (state and "[ON] " or "[OFF] ") .. name
        b.BackgroundColor3 = state and Color3.fromRGB(45,160,90) or Color3.fromRGB(40,45,48)
    end
    refresh()
    local last = 0
    local function fire()
        local now = tick() if now - last < 0.3 then return end last = now
        state = not state refresh() pcall(cb, state)
    end
    b.Activated:Connect(fire) b.MouseButton1Click:Connect(fire) b.TouchTap:Connect(fire)
    return b
end
local function Button(name, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 32)
    b.BackgroundColor3 = Color3.fromRGB(50, 60, 58)
    b.Text = name b.Font = Enum.Font.GothamBold b.TextSize = 13
    b.TextColor3 = Color3.new(1,1,1)
    b.AutoButtonColor = true b.Active = true b.BorderSizePixel = 0
    b.Parent = Scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local last = 0
    local base = b.BackgroundColor3
    local function fire()
        local now = tick() if now - last < 0.3 then return end last = now
        pcall(function() b.BackgroundColor3 = Color3.fromRGB(120,200,140) task.delay(0.15, function() pcall(function() b.BackgroundColor3 = base end) end) end)
        pcall(cb)
    end
    b.Activated:Connect(fire) b.MouseButton1Click:Connect(fire) b.TouchTap:Connect(fire)
    return b
end
local function SliderBtn(name, min, max, step, default, cb)
    local val = default
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 32)
    b.BackgroundColor3 = Color3.fromRGB(45, 55, 52)
    b.Font = Enum.Font.GothamBold b.TextSize = 13
    b.TextColor3 = Color3.new(1,1,1)
    b.AutoButtonColor = true b.Active = true b.BorderSizePixel = 0
    b.Parent = Scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local function refresh() b.Text = name .. ": " .. tostring(val) .. " (тап = +)" end
    refresh()
    local last = 0
    local function fire()
        local now = tick() if now - last < 0.2 then return end last = now
        val = val + step if val > max then val = min end refresh() pcall(cb, val)
    end
    b.Activated:Connect(fire) b.MouseButton1Click:Connect(fire)
    return b
end

