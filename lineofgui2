local function MyChar() return LocalPlayer.Character end
local function MyHRP() local c = MyChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function MyHum() local c = MyChar() return c and c:FindFirstChildOfClass("Humanoid") end

local function ImGrabbed()
    local c = MyChar()
    if not c then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum and hum.Seated then return true end
    if c:GetAttribute("Grabbed") == true then return true end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in ipairs(hrp:GetChildren()) do
            if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then return true end
        end
    end
    return false
end

local function RespawnMe()
    pcall(function()
        local hum = MyHum()
        if hum then hum.Health = 0 end
    end)
    pcall(function()
        local c = MyChar()
        if c then c:BreakJoints() end
    end)
end

local function FindBat()
    local function scan(par)
        if par then
            for _, t in ipairs(par:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "bat") then return t end
            end
        end
        return nil
    end
    return scan(MyChar()) or scan(LocalPlayer:FindFirstChild("Backpack"))
end

local function EquipBat(tool)
    if tool == nil then return end
