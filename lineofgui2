local function Notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title = title, Text = text, Duration = dur or 4})
    end)
    print("[GiantRaid] " .. tostring(text))
end

-- ============ QUEUE ON TELEPORT (как в Infinite Yield) ============
local function QueueNext()
    if SCRIPT_URL == "" then
        Notify("Giant Raid", "Нет SCRIPT_URL - после хопа нажми Execute вручную")
        return
    end
    local code = "loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()"
    local q = nil
    pcall(function()
        q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    end)
    if getgenv and not q then
        pcall(function() q = getgenv().queue_on_teleport or getgenv().queueonteleport end)
    end
    if q then
        pcall(function() q(code) end)
        Notify("Giant Raid", "Авто-запуск на след. сервере включён")
    else
        Notify("Giant Raid", "Executor не поддерживает queue_on_teleport")
    end
end

-- ============ ДЕТЕКТ ГИГАНТА ============
-- Гигант из Giant Potion: 300 HP, x2 размер, фиолетовое свечение/партиклы
-- Endangered гигант: +100 HP. NPC-гигант в Giant's Room: большое тело + много HP.
local function IsPlayerGiant(plr)
    if not plr or not plr.Character then return false, nil end
    local c = plr.Character
    local hum = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local head = c:FindFirstChild("Head")
    if not hum or not hrp then return false, nil end
    local info = {}

    -- 1. HP (самый надёжный признак: у гиганта 300)
    if hum.MaxHealth and hum.MaxHealth >= 200 then
        info.reason = "HP:" .. tostring(hum.MaxHealth)
        return true, info
    end
    -- 2. Атрибуты / значения
    if c:GetAttribute("Giant") == true or c:GetAttribute("IsGiant") == true
    or plr:GetAttribute("Giant") == true or plr:GetAttribute("IsGiant") == true then
        info.reason = "attr"
        return true, info
    end
    if c:FindFirstChild("Giant") or c:FindFirstChild("IsGiant") or c:FindFirstChild("GiantPotion") then
        info.reason = "value"
        return true, info
    end
    -- 3. Размер тела (гигант x2)
    if hrp.Size.Y > 2.6 then
        info.reason = "size:" .. string.format("%.1f", hrp.Size.Y)
        return true, info
    end
    if head and head.Size.Y > 1.8 then
        info.reason = "head"
        return true, info
    end
    -- 4. Фиолетовое свечение гиганта (PointLight + ParticleEmitter) + большой размер
    local hasGlow = false
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("ParticleEmitter") or d:IsA("PointLight") then
            hasGlow = true
            break
        end
    end
    if hasGlow and hrp.Size.Y > 2.2 then
        info.reason = "glow+size"
        return true, info
    end
    return false, nil
end

local function FindGiants()
    local found = {}
    -- игроки-гиганты
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local ok, info = IsPlayerGiant(p)
            if ok then
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                table.insert(found, {
                    name = p.DisplayName .. " (@" .. p.Name .. ")",
                    player = p,
                    hrp = hrp,
                    hp = hum and math.floor(hum.Health) or 0,
                    maxHp = hum and math.floor(hum.MaxHealth) or 0,
                    reason = info and info.reason or "?",
                })
            end
        end
    end
    -- только игроки-гиганты (NPC игнорируем)
    return found
end

