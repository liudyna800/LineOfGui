-- Роль: Scientist = есть Snatch-tool / Team Scientist / атрибут
local function IsScientist(plr)
    local ok, res = pcall(function()
        if not plr then return false end
        if plr.Team and plr.Team.Name then
            local t = string.lower(plr.Team.Name)
            if string.find(t, "scien") or string.find(t, "doctor") or string.find(t, "staff") then return true end
            if string.find(t, "patient") or string.find(t, "baby") or string.find(t, "noodle") then return false end
        end
        local c = plr.Character
        if c then
            if c:GetAttribute("Scientist") == true or c:GetAttribute("IsScientist") == true then return true end
            if c:GetAttribute("Patient") == true then return false end
            if c:FindFirstChild("IsScientist") or c:FindFirstChild("Scientist") then return true end
            for _, tool in ipairs(c:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = string.lower(tool.Name)
                    if string.find(n, "snatch") or string.find(n, "grab") or string.find(n, "syringe")
                    or string.find(n, "laser") or string.find(n, "test") or string.find(n, "scanner") then
                        return true
                    end
                end
            end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = string.lower(tool.Name)
                    if string.find(n, "snatch") or string.find(n, "grab") or string.find(n, "syringe")
                    or string.find(n, "laser") or string.find(n, "test") or string.find(n, "scanner") then
                        return true
                    end
                end
            end
        end
        if plr:GetAttribute("Scientist") == true or plr:GetAttribute("IsScientist") == true then return true end
        return false
    end)
    if not ok then return false end
    return res == true
end

-- Статы пациента: ищем Hunger/Energy/Hygiene/Happiness/Health/Weight и т.п.
local STAT_KEYS = {"hunger","energy","hygiene","clean","happy","happiness","mood","health","food","sleep","stamina","thirst","fun","comfort","weight"}
local function IsStatName(n)
    n = string.lower(tostring(n))
    for _, k in ipairs(STAT_KEYS) do
        if string.find(n, k) then return true end
    end
    return false
end

local function GetStatHolders()
    -- возвращает список Number/IntValue похожих на статы
    local out = {}
    pcall(function()
        local function scan(parent)
            for _, d in ipairs(parent:GetChildren()) do
                if d:IsA("NumberValue") or d:IsA("IntValue") then
                    if IsStatName(d.Name) then table.insert(out, d) end
                elseif d:IsA("Folder") or d.Name == "leaderstats" or d.Name == "Stats" or d.Name == "Needs" then
                    for _, v in ipairs(d:GetChildren()) do
                        if (v:IsA("NumberValue") or v:IsA("IntValue")) and IsStatName(v.Name) then
                            table.insert(out, v)
                        end
                    end
                end
            end
        end
        scan(LocalPlayer)
        local c = GetChar()
        if c then scan(c) end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            -- плюс-кнопка статов: значения часто дублируются в GUI, только читаем
        end
    end)
    return out
end

local function ReadStats()
    -- {name=..., value=..., max=...}
    local res = {}
    pcall(function()
        for _, v in ipairs(GetStatHolders()) do
            local max = 100
            pcall(function()
                local m = v:FindFirstChild("Max") or v.Parent:FindFirstChild(v.Name .. "Max")
                if m and m.Value then max = m.Value end
            end)
            if v.MaxValue and v.MaxValue > 0 then max = v.MaxValue end
            table.insert(res, {obj = v, name = v.Name, value = v.Value, max = max})
        end
        -- атрибуты
        for _, k in ipairs(STAT_KEYS) do
            -- точные имена атрибутов неизвестны, пробуем капитализации
            for _, cand in ipairs({k, k:gsub("^%l", string.upper)}) do
                local ok, val = pcall(function() return LocalPlayer:GetAttribute(cand) end)
                if ok and type(val) == "number" then
                    table.insert(res, {attr = cand, holder = LocalPlayer, name = cand, value = val, max = 100})
                end
                local c = GetChar()
                if c then
                    local ok2, val2 = pcall(function() return c:GetAttribute(cand) end)
                    if ok2 and type(val2) == "number" then
                        table.insert(res, {attr = cand, holder = c, name = cand, value = val2, max = 100})
                    end
                end
            end
        end
    end)
    return res
end

local function IsGoodNoodle()
    local stats = ReadStats()
    if #stats == 0 then return nil end
    for _, s in ipairs(stats) do
        if s.value < 95 then return false end
    end
    return true
end

