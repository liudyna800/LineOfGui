local function Btn(txt, y, cb, parent, half)
    local b = Instance.new("TextButton")
    parent = parent or Main
    if half == "left" then
        b.Size = UDim2.new(0.5, -10, 0, 30)
        b.Position = UDim2.new(0, 8, 0, y)
    elseif half == "right" then
        b.Size = UDim2.new(0.5, -10, 0, 30)
        b.Position = UDim2.new(0.5, 2, 0, y)
    else
        b.Size = UDim2.new(1, -16, 0, 30)
        b.Position = UDim2.new(0, 8, 0, y)
    end
    b.BackgroundColor3 = Color3.fromRGB(60, 50, 90)
    b.Text = txt
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.TextColor3 = Color3.new(1, 1, 1)
    b.AutoButtonColor = true
    b.Active = true
    b.BorderSizePixel = 0
    b.ClipsDescendants = false
    b.ZIndex = 5
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    -- Три сигнала + сырой ввод: хоть один да дойдёт на любом executor'е.
    -- tick-дебаунс гасит двойное срабатывание за один тап.
    -- Зелёная вспышка = тап дошёл (диагностика).
    local baseColor = b.BackgroundColor3
    local last = 0
    local function fire()
        local now = tick()
        if now - last < 0.4 then return end
        last = now
        pcall(function()
            b.BackgroundColor3 = Color3.fromRGB(120, 200, 120)
            task.delay(0.15, function()
                pcall(function() b.BackgroundColor3 = baseColor end)
            end)
        end)
        pcall(cb)
    end
    b.Activated:Connect(fire)
    b.MouseButton1Click:Connect(fire)
    b.TouchTap:Connect(fire)
    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            fire()
        end
    end)
    return b
end

