-- ============ QUEUE ON TELEPORT (как Infinite Yield, но без ссылки) ============
local QueueStatus = "?"
local function TryQueue(src)
    local variants = {}
    pcall(function()
        if queue_on_teleport then table.insert(variants, queue_on_teleport) end
    end)
    pcall(function()
        if queueonteleport then table.insert(variants, queueonteleport) end
    end)
    pcall(function()
        if syn and syn.queue_on_teleport then table.insert(variants, syn.queue_on_teleport) end
    end)
    if getgenv then
        pcall(function()
            if getgenv().queue_on_teleport then table.insert(variants, getgenv().queue_on_teleport) end
        end)
        pcall(function()
            if getgenv().queueonteleport then table.insert(variants, getgenv().queueonteleport) end
        end)
    end
    for _, q in ipairs(variants) do
        local ok = pcall(function() q(src) end)
        if ok then return true end
    end
    return false
end

local function QueueSelf()
    local src = FULL
    if SCRIPT_URL ~= "" then
        src = "loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()"
    end
    if TryQueue(src) then
        QueueStatus = "queue OK"
        return true
    else
        QueueStatus = "queue НЕТ: executor не поддерживает queue_on_teleport. Положи файл в Delta > AutoExecute как запасной вариант."
        Notify("Giant Raid", QueueStatus, 6)
        return false
    end
end

-- ============ ДЕТЕКТ ГИГАНТА-ИГРОКА (NPC игнорим) ============
local function IsPlayerGiant(plr)
    if not plr or not plr.Character then return false, nil end
    local c = plr.Character
    local hum = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false, nil end
    local info = {}
    -- Гигант: 300 HP (endangered-гигант 400). Обычный endangered-смайл = 200 HP,
    -- поэтому порог 250: отсекает endangered (200) и бигхедов (100).
    if hum.MaxHealth and hum.MaxHealth >= 250 then
        info.reason = "HP:" .. tostring(hum.MaxHealth)
        return true, info
    end
    if c:GetAttribute("Giant") == true or c:GetAttribute("IsGiant") == true
    or plr:GetAttribute("Giant") == true or plr:GetAttribute("IsGiant") == true then
        info.reason = "attr"
        return true, info
    end
    if c:FindFirstChild("Giant") or c:FindFirstChild("IsGiant") or c:FindFirstChild("GiantPotion") then
        info.reason = "value"
        return true, info
    end
    -- Тело x2 у гиганта (HRP ~4). Endangered +30% (~2.6) не проходит порог 3.0.
    if hrp.Size.Y > 3.0 then
        info.reason = "size:" .. string.format("%.1f", hrp.Size.Y)
        return true, info
    end
    -- Детект по голове УБРАН: у обычных смайлов бывает шанс-бигхед (большая голова при 100 HP) - это не гигант.
    local hasGlow = false
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("ParticleEmitter") or d:IsA("PointLight") then
            hasGlow = true
            break
        end
    end
    -- Фиолетовое свечение гиганта + большое тело. У endangered красные партиклы
    -- и мелкое тело (~2.6) - порог 3.0 их отсекает.
    if hasGlow and hrp.Size.Y > 3.0 then
        info.reason = "glow+size"
        return true, info
    end
    return false, nil
end

local function FindGiants()
    local found = {}
    local seen = {} -- защита от дублей одного игрока
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not seen[p] then
            local ok, info = IsPlayerGiant(p)
            if ok then
                seen[p] = true
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                table.insert(found, {
                    name = p.DisplayName .. " (@" .. p.Name .. ")",
                    player = p,
                    hrp = hrp,
                    hp = hum and math.floor(hum.Health) or 0,
                    maxHp = hum and math.floor(hum.MaxHealth) or 0,
                    reason = info and info.reason or "?",
                })
            end
        end
    end
    return found
end

-- ============ ФЛИНГ ПО ТАПУ НА НИК (кастом, в торс) ============
-- Тап по строке = вкл/выкл флинг этой цели. Контакт держится каждый кадр,
-- т.к. хитбокс гиганта капризный и с одного касания не флингает.
local RunService = game:GetService("RunService")
local FLING_SPIN = 50 -- средняя мощность, чуть ниже (рад/с). Больше = жёстче.
local flingTarget = nil
local flinging = false
local flingConns = {}
local flingSavedCF = nil
local flingT = 0 -- счётчик кадров орбиты
local TargetLabel = nil -- назначается в GUI (вкладка Флинг)

local function GetTorso(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function StopFling(silent, noRestore)
    flinging = false
    flingTarget = nil
    for _, c in ipairs(flingConns) do pcall(function() c:Disconnect() end) end
    flingConns = {}
    pcall(function()
        local c = LocalPlayer.Character
        if c then
            for _, v in ipairs(c:GetDescendants()) do
                if (v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity")) and v.Name == "_GFling" then
                    v:Destroy()
                end
            end
            local hum = c:FindFirstChildOfClass("Humanoid")
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hum then
                hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                hum.PlatformStand = false
                hum.Sit = false
                hum.AutoRotate = true
            end
            if hrp and flingSavedCF and not noRestore then
                hrp.CFrame = flingSavedCF
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)
    flingSavedCF = nil
    pcall(function() if TargetLabel then TargetLabel.Text = "Цель флинга: нет" end end)
    if not silent then Notify("Fling", "Флинг остановлен") end
end

local function StartFling(plr)
    if plr == nil then return end
    if flinging and flingTarget == plr then StopFling(false) return end
    StopFling(true)
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if hrp == nil or hum == nil or hum.Health <= 0 then
        Notify("Fling", "Нет живого персонажа")
        return
    end
    flingSavedCF = hrp.CFrame
    flingTarget = plr
    flinging = true
    flingT = 0
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        hum.PlatformStand = false
        hum.Sit = false
        hum.AutoRotate = false
    end)
    local ang = Instance.new("BodyAngularVelocity")
    ang.Name = "_GFling"
    ang.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    ang.AngularVelocity = Vector3.new(15, FLING_SPIN, 0)
    ang.P = 1250
    ang.Parent = hrp
    local vel = Instance.new("BodyVelocity")
    vel.Name = "_GFling"
    vel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    vel.Velocity = Vector3.new(0, 0, 0)
    vel.Parent = hrp
    Notify("Fling", "Флингаю: " .. plr.DisplayName .. " (тап снова = стоп)")
    pcall(function() if TargetLabel then TargetLabel.Text = "Цель флинга: " .. plr.DisplayName end end)
    local hb = RunService.Heartbeat:Connect(function()
        if not flinging then return end
        if flingTarget == nil or flingTarget.Parent == nil then
            StopFling(false)
            Notify("Fling", "Цель ушла с сервера")
            return
        end
        local my = LocalPlayer.Character
        local myHRP = my and my:FindFirstChild("HumanoidRootPart")
        local myHum = my and my:FindFirstChildOfClass("Humanoid")
        if myHRP == nil or myHum == nil or myHum.Health <= 0 then return end
        local tchar = flingTarget.Character
        local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
        local torso = GetTorso(tchar)
        if torso == nil or thum == nil or thum.Health <= 0 then return end
        flingT = flingT + 1
        pcall(function()
            for _, v in ipairs(my:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
            myHum.Sit = false
            myHum.PlatformStand = false
            myHum.AutoRotate = false
            -- Дёргаем торс во все 6 сторон сквозь него + ковыляние наклоном.
            -- Каждый кадр новая точка контакта: хитбокс не успевает "отпустить".
            local a = flingT * 0.55
            local ox = math.sin(a) * 2.0 -- влево-вправо
            local oy = -1.0 + math.sin(a * 1.7) * 1.6 -- вверх-вниз вокруг живота
            local oz = math.cos(a * 0.8) * 2.0 -- вперёд-назад
            local tilt = CFrame.Angles(math.rad(30) * math.sin(a * 1.3), flingT * 0.9, math.rad(30) * math.cos(a))
            myHRP.CFrame = torso.CFrame * CFrame.new(ox, oy, oz) * tilt
            myHRP.Velocity = torso.Velocity + Vector3.new(ox * 10, 14, oz * 10)
            myHRP.RotVelocity = Vector3.new(25, FLING_SPIN, 0)
        end)
    end)
    table.insert(flingConns, hb)
end

