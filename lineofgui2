    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local beast = IsBeast(plr)
    local show = (beast and Config.ESP_Beast) or ((not beast) and Config.ESP_Survivor)
    local hl = c:FindFirstChild("_FTF_HL")
    local bb = c:FindFirstChild("_FTF_BB")
    if not show then if hl then hl:Destroy() end if bb then bb:Destroy() end return end
    local col = beast and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(60, 255, 120)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "_FTF_HL"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.6 hl.OutlineTransparency = 0
        hl.Parent = c
    end
    hl.FillColor = col hl.OutlineColor = col
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = "_FTF_BB"
        bb.Size = UDim2.new(0, 140, 0, 42)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = c
        local tl = Instance.new("TextLabel")
        tl.Name = "TL" tl.Size = UDim2.new(1,0,1,0)
        tl.BackgroundTransparency = 1
        tl.Font = Enum.Font.GothamBold tl.TextSize = 12
        tl.TextStrokeTransparency = 0.3
        tl.Parent = bb
    end
    local my = GetHRP()
    local dist = my and math.floor((my.Position - hrp.Position).Magnitude) or 0
    local tl = bb:FindFirstChild("TL")
    if tl then
        tl.Text = plr.DisplayName .. " (" .. dist .. "m)\n" .. (beast and "BEAST 👹" or "SURVIVOR") .. " | " .. math.floor(hum.Health) .. "HP"
        tl.TextColor3 = col
    end
    local head = c:FindFirstChild("Head")
    if head then bb.Adornee = head end
end

local function ESPObject(model, hlName, bbName, text, color)
    if not model or not model.Parent then return end
    local main = model:IsA("BasePart") and model or (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true))
    if not main then return end
    local hl = model:FindFirstChild(hlName)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = hlName
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.7 hl.OutlineTransparency = 0
        hl.FillColor = color hl.OutlineColor = color
        pcall(function() hl.Parent = model end)
        if not hl.Parent then hl:Destroy() return end
    end
    local bb = model:FindFirstChild(bbName)
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = bbName
        bb.Size = UDim2.new(0, 120, 0, 28)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        pcall(function() bb.Parent = model bb.Adornee = main end)
        local tl = Instance.new("TextLabel")
        tl.Name = "TL" tl.Size = UDim2.new(1,0,1,0)
        tl.BackgroundTransparency = 1 tl.Font = Enum.Font.GothamBold tl.TextSize = 12
        tl.TextStrokeTransparency = 0.2 tl.TextColor3 = color tl.Text = text
        tl.Parent = bb
    else
        local tl = bb:FindFirstChild("TL")
        if tl then tl.Text = text tl.TextColor3 = color end
    end
end

