-- Loop Infect: телепорт-инфект по всем выжившим
task.spawn(function()
    while gui.Parent and IsCurrentGen() do
        task.wait(0.5)
        if Config.LoopInfect then
            pcall(function()
                local my = GetHRP()
                if not my then return end
                local save = my.CFrame
                local anyPiggy = AmIPiggy()
                for _, p in ipairs(GetSurvivors()) do
                    local t = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    local th = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                    if t and th and th.Health > 0 then
                        local d = (my.Position - t.Position).Magnitude
                        if d <= Config.InfectDistance * 4 then
                            -- рядом: просто тач + ремоут
                            InfectPlayer(p)
                        else
                            -- далеко: подлёт если мы Piggy или Noclip/Fly
                            if anyPiggy or Config.Noclip or Config.FlyEnabled then
                                my.CFrame = t.CFrame + Vector3.new(0, 0, 1)
                                task.wait(0.12)
                                InfectPlayer(p)
                            else
                                InfectPlayer(p) -- всё равно пробуем ремоутами
                            end
                        end
                    end
                    if not Config.LoopInfect then break end
                    task.wait(0.1)
                end
                -- вернуть назад если улетали
                pcall(function() if (my.Position - save.Position).Magnitude > 30 then my.CFrame = save end end)
            end)
        end
    end
end)

