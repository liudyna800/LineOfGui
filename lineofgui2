-- Piggy = у кого нож/бита/морф Piggy / атрибут Piggy / красное имя / Team Piggy
local function IsPiggy(plr)
    local ok, res = pcall(function()
        if not plr then return false end
        if plr.Team and plr.Team.Name then
            local t = string.lower(plr.Team.Name)
            if string.find(t, "piggy") or string.find(t, "infected") or string.find(t, "monster") or string.find(t, "traitor") then return true end
            if string.find(t, "survivor") or string.find(t, "player") then
                -- не выходим, дальше проверяем тулзы (вдруг уже заражён)
            end
        end
        if plr:GetAttribute("Piggy") == true or plr:GetAttribute("IsPiggy") == true
        or plr:GetAttribute("Infected") == true or plr:GetAttribute("IsInfected") == true then return true end
        local c = plr.Character
        if c then
            if c:GetAttribute("Piggy") == true or c:GetAttribute("Infected") == true then return true end
            for _, tool in ipairs(c:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = string.lower(tool.Name)
                    if string.find(n, "knife") or string.find(n, "bat") or string.find(n, "piggy")
                    or string.find(n, "sword") or string.find(n, "hammer") or string.find(n, "claw")
                    or string.find(n, "baton") or string.find(n, "wrench") then return true end
                end
            end
            -- Piggy часто больше/красноглазый, но надёжнее по тулзе + Backpack
            local bp = plr:FindFirstChild("Backpack")
            if bp then
                for _, tool in ipairs(bp:GetChildren()) do
                    if tool:IsA("Tool") then
                        local n = string.lower(tool.Name)
                        if string.find(n, "knife") or string.find(n, "bat") or string.find(n, "piggy") then return true end
                    end
                end
            end
        end
        return false
    end)
    return ok and res == true
end

