                Status.Text = "Гигантов: 0 | Онлайн: " .. #Players:GetPlayers() .. " | Хоп через " .. left .. "с [" .. QueueStatus .. "] АВТОХОП:" .. (AUTO_HOP and "ВКЛ" or "ВЫКЛ")
                if AUTO_HOP and hopTimer >= HOP_DELAY then
                    hopTimer = 0
                    ServerHop()
                    task.wait(5)
                end
            end
        end
    end
end)

