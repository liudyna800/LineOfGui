-- Снятие кулдауна как в рабочих хабах: Cooldown.Value + атрибуты + значения
local function NoCdBat(tool)
    pcall(function()
        local cd = tool:FindFirstChild("Cooldown")
        if cd and (cd:IsA("NumberValue") or cd:IsA("IntValue")) then cd.Value = 0 end
        for _, an in ipairs({"Cooldown", "AttackCooldown", "CooldownTime", "SwingCooldown", "HitCooldown", "Debounce", "LastAttack", "NextAttack"}) do
            if tool:GetAttribute(an) ~= nil then tool:SetAttribute(an, 0) end
        end
        tool.Enabled = true
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = string.lower(v.Name)
                if n ~= "durability" and (string.find(n, "cooldown") or string.find(n, "debounce") or string.find(n, "lastattack") or string.find(n, "nextattack") or string.find(n, "swing") or string.find(n, "reload")) then
                    v.Value = 0
                end
            elseif v:IsA("BoolValue") then
                local n = string.lower(v.Name)
                if string.find(n, "debounce") or string.find(n, "cooldown") or string.find(n, "attacking") then
                    v.Value = false
                end
            end
        end
    end)
end

