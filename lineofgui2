-- Beast: у зверя Hammer в руках / атрибут Beast / красная аура
local function IsBeast(plr)
    local ok, res = pcall(function()
        if not plr or plr == LocalPlayer then
            -- проверяем себя тоже
        end
        local c = plr.Character
        if c then
            if c:GetAttribute("Beast") == true or c:GetAttribute("IsBeast") == true then return true end
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") then
                    local n = string.lower(t.Name)
                    if string.find(n, "hammer") or string.find(n, "beast") or string.find(n, "mallet") then return true end
                end
            end
            -- рюкзак
            local bp = plr:FindFirstChild("Backpack")
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") then
                        local n = string.lower(t.Name)
                        if string.find(n, "hammer") or string.find(n, "beast") then return true end
                    end
                end
            end
        end
        if plr:GetAttribute("Beast") == true or plr:GetAttribute("IsBeast") == true then return true end
        -- по leaderstats / team
        if plr.Team and plr.Team.Name then
            local tn = string.lower(plr.Team.Name)
            if string.find(tn, "beast") then return true end
        end
        return false
    end)
    return ok and res == true
end

local function AmIBeast()
    return IsBeast(LocalPlayer)
end

-- Компьютеры: ищем по именам в Workspace
local function GetComputers()
    local out = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("Model") then
                local n = string.lower(d.Name)
                if string.find(n, "computer") or string.find(n, "pc_") or n == "pc" then
                    local main = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
                    if main then
                        -- hacked? экран зелёный / атрибут
                        local hacked = false
                        pcall(function()
                            if d:GetAttribute("Hacked") == true then hacked = true end
                            for _, p in ipairs(d:GetDescendants()) do
                                if p:IsA("BasePart") and string.find(string.lower(p.Name), "screen") then
                                    if p.BrickColor == BrickColor.new("Lime green") or p.BrickColor == BrickColor.new("Bright green") then
                                        hacked = true
                                    end
                                    -- Color3 check
                                    if p.Color and p.Color.G > 0.7 and p.Color.R < 0.3 then hacked = true end
                                end
                            end
                        end)
                        table.insert(out, {model = d, pos = main.Position, hacked = hacked, name = d.Name})
                    end
                end
            end
        end
    end)
    return out
end

local function GetExits()
    local out = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("Model") then
                local n = string.lower(d.Name)
                if string.find(n, "exit") or string.find(n, "escape") or string.find(n, "door") and string.find(n, "exit") then
                    local main = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
                    if main then table.insert(out, {model = d, pos = main.Position, name = d.Name}) end
                end
            elseif d:IsA("BasePart") then
                local n = string.lower(d.Name)
                if n == "exitdoor" or n == "exit" then
                    table.insert(out, {model = d, pos = d.Position, name = d.Name})
                end
            end
        end
    end)
    return out
end

