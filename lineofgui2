-- lineofgui2 build 27: patch-loader. Base + invpatch27 splice, no stale copy.
print("[LineOfBots] lineofgui2 build 27 patch-loader")
local stamp = tostring(os.time())
local function get(url)
	local ok, res = pcall(function() return game:HttpGet(url, true) end)
	if not ok then ok, res = pcall(function() return game:HttpGet(url) end) end
	if ok and type(res) == "string" then return res end
	return nil
end
local base = get("https://raw.githubusercontent.com/liudyna800/LineOfGui/main/LineOfBotsBeta2.lua?b27=" .. stamp)
	or get("https://raw.githubusercontent.com/liudyna800/LineOfGui/main/LineOneGui?b27=" .. stamp)
assert(base and #base > 400000, "[LineOfBots] FAILED: base not fetched")
local patch = get("https://raw.githubusercontent.com/liudyna800/LineOfGui/main/invpatch27?b27=" .. stamp)
assert(patch and #patch > 8000 and patch:find("UNIVERSAL inventory", 1, true), "[LineOfBots] FAILED: invpatch27 not fetched")
local s0 = base:find("v21 Beta 2 p.3: Inventory INLINE", 1, true)
local e0 = base:find("v25 INVENTORY wiring", 1, true)
assert(s0 and e0 and e0 > s0, "[LineOfBots] FAILED: markers missing")
local s = s0
while s > 1 and base:sub(s - 1, s - 1) ~= "\n" do s = s - 1 end
local e = e0
while e > 1 and base:sub(e - 1, e - 1) ~= "\n" do e = e - 1 end
base = base:sub(1, s - 1) .. patch .. "\n" .. base:sub(e)
base = base:gsub("build 26 LOADED", "build 27 LOADED")
base = base:gsub("Beta2%-inv build 26 loaded", "Beta2-inv build 27 loaded")
base = base:gsub("v20 beta 2, build 26", "v20 beta 2, build 27")
print("[LineOfBots] patched OK (" .. #base .. " bytes), starting")
local fn, err = loadstring(base)
assert(fn, "[LineOfBots] FAILED loadstring: " .. tostring(err))
fn()
