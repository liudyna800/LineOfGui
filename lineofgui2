                Notify("Killer", "Цель: " .. target.DisplayName .. " - бью пока не убью (чат)")
                pcall(function() if TargetLabel then TargetLabel.Text = "Цель: " .. target.DisplayName end end)
            else
                Notify("Killer", "Не нашёл игрока: " .. nick)
            end
        end
