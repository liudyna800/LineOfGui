local function MyChar() return LocalPlayer.Character end
local function MyHRP() local c = MyChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function MyHum() local c = MyChar() return c and c:FindFirstChildOfClass("Humanoid") end

local function GetMainWeaponName()
    local ok, w = pcall(function()
        local v = LocalPlayer.Marketplace["Main Weapon"].Equipped.Value
        if v and v ~= "Default" then return v end
        return "Bat"
    end)
    if ok and w and w ~= "" then return w end
    return "Bat"
end

local function ImGrabbed()
    local c = MyChar()
    if not c then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum and hum.Seated then return true end
    if c:GetAttribute("Grabbed") == true then return true end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in ipairs(hrp:GetChildren()) do
            if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then return true end
        end
    end
    return false
end

local function RespawnMe()
    pcall(function()
        local hum = MyHum()
        if hum then hum.Health = 0 end
    end)
    pcall(function()
        local c = MyChar()
        if c then c:BreakJoints() end
    end)
end

local function IsBatName(n)
    return string.find(n, "bat") or string.find(n, "club") or string.find(n, "baseball") or string.find(n, "wooden")
end

local function FindBat()
    local wName = GetMainWeaponName()
    local function scan(par)
        if par then
            for _, t in ipairs(par:GetChildren()) do
                if t:IsA("Tool") and (t.Name == wName or IsBatName(string.lower(t.Name))) then return t end
            end
        end
        return nil
    end
    return scan(MyChar()) or scan(LocalPlayer:FindFirstChild("Backpack"))
end

local function EquipBat(tool)
    if tool == nil then return end
    pcall(function()
        local hum = MyHum()
        if hum and tool.Parent ~= MyChar() then hum:EquipTool(tool) end
    end)
end

-- Снятие кулдауна как в рабочих хабах: Cooldown.Value + атрибуты + значения
local function NoCdBat(tool)
    pcall(function()
        local cd = tool:FindFirstChild("Cooldown")
        if cd and (cd:IsA("NumberValue") or cd:IsA("IntValue")) then cd.Value = 0 end
        for _, an in ipairs({"Cooldown", "AttackCooldown", "CooldownTime", "SwingCooldown", "HitCooldown", "Debounce", "LastAttack", "NextAttack"}) do
            if tool:GetAttribute(an) ~= nil then tool:SetAttribute(an, 0) end
        end
        tool.Enabled = true
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = string.lower(v.Name)
                if n ~= "durability" and (string.find(n, "cooldown") or string.find(n, "debounce") or string.find(n, "lastattack") or string.find(n, "nextattack") or string.find(n, "swing") or string.find(n, "reload")) then
                    v.Value = 0
                end
            elseif v:IsA("BoolValue") then
                local n = string.lower(v.Name)
                if string.find(n, "debounce") or string.find(n, "cooldown") or string.find(n, "attacking") then
                    v.Value = false
                end
            end
        end
    end)
end

-- Раздув хитбокса тулы (бьёт серверный тач): только вокруг головы гиганта
local function ExpandBat(tool)
    pcall(function()
        for _, part in tool:GetDescendants() do
            if part:IsA("BasePart") and part:FindFirstChild("TouchInterest") then
                part.Size = Vector3.new(KILL_HITBOX, KILL_HITBOX, KILL_HITBOX)
                part.Massless = true
            end
        end
    end)
end

