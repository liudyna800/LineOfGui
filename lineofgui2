local function findByNames(names)
    for _,d in pairs(Workspace:GetDescendants()) do
        if d:IsA("BasePart") then
            for _,n in pairs(names) do
                if string.find(string.lower(d.Name), string.lower(n)) then return d.Position end
            end
            -- Swamp вода: большой полупрозрачный синий парт
            if string.find(d.Name:lower(),"water") and d.Size.Magnitude>40 then return d.Position end
        end
        if d:IsA("Model") then
            for _,n in pairs(names) do
                if string.find(string.lower(d.Name), string.lower(n)) then
                    local cf=d:GetModelCFrame() return cf.Position
                end
            end
        end
    end
    return nil
end

