-- ============ ESP LOOP ============
local function ApplyESP(plr)
    if plr == LocalPlayer then return end
    local c = plr.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local smiler = IsSmiler(plr)
    local show = (smiler and Config.ESP_Smiler) or ((not smiler) and Config.ESP_Human)
    local hl = c:FindFirstChild("_ISH_HL")
    local bb = c:FindFirstChild("_ISH_BB")
    if not show then
        if hl then hl:Destroy() end
        if bb then bb:Destroy() end
        return
    end
    local col = smiler and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 255, 90)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "_ISH_HL"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0
        hl.Parent = c
    end
    hl.FillColor = col
    hl.OutlineColor = col
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = "_ISH_BB"
        bb.Size = UDim2.new(0, 120, 0, 40)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = c
        local tl = Instance.new("TextLabel")
        tl.Name = "TL"
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 12
        tl.TextStrokeTransparency = 0.3
        tl.Parent = bb
    end
    local my = GetHRP()
    local dist = my and math.floor((my.Position - hrp.Position).Magnitude) or 0
    local tl = bb:FindFirstChild("TL")
    if tl then
        tl.Text = plr.DisplayName .. " (" .. dist .. "m)\n" .. (smiler and "SMILER" or "HUMAN") .. " | " .. math.floor(hum.Health) .. "HP"
        tl.TextColor3 = col
    end
    local head = c:FindFirstChild("Head")
    if head and bb then bb.Adornee = head end
end

