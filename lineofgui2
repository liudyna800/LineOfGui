-- Запасное управление через чат (если тапы по кнопкам не доходят):
-- /hop off - выкл автохоп, /hop on - вкл, /hop now - хоп сейчас
LocalPlayer.Chatted:Connect(function(msg)
    local m = string.lower(tostring(msg))
    if m == "/hop off" or m == "/ahop off" then
        AUTO_HOP = false
        hopTimer = 0
        Notify("Giant Raid", "Авто-хоп ВЫКЛ (чат)")
    elseif m == "/hop on" or m == "/ahop on" then
        AUTO_HOP = true
        hopTimer = 0
        Notify("Giant Raid", "Авто-хоп ВКЛ (чат)")
    elseif m == "/hop now" or m == "/ghop" then
        hopNow = true
        Notify("Giant Raid", "Хопаю сейчас (чат)")
    elseif m == "/unfling" or m == "/flingstop" then
        StopFling(false)
    else
        local nick = string.match(m, "^/fling%s+(.+)$")
        if nick then
            nick = string.gsub(string.gsub(nick, "^%s+", ""), "%s+$", "")
            local target = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and (string.lower(p.Name) == nick or string.lower(p.DisplayName) == nick) then
                    target = p
                    break
                end
            end
            if target == nil then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and (string.find(string.lower(p.Name), nick, 1, true) or string.find(string.lower(p.DisplayName), nick, 1, true)) then
                        target = p
                        break
                    end
                end
            end
            if target then
                StartFling(target)
            else
                Notify("Fling", "Не нашёл игрока: " .. nick)
            end
        end
    end
end)

