-- ── разбивка текста под лимит символов ───────────────────────────────────────
local ELLIPSIS = "..."          -- ASCII-многоточие: ровно 3 байта, в отличие от «…»
local PREFIX_LENGTH = 6         -- длина префикса "[1/2] " при максимум 3 частях

local function splitSentences(text)
	local out, current = {}, {}
	for index = 1, #text do
		local char = text:sub(index, index)
		table.insert(current, char)
		if char == "." or char == "!" or char == "?" or char == "\n" then
			table.insert(out, table.concat(current))
			current = {}
		end
	end
	if #current > 0 then table.insert(out, table.concat(current)) end
	return out
end

local function wrapWords(text, limit)
	local chunks, buffer = {}, ""
	for word in text:gmatch("%S+") do
		while #word > limit do
			if #buffer > 0 then
				table.insert(chunks, buffer)
				buffer = ""
			end
			table.insert(chunks, word:sub(1, limit))
			word = word:sub(limit + 1)
		end
		if #buffer == 0 then
			buffer = word
		elseif (#buffer + 1 + #word) <= limit then
			buffer = buffer .. " " .. word
		else
			table.insert(chunks, buffer)
			buffer = word
		end
	end
	if #buffer > 0 then table.insert(chunks, buffer) end
	return chunks
end

local function packText(text, limit)
	local result = {}
	for _, sentence in ipairs(splitSentences(text)) do
		local clean = trim(sentence)
		if clean ~= "" then
			if #clean <= limit then
				local last = result[#result]
				if last and (#last + 1 + #clean) <= limit then
					result[#result] = last .. " " .. clean
				else
					table.insert(result, clean)
				end
			else
				for _, piece in ipairs(wrapWords(clean, limit)) do
					table.insert(result, piece)
				end
			end
		end
	end
	if #result == 0 then table.insert(result, trim(text)) end
	return result
end

local function capParts(parts, limit, maxParts)
	if #parts <= maxParts then return parts end
	local keep = {}
	for index = 1, maxParts - 1 do keep[index] = parts[index] end
	local tail = table.concat(parts, " ", maxParts, #parts)
	if #tail > limit then
		tail = string.sub(tail, 1, math.max(1, limit - #ELLIPSIS)) .. ELLIPSIS
	end
	keep[maxParts] = tail
	return keep
end

local function prepareMessages(text, maxParts)
	local limit = math.max(40, State.settings.maxChars or 200)
	maxParts = maxParts or State.settings.maxParts or 2

	local parts = capParts(packText(text, limit), limit, maxParts)
	if #parts > 1 then
		-- освобождаем место под префикс вида "[1/2] "
		local room = math.max(20, limit - PREFIX_LENGTH)
		parts = capParts(packText(text, room), room, maxParts)
	end

	local messages = {}
	for index, part in ipairs(parts) do
		if #parts > 1 then
			local prefix = ("[%d/%d] "):format(index, #parts)
			local room = limit - #prefix
			if #part > room then
				part = string.sub(part, 1, math.max(1, room - #ELLIPSIS)) .. ELLIPSIS
			end
			part = prefix .. part
		elseif #part > limit then
			part = string.sub(part, 1, math.max(1, limit - #ELLIPSIS)) .. ELLIPSIS
		end
		messages[index] = part
	end
	return messages
end

