-- 1. EMOTE API (Управление и Поиск)
--------------------------------------------------------------------------------

local EmoteAPI = {}

function EmoteAPI.Stop()
    if CurrentTrack then
        CurrentTrack:Stop(0.15)
        CurrentTrack = nil
        TrackStartTime = 0
    end
end

local function GetAnimationId(assetId)
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)
    
    if success and objects and #objects > 0 then
        local item = objects[1]
        if item:IsA("Animation") and item.AnimationId ~= "" then
            return item.AnimationId
        end
        local animObj = item:FindFirstChildOfClass("Animation")
        if animObj and animObj.AnimationId ~= "" then
            return animObj.AnimationId
        end
    end
    return "rbxassetid://" .. tostring(assetId)
end

function EmoteAPI.Play(assetId)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid

    EmoteAPI.Stop()

    local realAnimId = GetAnimationId(assetId)
    local animObject = Instance.new("Animation")
    animObject.AnimationId = realAnimId

    local track = animator:LoadAnimation(animObject)
    track.Priority = Enum.AnimationPriority.Action4
    track:Play(0.1, 1, 1)
    
    CurrentTrack = track
    TrackStartTime = os.clock()
end

function EmoteAPI.Search(query, logFunc)
    local itemsFound = {}
    query = tostring(query):lower():gsub("[%c%p]", "") -- Очистка запроса
    
    if logFunc then logFunc("[Catalog API] Запрос в каталог по ключевику: '" .. query .. "'") end

    -- Прямой ввод ID
    local directId = tonumber(query)
    if directId then
        if logFunc then logFunc("[Catalog API] Засечен прямой ID: " .. directId) end
        return {{Name = "ID: " .. tostring(directId), Id = directId}}
    end

    -- Метод 1: AvatarEditorService
    local success, pages = pcall(function()
        local searchParams = CatalogSearchParams.new()
        searchParams.SearchKeyword = query
        searchParams.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        return AvatarEditorService:SearchCatalog(searchParams)
    end)

    if success and pages then
        local pageData = pcall(function() return pages:GetCurrentPage() end) and pages:GetCurrentPage() or {}
        for _, item in ipairs(pageData) do
            table.insert(itemsFound, {Name = item.Name, Id = item.Id})
        end
        if logFunc then logFunc("[AvatarEditorService] Найдено элементов: " .. #itemsFound) end
    else
        if logFunc then logFunc("[AvatarEditorService] Ошибка вызова или заблокировано.") end
    end

    -- Метод 2: Direct HTTP Request в Roblox Catalog
    if #itemsFound == 0 and request then
        if logFunc then logFunc("[HTTP Request] Запуск резервного HTTP-поиска...") end
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?category=11&subCategory=38&keyword=" .. HttpService:UrlEncode(query) .. "&limit=20"
            local response = request({Url = url, Method = "GET"})
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, {Name = item.name, Id = item.id})
                    end
                    if logFunc then logFunc("[HTTP Request] Успешно получено: " .. #itemsFound .. " эмоций") end
                end
            else
                if logFunc then logFunc("[HTTP Request] Пустой ответ от сервера Roblox.") end
            end
        end)
    end

    return itemsFound
end

