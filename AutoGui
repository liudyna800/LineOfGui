--[[ 
    AREA 51 SCANNER for Delta Executor
    Что делает: сканирует Explorer (Workspace, Teams, Players, ReplicatedStorage и т.д.)
    и сохраняет всё в .txt файлы в Workspace папку Delta (writefile).

    Как пользоваться:
    1. Зайди в плейс Area 51 > Killer Mode
    2. Вставь этот скрипт в Delta > Execute
    3. Жди 5-15 сек (в консоли будет прогресс)
    4. Файлы появятся в Delta Workspace: Area51_Dump/
       - summary.txt (команды, игроки, таймеры, роли)
       - remotes.txt (все RemoteEvent / RemoteFunction - для фарма/килла)
       - full_tree.txt (дерево Explorer до глубины)
       - tools.txt (оружие, инструменты)
    5. Скинь мне эти файлы сюда - допилю killer-скрипт точно под архитектуру
]]

local FOLDER = "Area51_Dump"
local MAX_DEPTH = 4          -- глубина дерева (4 = безопасно, 6 = полный но долго)
local MAX_CHILD_PER_NODE = 150 -- лимит детей на узел чтобы не зависнуть
local SCAN_DELAY = false     -- true = медленнее но не лагает

--// проверка executor функций
if not writefile or not makefolder then
    warn("[Scanner] Твой executor НЕ поддерживает writefile/makefolder. Нужен Delta.")
    return
end

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer

pcall(function() makefolder(FOLDER) end)

local function safeWrite(path, content)
    pcall(function() writefile(path, content) end)
end

local function fullPath(inst)
    local ok, res = pcall(function() return inst:GetFullName() end)
    if ok then return res else return inst.Name end
end

local function attrsToStr(inst)
    local out = {}
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if ok and attrs then
        for k,v in pairs(attrs) do
            table.insert(out, k.."="..tostring(v))
        end
    end
    if #out > 0 then return " [Attrs: "..table.concat(out, ", ").."]" end
    return ""
end

--// 1. SUMMARY - самое важное для killer-режима
local function buildSummary()
    local L = {}
    local function add(s) table.insert(L, s) end

    add("=== AREA 51 KILLER MODE DUMP ===")
    add("Date: "..os.date("%Y-%m-%d %H:%M:%S"))
    add("PlaceId: "..tostring(game.PlaceId))
    add("JobId: "..tostring(game.JobId))
    add("")

    -- Teams
    add("--- TEAMS ("..#Teams:GetTeams()..") ---")
    for _,t in ipairs(Teams:GetTeams()) do
        add("Team: '"..t.Name.."' | Color: "..tostring(t.TeamColor).." | Players: "..#t:GetPlayers().." | AutoAssignable: "..tostring(t.AutoAssignable))
        for _,p in ipairs(t:GetPlayers()) do
            add("   - "..p.Name.." ("..p.DisplayName..")")
        end
    end
    -- игроки без команды
    local noTeam = {}
    for _,p in ipairs(Players:GetPlayers()) do
        if not p.Team then table.insert(noTeam, p.Name) end
    end
    add("Players without Team ("..#noTeam.."): "..table.concat(noTeam, ", "))
    add("")

    -- LocalPlayer подробно
    add("--- LOCALPLAYER ---")
    add("Name: "..LocalPlayer.Name)
    add("Team: "..(LocalPlayer.Team and LocalPlayer.Team.Name or "NIL"))
    add("TeamColor: "..tostring(LocalPlayer.TeamColor))
    pcall(function()
        for k,v in pairs(LocalPlayer:GetAttributes()) do
            add("Attr "..k.." = "..tostring(v))
        end
    end)
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        add("leaderstats:")
        for _,v in ipairs(ls:GetChildren()) do
            add("  "..v.ClassName.." "..v.Name.." = "..tostring(v.Value))
        end
    else
        add("leaderstats: NIL")
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        add("PlayerGui ("..#pg:GetChildren().."):")
        for _,g in ipairs(pg:GetChildren()) do
            add("  ScreenGui: "..g.Name.." ("..g.ClassName..")")
            -- ищем таймеры / роли внутри GUI по именам
            for _,d in ipairs(g:GetDescendants()) do
                local n = string.lower(d.Name)
                if string.find(n,"time") or string.find(n,"timer") or string.find(n,"role") or string.find(n,"team") or string.find(n,"kill") or string.find(n,"swap") or string.find(n,"round") then
                    local txt = ""
                    pcall(function()
                        if d:IsA("TextLabel") or d:IsA("TextButton") then txt = " Text='"..tostring(d.Text):sub(1,80).."'" end
                        if d:IsA("StringValue") or d:IsA("IntValue") then txt = " Value="..tostring(d.Value) end
                    end)
                    add("    ["..d.ClassName.."] "..fullPath(d)..txt)
                end
            end
        end
    end
    add("")

    -- Character
    add("--- CHARACTER ---")
    local ch = LocalPlayer.Character
    if ch then
        for _,v in ipairs(ch:GetChildren()) do
            add("  "..v.ClassName.." "..v.Name)
        end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if hum then
            add("  Humanoid: HP "..tostring(hum.Health).."/"..tostring(hum.MaxHealth).." WalkSpeed="..tostring(hum.WalkSpeed).." Jump="..tostring(hum.JumpPower))
        end
    else
        add("Character NIL")
    end
    add("")

    -- Подозрительные Values для ролей/таймера во всей игре (быстрый поиск)
    add("--- ROLE / TIMER VALUES (поиск по именам) ---")
    local keywords = {"role","team","killer","surviv","monster","beast","swap","round","timer","timeleft","intermission","mode"}
    local found = 0
    for _,svc in ipairs({Workspace, ReplicatedStorage, Lighting, StarterGui, Teams}) do
        for _,d in ipairs(svc:GetDescendants()) do
            if found > 200 then break end
            local ln = string.lower(d.Name)
            for _,k in ipairs(keywords) do
                if string.find(ln, k) then
                    local val = ""
                    pcall(function()
                        if d:IsA("ValueBase") then val = " Value="..tostring(d.Value)
                        elseif d:IsA("TextLabel") or d:IsA("TextButton") then val = " Text='"..tostring(d.Text):sub(1,80).."'"
                        end
                    end)
                    add("["..d.ClassName.."] "..fullPath(d)..val)
                    found = found + 1
                    break
                end
            end
        end
    end
    add("Total role/timer matches: "..found)
    add("")

    -- Workspace прямыe дети (спавны, карта)
    add("--- WORKSPACE TOP ("..#Workspace:GetChildren()..") ---")
    for _,c in ipairs(Workspace:GetChildren()) do
        local cnt = 0
        pcall(function() cnt = #c:GetChildren() end)
        add("["..c.ClassName.."] "..c.Name.." (children: "..cnt..")")
    end
    add("")

    -- ReplicatedStorage топ
    add("--- REPLICATEDSTORAGE TOP ("..#ReplicatedStorage:GetChildren()..") ---")
    for _,c in ipairs(ReplicatedStorage:GetChildren()) do
        local cnt = 0
        pcall(function() cnt = #c:GetChildren() end)
        add("["..c.ClassName.."] "..c.Name.." (children: "..cnt..")")
    end

    return table.concat(L, "\n")
end

--// 2. REMOTES - все RemoteEvent/Function (нужны для килла/фарма)
local function buildRemotes()
    local L = {"=== REMOTES DUMP ===", "PlaceId: "..tostring(game.PlaceId), ""}
    local count = {RemoteEvent=0, RemoteFunction=0, BindableEvent=0, BindableFunction=0}
    for _,svc in ipairs({game, Workspace, ReplicatedStorage, StarterGui, Teams, Lighting, Players}) do
        local svcName = "game"
        pcall(function() svcName = svc:GetFullName() end)
        table.insert(L, "--- Service: "..svcName.." ---")
        for _,d in ipairs(svc:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("BindableEvent") or d:IsA("BindableFunction") then
                count[d.ClassName] = (count[d.ClassName] or 0) + 1
                table.insert(L, "["..d.ClassName.."] "..fullPath(d)..attrsToStr(d))
            end
        end
    end
    table.insert(L, "")
    table.insert(L, "TOTAL: RemoteEvent="..(count.RemoteEvent or 0).." RemoteFunction="..(count.RemoteFunction or 0).." BindableEvent="..(count.BindableEvent or 0).." BindableFunction="..(count.BindableFunction or 0))
    return table.concat(L, "\n")
end

--// 3. TOOLS
local function buildTools()
    local L = {"=== TOOLS / WEAPONS ===", ""}
    for _,svc in ipairs({ReplicatedStorage, Workspace, StarterGui, LocalPlayer:FindFirstChild("Backpack") or ReplicatedStorage, LocalPlayer.Character or Workspace}) do
        local ok, name = pcall(function() return svc:GetFullName() end)
        table.insert(L, "--- "..(ok and name or "?").." ---")
        local n = 0
        for _,d in ipairs(svc:GetDescendants()) do
            if d:IsA("Tool") or d:IsA("HopperBin") then
                n = n + 1
                if n < 300 then
                    table.insert(L, "[Tool] "..fullPath(d).." | RequiresHandle="..tostring(d.RequiresHandle))
                end
            end
        end
        table.insert(L, "Found tools: "..n)
        table.insert(L, "")
    end
    return table.concat(L, "\n")
end

--// 4. FULL TREE с лимитом
local treeLines = {}
local function dumpNode(inst, depth)
    if depth > MAX_DEPTH then return end
    local children = {}
    pcall(function() children = inst:GetChildren() end)
    local total = #children
    local shown = math.min(total, MAX_CHILD_PER_NODE)
    for i=1, shown do
        local c = children[i]
        local indent = string.rep("  ", depth)
        local line = indent.."- ["..c.ClassName.."] "..c.Name..attrsToStr(c)
        -- значения для ValueBase / Text
        pcall(function()
            if c:IsA("ValueBase") then line = line.." = "..tostring(c.Value)
            elseif c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
                local t = tostring(c.Text or "")
                if #t > 0 then line = line.." Text='"..t:sub(1,60).."' " end
            end
        end)
        table.insert(treeLines, line)
        if SCAN_DELAY and depth >= 3 then task.wait() end
        -- рекурсия
        dumpNode(c, depth+1)
    end
    if total > shown then
        table.insert(treeLines, string.rep("  ", depth).."... (+"..(total-shown).." more in "..inst.Name..")")
    end
end

local function buildTree()
    treeLines = {"=== FULL TREE (depth="..MAX_DEPTH..", limit="..MAX_CHILD_PER_NODE.."/node) ===", "PlaceId: "..tostring(game.PlaceId), ""}
    for _,svcName in ipairs({"Workspace","Players","Lighting","MaterialService","ReplicatedFirst","ReplicatedStorage","ServerStorage","StarterGui","StarterPack","StarterPlayer","Teams","SoundService","Chat"}) do
        local svc = nil
        pcall(function() svc = game:GetService(svcName) end)
        if svc then
            table.insert(treeLines, "")
            table.insert(treeLines, "== "..svcName.." ==")
            dumpNode(svc, 1)
        end
    end
    -- PlayerGui отдельно (там таймер режима)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            table.insert(treeLines, "")
            table.insert(treeLines, "== PlayerGui ("..LocalPlayer.Name..") ==")
            dumpNode(pg, 1)
        end
    end)
    return table.concat(treeLines, "\n")
end

