        local searchParams = CatalogSearchParams.new()
        searchParams.SearchKeyword = query or ""
        searchParams.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        return AvatarEditorService:SearchCatalog(searchParams)
    end)

    if success and pages then
        local pageData = pcall(function() return pages:GetCurrentPage() end) and pages:GetCurrentPage() or {}
        for _, item in ipairs(pageData) do
            table.insert(itemsFound, {Name = item.Name, Id = item.Id})
