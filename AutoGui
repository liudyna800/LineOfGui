TabHuman:CreateParagraph({Title = "Как работает Kill Aura", Content = "Телепортируется к врагу (смайлу) и бьёт с увеличенным хитбоксом."})

local function GetEnemies()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= plr and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local enemy = true
                pcall(function()
                    if plr.Team and p.Team and plr.Team == p.Team then enemy = false end
                end)
                if enemy then table.insert(list, p) end
            end
        end
    end
    return list
end

TabHuman:CreateToggle({
    Name = "Kill All (по очереди телепорт + удар)",
    CurrentValue = false,
    Flag = "KillAll",
    Callback = function(v)
        State.KillAura = v
        if v then
            task.spawn(function()
                Notify("Kill All", "Запущено. Выключается той же кнопкой.", 3)
                while State.KillAura do
                    local enemies = GetEnemies()
                    if #enemies == 0 then task.wait(1.5) continue end
                    local target = enemies[1]
                    local t0 = tick()
                    while State.KillAura and (tick()-t0 < 8) do
                        task.wait(0.05)
                        pcall(function()
                            if not target.Parent then return end
                            local th = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
                            if not th or th.Health <= 0 then return end
                            local myC = MyChar()
                            local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                            local mHRP = myC and myC:FindFirstChild("HumanoidRootPart")
                            if not tHRP or not mHRP then return end
                            local tool = myC:FindFirstChildOfClass("Tool")
                            if not tool then
                                local bp = plr.Backpack:FindFirstChild(GetMainWeaponName())
                                if bp then MyHum():EquipTool(bp) end
                                return
                            end
                            ExpandWeaponHitbox(tool)
                            mHRP.CFrame = CFrame.new(tHRP.Position + Vector3.new(0,2,3), tHRP.Position)
                            local sw = tool:FindFirstChild("SwingEvent")
                            if sw then sw:FireServer() end
                        end)
                        local dead = true
                        pcall(function()
                            local th = target.Character:FindFirstChildOfClass("Humanoid")
                            if th and th.Health > 0 then dead = false end
                        end)
                        if dead then break end
                    end
                    task.wait(0.3)
                end
            end)
        end
    end,
})

