local function isMentioned(text)
	local lowered = string.lower(text)
	local myName = string.lower(LocalPlayer.Name)
	local myDisplay = string.lower(LocalPlayer.DisplayName)
	if string.find(lowered, myName, 1, true) then return true end
	if myDisplay ~= myName and string.find(lowered, myDisplay, 1, true) then return true end
	if string.find(lowered, "@" .. myName, 1, true) then return true end
	return false
end

local function autoTriggerMatches(entry)
	local trigger = State.settings.autoTrigger or "any"
	if trigger == "any" then return true end
	if trigger == "insult" then return containsAny(entry.text, INSULT_WORDS) end
	-- mention: прямое обращение или оскорбление в мой адрес
	return isMentioned(entry.text) or containsAny(entry.text, INSULT_WORDS)
end

local function handleIncoming(info)
	local text = trim(info.text or "")
	if text == "" then return end
	local userId = tonumber(info.userId) or 0
	if isDuplicate(info.display or info.name, text) then return end

	local isSelf = (userId == LocalPlayer.UserId)
	local entry = pushLog({
		name = info.name or "?",
		display = info.display or info.name or "?",
		userId = userId,
		text = text,
		isSelf = isSelf,
		time = os.date("%H:%M:%S"),
	})

	if isSelf then return end
	if not State.targets[userId] then return end
	if State.settings.autoReply and App.maybeAutoReply and autoTriggerMatches(entry) then
		task.spawn(function()
			App.maybeAutoReply(entry)
		end)
	end
end

local function bindChat()
	local bound = false

	pcall(function()
		TextChatService.MessageReceived:Connect(function(message)
			local source = message.TextSource
			if not source then return end
			local displayName = source.DisplayName
			if type(displayName) ~= "string" or displayName == "" then displayName = source.Name end
			handleIncoming({
				userId = source.UserId or 0,
				name = source.Name or "?",
				display = displayName or "?",
				text = message.Text or "",
			})
		end)
		bound = true
	end)

	local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
	if not chatEvents then
		local ok, result = pcall(function()
			return ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 8)
		end)
		if ok then chatEvents = result end
	end
	if chatEvents then
		local onMessageDoneFiltering = chatEvents:FindFirstChild("OnMessageDoneFiltering")
		if onMessageDoneFiltering then
			onMessageDoneFiltering.OnClientEvent:Connect(function(data)
				if type(data) ~= "table" then return end
				local speaker = data.FromSpeaker or "?"
				local player = findPlayerByName(speaker)
				handleIncoming({
					userId = player and player.UserId or 0,
					name = player and player.Name or speaker,
					display = player and player.DisplayName or speaker,
					text = data.Message or "",
				})
			end)
			bound = true
		end
	end

	-- грубый запасной вариант, если оба хука не привязались
	if not bound then
		local function attach(player)
			player.Chatted:Connect(function(text, recipient)
				if recipient and recipient ~= "" and recipient ~= "All" then return end
				handleIncoming({
					userId = player.UserId,
					name = player.Name,
					display = player.DisplayName,
					text = tostring(text),
				})
			end)
		end
		for _, player in ipairs(Players:GetPlayers()) do attach(player) end
		Players.PlayerAdded:Connect(attach)
	end

	return bound
end

