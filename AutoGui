-- Bring visual+touch (твой способ из Area51)
RS.RenderStepped:Connect(function()
  if not S.Bring then return end
  pcall(function()
    local ch = LP.Character if not ch then return end
    local my = ch:FindFirstChild("HumanoidRootPart") if not my then return end
    local idx=0
    for _,p in ipairs(Players:GetPlayers()) do
      if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        local e = p.Character.HumanoidRootPart
        local h = p.Character:FindFirstChildOfClass("Humanoid")
        if h and h.Health>0 then
          idx=idx+1
          local row=math.floor((idx-1)/3) local col=(idx-1)%3-1
          e.CanCollide=false
          e.CFrame = my.CFrame * CFrame.new(col*4, 0.5, -S.BringDist - row*4)
          pcall(function() firetouchinterest(my, e, 0) firetouchinterest(my, e, 1) end)
        end
      end
    end
  end)
end)

