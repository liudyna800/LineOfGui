local function executorName()
	if type(identifyexecutor) == "function" then
		local ok, name, ver = pcall(identifyexecutor)
		if ok and name then
			return tostring(name) .. (ver and (" " .. tostring(ver)) or "")
		end
	end
	if type(getexecutorname) == "function" then
		local ok, name = pcall(getexecutorname)
		if ok and name then return tostring(name) end
	end
	return "unknown"
end

-- Функция HTTP-запроса: request / http_request / syn.request / http.request ...
local function pickHttpFunction()
	local direct = { "request", "http_request", "http_request_async", "syn_request" }
	for _, name in ipairs(direct) do
		local fn = ENV[name]
		if type(fn) == "function" then return fn end
	end
	local nested = { "syn", "http", "fluxus", "krnl" }
	for _, name in ipairs(nested) do
		local tbl = ENV[name]
		if type(tbl) == "table" and type(tbl.request) == "function" then return tbl.request end
	end
	return nil
end

local HTTP_FN = pickHttpFunction()

