--------------------------------------------------------------------------------
-- 1. EMOTE API (Конвертация Catalog ID -> Animation ID и воспроизведение)
--------------------------------------------------------------------------------

local EmoteAPI = {}

function EmoteAPI.Stop()
    if CurrentTrack then
        CurrentTrack:Stop(0.15)
        CurrentTrack = nil
        TrackStartTime = 0
    end
end

local function GetAnimationId(assetId, logFunc)
    -- 1. Попытка через GetObjects
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)
    
    if success and objects and #objects > 0 then
        for _, item in ipairs(objects) do
            if item:IsA("Animation") and item.AnimationId ~= "" then
                return item.AnimationId
            end
            local animObj = item:FindFirstChildOfClass("Animation", true)
            if animObj and animObj.AnimationId ~= "" then
                return animObj.AnimationId
            end
        end
    end

    -- 2. Fallback: Прямое извлечение настоящей AnimationId из сырых данных ассета
    local httpSuccess, rawData = pcall(function()
        return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. tostring(assetId))
    end)

    if httpSuccess and rawData then
        -- Ищем внутренний rbxassetid или id анимации в контейнере
        local realAnimId = rawData:match("rbxassetid://(%d+)") or rawData:match("id=(%d+)")
        if realAnimId and realAnimId ~= tostring(assetId) then
            if logFunc then logFunc("[AnimFix] Извлечен настоящий AnimationID: " .. realAnimId) end
            return "rbxassetid://" .. realAnimId
        end
    end

    return "rbxassetid://" .. tostring(assetId)
end

function EmoteAPI.Play(assetId, logFunc)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid

    EmoteAPI.Stop()

    local realAnimId = GetAnimationId(assetId, logFunc)
    
    local playSuccess, err = pcall(function()
        local animObject = Instance.new("Animation")
        animObject.AnimationId = realAnimId

        local track = animator:LoadAnimation(animObject)
        track.Priority = Enum.AnimationPriority.Action4
        track:Play(0.1, 1, 1)
        
        CurrentTrack = track
        TrackStartTime = os.clock()
    end)

    if not playSuccess and logFunc then
        logFunc("[Emote Error] Ошибка загрузки анимации: " .. tostring(err))
    end
end

function EmoteAPI.SearchCatalog(query, logFunc)
    local itemsFound = {}
    query = tostring(query):lower():gsub("[%c%p]", "")

    if logFunc then logFunc("[Catalog] Запрос в каталог: '" .. query .. "'") end

    -- Прямой ID
    local directId = tonumber(query)
    if directId then
        if logFunc then logFunc("[Catalog] Прямой ID: " .. directId) end
        return {{Name = "Custom ID: " .. tostring(directId), Id = directId}}
    end

    -- Метод 1: Категориальный поиск Roblox
    if request then
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?category=Community&subcategory=Emotes&keyword=" .. HttpService:UrlEncode(query) .. "&limit=10"
            local response = request({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Roblox/WinInet",
                    ["Accept"] = "application/json"
                }
            })
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, {Name = item.name, Id = item.id})
                    end
                end
            end
        end)
    end

    -- Метод 2: Глобальный fallback поиск
    if #itemsFound == 0 and request then
        if logFunc then logFunc("[Catalog Fallback] Переключение на общий поиск...") end
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?keyword=" .. HttpService:UrlEncode(query .. " emote") .. "&limit=10"
            local response = request({
                Url = url,
                Method = "GET",
                Headers = {["User-Agent"] = "Roblox/WinInet"}
            })
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, {Name = item.name, Id = item.id})
                    end
                end
            end
        end)
    end

    if logFunc then logFunc("[Catalog] Найдено элементов: " .. #itemsFound) end
    return itemsFound
end

