local lastNames = {}

task.spawn(function()
    setStatus("Загрузка сервера, старт через " .. START_DELAY .. "с...")
    task.wait(START_DELAY)
    while VERSION == getgenv().GSF_VERSION do
        local giants = scanGiants()

        -- ESP: подсвечиваем только гигантов
        for _, plr in ipairs(Players:GetPlayers()) do
            local isGiant = false
            for _, g in ipairs(giants) do
                if g.plr == plr then isGiant = true break end
            end
            if ESP then setESP(plr, isGiant) end
        end

        -- список гигантов + уведомления о новых
        local lines = {}
        for i, g in ipairs(giants) do
            if i <= 4 then
                table.insert(lines, g.plr.DisplayName .. " — " .. g.hp .. " HP")
            end
        end
        for _, g in ipairs(giants) do
            if not lastNames[g.plr.Name] then
                notify("ГИГАНТ НАЙДЕН!", g.plr.DisplayName .. " | " .. g.hp .. " HP", 6)
            end
        end
        lastNames = {}
        for _, g in ipairs(giants) do lastNames[g.plr.Name] = true end
        setGiants(#giants > 0 and table.concat(lines, "\n") or "Гигантов на сервере: 0")

        if #giants > 0 then
            setStatus("ГИГАНТ НАЙДЕН! Игроков на сервере: " .. #Players:GetPlayers())
        else
            setStatus("Гигантов нет. Сканирую каждые " .. SCAN_INTERVAL .. "с (серверхоп — кнопкой «Хоп сейчас»)")
        end
        task.wait(SCAN_INTERVAL)
    end
end)
