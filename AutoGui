-- NoCD + InfUses: Cooldown NumberValue=0, Uses/MaxUses=999
task.spawn(function()
  while true do
    task.wait(0.5)
    if S.NoCD or S.InfUses then
      for _,t in ipairs(MyTools()) do
        pcall(function()
          if S.NoCD then
            local cd = t:FindFirstChild("Cooldown")
            if cd and cd:IsA("NumberValue") then cd.Value = 0 end
            local at = t:FindFirstChild("ActivateTick")
            if at and at:IsA("NumberValue") then at.Value = 0 end
          end
          if S.InfUses then
            local u = t:FindFirstChild("Uses")
            if u and u:IsA("IntValue") then u.Value = 999 end
            local m = t:FindFirstChild("MaxUses")
            if m and m:IsA("IntValue") then m.Value = 999 end
          end
        end)
      end
    end
  end
end)

-- Kill Aura Human: бьем Smiling через Activate + SwingEvent + touch
task.spawn(function()
  while true do
    task.wait(0.15)
    if S.AuraHuman then
      pcall(function()
        local ch = LP.Character if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart") if not hrp then return end
        local tool = ch:FindFirstChildOfClass("Tool")
        if not tool then EquipBest() tool = ch:FindFirstChildOfClass("Tool") end
        for _,p in ipairs(Players:GetPlayers()) do
          if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 and (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude <= S.AuraR then
              if tool then
                tool:Activate()
                local sw = tool:FindFirstChild("SwingEvent")
                if sw and sw:IsA("RemoteEvent") then pcall(function() sw:FireServer() end) end
                if tool:FindFirstChild("Handle") then
                  pcall(function()
                    firetouchinterest(tool.Handle, p.Character.HumanoidRootPart, 0) task.wait()
                    firetouchinterest(tool.Handle, p.Character.HumanoidRootPart, 1)
                  end)
                else
                  -- Chain/Shovel без Handle: бьем BodyAttach/первой MeshPart
                  for _,part in ipairs(tool:GetChildren()) do
                    if part:IsA("BasePart") then
                      pcall(function()
                        firetouchinterest(part, p.Character.HumanoidRootPart, 0) task.wait()
                        firetouchinterest(part, p.Character.HumanoidRootPart, 1)
                      end)
                      break
                    end
                  end
                end
              end
            end
          end
        end
      end)
    end
  end
end)

