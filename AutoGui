--// helpers (по скану)
local function MyTeam()
  if LP.Team then return LP.Team.Name end
  -- fallback по лицу
  local ch = LP.Character
  if ch and ch:FindFirstChild("Head") then
    for _,d in ipairs(ch.Head:GetChildren()) do
      if d:IsA("Decal") and string.find(tostring(d.Texture),"616395480") then return "Smiling" end
    end
  end
  return "Human"
end
local function IsEnemy(p)
  if p==LP then return false end
  if LP.Team and p.Team then return LP.Team ~= p.Team end
  -- fallback: смайлер = лицо 616395480
  local ch = p.Character
  local isSmile = false
  if ch and ch:FindFirstChild("Head") then
    for _,d in ipairs(ch.Head:GetChildren()) do
      if d:IsA("Decal") and string.find(tostring(d.Texture),"616395480") then isSmile=true end
    end
  end
  if MyTeam()=="Human" then return isSmile else return not isSmile end
end
local function MyTools()
  local out = {}
  local ch = LP.Character
  if ch then for _,t in ipairs(ch:GetChildren()) do if t:IsA("Tool") then table.insert(out,t) end end end
  local bp = LP:FindFirstChild("Backpack")
  if bp then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(out,t) end end end
  return out
end
local function BestTool()
  local best, bd = nil, -1
  for _,t in ipairs(MyTools()) do
    local dmg = t:FindFirstChild("Damage")
    local v = dmg and dmg.Value or 5
    if v > bd then bd=v best=t end
  end
  return best
end
local function EquipBest()
  pcall(function()
    local ch = LP.Character if not ch then return end
    if ch:FindFirstChildOfClass("Tool") then return end
    local b = BestTool()
    if b then ch:FindFirstChildOfClass("Humanoid"):EquipTool(b) end
  end)
end

