-- ── единая точка генерации ───────────────────────────────────────────────────
local function generateReply(opts)
	opts = opts or {}
	local provider, providerKey = getProvider()
	local mode = State.settings.mode or "calm"
	local answerLen = State.settings.answerLen or "short"

	local system = opts.system or buildSystemPrompt()
	local user = opts.user or buildUserPrompt(opts)

	local result = provider.generate({
		apiKey = State.keys[providerKey],
		model = opts.model or State.settings.model,
		system = system,
		user = user,
		temperature = MODE_TEMP[mode] or 0.7,
		maxTokens = ANSWER_TOKENS[answerLen] or 320,
		useSearch = opts.useSearch == true and State.settings.useGrounding ~= false,
	})

	if not result.ok then
		State.lastAiError = tostring(result.error or "неизвестная ошибка")
		return { ok = false, error = State.lastAiError }
	end

	local parts = splitReplyParts(result.text)
	if #parts == 0 then
		State.lastAiError = "модель вернула пустой текст"
		return { ok = false, error = State.lastAiError }
	end

	local joined = table.concat(parts, " ")
	State.lastAiText = joined
	State.lastAiError = ""
	return {
		ok = true,
		text = joined,
		parts = parts,
		messages = prepareMessages(joined),
		provider = providerKey,
		model = result.model or State.settings.model,
		sources = result.sources or 0,
	}
end

