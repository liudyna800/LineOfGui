--------------------------------------------------------------------------------
-- 1. EMOTE API (Воспроизведение кастомных ID / Каталога)
--------------------------------------------------------------------------------

local EmoteAPI = {}

function EmoteAPI.Stop()
    if CurrentTrack then
        CurrentTrack:Stop(0.15)
        CurrentTrack = nil
        TrackStartTime = 0
    end
end

local function GetAnimationId(assetId)
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)
    
    if success and objects and #objects > 0 then
        local item = objects[1]
        if item:IsA("Animation") and item.AnimationId ~= "" then
            return item.AnimationId
        end
        local animObj = item:FindFirstChildOfClass("Animation")
        if animObj and animObj.AnimationId ~= "" then
            return animObj.AnimationId
        end
    end
    return "rbxassetid://" .. tostring(assetId)
end

function EmoteAPI.Play(assetId)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid

    EmoteAPI.Stop()

    local realAnimId = GetAnimationId(assetId)
    local animObject = Instance.new("Animation")
    animObject.AnimationId = realAnimId

    local track = animator:LoadAnimation(animObject)
    track.Priority = Enum.AnimationPriority.Action4
    track:Play(0.1, 1, 1)
    
    CurrentTrack = track
    TrackStartTime = os.clock()
end

function EmoteAPI.SearchCatalog(query, logFunc)
    local itemsFound = {}
    query = tostring(query):lower():gsub("[%c%p]", "")

    if logFunc then logFunc("[Catalog Search] Отправка запроса по ключевику: '" .. query .. "'") end

    -- Прямой ввод ID
    local directId = tonumber(query)
    if directId then
        if logFunc then logFunc("[Catalog] Введен прямой Asset ID: " .. directId) end
        return {{Name = "Custom ID: " .. tostring(directId), Id = directId}}
    end

    -- Запрос к Roblox Catalog API
    if request then
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?category=11&subCategory=38&keyword=" .. HttpService:UrlEncode(query) .. "&limit=10"
            local response = request({Url = url, Method = "GET"})
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, {Name = item.name, Id = item.id})
                    end
                end
            end
        end)
    end

    if logFunc then logFunc("[Catalog] Найдено совпадений: " .. #itemsFound) end
    return itemsFound
end

