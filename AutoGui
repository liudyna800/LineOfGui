-- ESP по Team (Human/Smiling из скана)
local function ApplyESP(p)
  if p==LP then return end
  if not p.Character then return end
  pcall(function()
    local h=p.Character:FindFirstChild("S_ESP") if h then h:Destroy() end
  end)
  if not S.ESP then return end
  if not IsEnemy(p) and MyTeam()==(p.Team and p.Team.Name) then
    -- своих не подсвечиваем чтобы не лагало, только врагов
    -- убери return если хочешь всех
    return
  end
  local col = (p.Team and p.Team.Name=="Smiling") and Color3.fromRGB(255,0,0) or Color3.fromRGB(0,255,0)
  local hl=Instance.new("Highlight") hl.Name="S_ESP"
  hl.FillColor=col hl.OutlineColor=col hl.FillTransparency=0.6
  hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop hl.Parent=p.Character
end
task.spawn(function() while true do task.wait(2) for _,p in ipairs(Players:GetPlayers()) do pcall(ApplyESP,p) end end end)

-- Anti-Infect / Anti-Kill: CanTouch=false локально (тач идет с клиента, сервер не увидит касание)
task.spawn(function()
  while true do
    task.wait(2)
    if S.AntiInfect then
      pcall(function()
        for _,d in ipairs(WS:GetDescendants()) do
          local n=string.lower(d.Name)
          if (string.find(n,"infect") and d:IsA("BasePart")) then
            -- не трогаем Human-оружие, только части карты
            if not d:IsDescendantOf(LP.Character) then d.CanTouch=false end
          end
        end
      end)
    end
    if S.AntiKill then
      pcall(function()
        local kb = WS:FindFirstChild("Map")
        if kb then
          for _,d in ipairs(kb:GetDescendants()) do
            if d:IsA("BasePart") and (string.find(string.lower(d.Name),"kill") or d.Parent.Name=="KillBricks") then
              d.CanTouch=false
            end
          end
        end
      end)
    end
  end
end)

-- Speed / Fly
RS.Stepped:Connect(function()
  pcall(function()
    local ch=LP.Character
    if ch and ch:FindFirstChildOfClass("Humanoid") then
      local h=ch:FindFirstChildOfClass("Humanoid")
      if S.Speed then h.WalkSpeed=S.SpeedVal else if h.WalkSpeed~=16 then h.WalkSpeed=16 end end
    end
  end)
end)
local bv=nil
RS.Heartbeat:Connect(function()
  local ch=LP.Character if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
  local hrp=ch.HumanoidRootPart
  if S.Fly then
    if not bv then bv=Instance.new("BodyVelocity") bv.MaxForce=Vector3.new(9e4,9e4,9e4) bv.Velocity=Vector3.zero bv.Parent=hrp end
    bv.Velocity=ch:FindFirstChildOfClass("Humanoid").MoveDirection*50
    if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then bv.Velocity=bv.Velocity+Vector3.new(0,50,0) end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then bv.Velocity=bv.Velocity-Vector3.new(0,50,0) end
  else if bv then bv:Destroy() bv=nil end end
end)

