-- 6. ИИ-поиск (Gemini) — двухшаговая схема: перевод запроса → выбор из результатов
--------------------------------------------------------------------------------

-- Универсальный вызов Gemini generateContent. Возвращает (text, nil) при успехе
-- или (nil, причина) при ошибке — причина всегда конкретная, не просто "не сработало".
local function CallGemini(promptText, temperature)
    if not GeminiApiKey or GeminiApiKey == "" then
        return nil, "API ключ не задан (пустое поле)"
    end
    if type(request) ~= "function" then
        return nil, "Функция request/http_request недоступна в этом executor"
    end

    local body = HttpService:JSONEncode({
        contents = {
            {
                role = "user",
                parts = { { text = promptText } },
            },
        },
        generationConfig = {
            temperature = temperature or 0.2,
            maxOutputTokens = 20,
            thinkingConfig = {
                thinkingLevel = "low", -- полностью выключить нельзя для Flash/Flash-Lite, но можно снизить — иначе modelью "думает" по умолчанию на уровне medium, отсюда и долгий ответ
            },
        },
    })

    local ok, response = pcall(function()
        return request({
            Url = GEMINI_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["x-goog-api-key"] = GeminiApiKey,
            },
            Body = body,
        })
    end)

    if not ok then
        return nil, "HTTP-запрос упал с ошибкой: " .. tostring(response)
    end
    if not response then
        return nil, "Пустой response от request()"
    end
    if response.StatusCode and response.StatusCode ~= 200 then
        return nil, "HTTP статус " .. tostring(response.StatusCode) .. ": " .. tostring(response.Body):sub(1, 300)
    end
    if not response.Body then
        return nil, "В ответе нет поля Body"
    end

    local decodeOk, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)
    if not decodeOk then
        return nil, "Не удалось распарсить JSON ответа: " .. tostring(decoded)
    end

    local candidate = decoded and decoded.candidates and decoded.candidates[1]
    local text = candidate and candidate.content and candidate.content.parts and candidate.content.parts[1] and candidate.content.parts[1].text

    if not text then
        local blockReason = decoded and decoded.promptFeedback and decoded.promptFeedback.blockReason
        if blockReason then
            return nil, "Gemini заблокировал запрос: " .. tostring(blockReason)
        end
        return nil, "В ответе нет candidates[1].content.parts[1].text. Сырой ответ: " .. tostring(response.Body):sub(1, 300)
    end

    text = text:match("^%s*(.-)%s*$") or text
    return text
end

-- Шаг 1: переводим свободный текст игрока ("сядь") в короткий английский поисковый запрос ("sit")
local function AskGeminiForSearchQuery(userText)
    local prompt = "You are helping find a Roblox emote/animation by name. " ..
        "The player asked (in any language): \"" .. userText .. "\". " ..
        "Reply with ONLY one short English search keyword or phrase for this animation/pose " ..
        "(examples: \"sit\", \"dance\", \"wave\", \"robot\"). " ..
        "No punctuation, no quotes, no explanation — just the keyword."
    print("[EmoteAI] Шаг 1/2: спрашиваю Gemini перевод запроса для \"" .. userText .. "\"...")
    local result, err = CallGemini(prompt)
    if not result then
        warn("[EmoteAI] ОШИБКА на шаге перевода запроса: " .. tostring(err))
        return nil, err
    end
    print("[EmoteAI] Gemini предложил английский запрос: \"" .. result .. "\"")
    return result
end

-- Память о последнем выборе по каждому запросу (в нижнем регистре), чтобы
-- явно просить ИИ не повторять тот же вариант при одинаковом запросе подряд.
local LastChosenByQuery = {}

-- Перемешивание массива (Fisher-Yates) — чтобы порядок в списке не был всегда
-- одинаковым, иначе ИИ склонен стабильно выбирать "первый попавшийся".
local function ShuffleItems(items)
    local shuffled = {}
    for i, v in ipairs(items) do shuffled[i] = v end
    for i = #shuffled, 2, -1 do
        local j = math.random(1, i)
        shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
    end
    return shuffled
end

-- Шаг 2: даём Gemini список найденных результатов и просим выбрать номер лучшего совпадения
local function AskGeminiToPick(userText, items)
    if #items == 0 then
        return nil, "Список результатов пуст — нечего выбирать"
    end

    local shuffled = ShuffleItems(items)

    local lines = {}
    for i, it in ipairs(shuffled) do
        table.insert(lines, tostring(i) .. ". " .. tostring(it.Name) .. " (id:" .. tostring(it.Id) .. ")")
    end

    local queryKey = userText:lower():match("^%s*(.-)%s*$")
    local avoidLine = ""
    local lastId = LastChosenByQuery[queryKey]
    if lastId then
        avoidLine = "\nNote: last time for this same request you picked id:" .. tostring(lastId) ..
            " — if there is another reasonably good match in the list this time, prefer variety and pick a DIFFERENT one instead."
    end

    local prompt = "The player originally asked for an animation: \"" .. userText .. "\". " ..
        "Here is a numbered list of search results (order is randomized each time):\n" .. table.concat(lines, "\n") ..
        avoidLine ..
        "\nReply with ONLY the number of the single best matching result. Just the digit, nothing else."

    print("[EmoteAI] Шаг 2/2: прошу Gemini выбрать из " .. #shuffled .. " результатов (temperature=0.9 для разнообразия)...")
    local result, err = CallGemini(prompt, 0.9)
    if not result then
        warn("[EmoteAI] ОШИБКА на шаге выбора результата: " .. tostring(err))
        return nil, err
    end

    local num = tonumber(result:match("%d+"))
    if not num or not shuffled[num] then
        warn("[EmoteAI] ОШИБКА: Gemini вернул нераспознаваемый/невалидный номер: \"" .. result .. "\" (диапазон 1-" .. #shuffled .. ")")
        return nil, "невалидный номер: " .. tostring(result)
    end

    local chosen = shuffled[num]
    LastChosenByQuery[queryKey] = chosen.Id
    print("[EmoteAI] Gemini выбрал #" .. num .. ": " .. chosen.Name .. " (id:" .. chosen.Id .. ")")
    return chosen
end

-- Полный цикл: собираем результаты поиска БЕЗ побочных эффектов (не через SearchEmotes,
-- чтобы не зависеть от того, что она сразу проигрывает числовые ID и рисует кнопки).
local function CollectSearchResults(query)
    local itemsFound = {}

    local success, pages = pcall(function()
        local searchParams = CatalogSearchParams.new()
        searchParams.SearchKeyword = query or ""
        searchParams.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        return AvatarEditorService:SearchCatalog(searchParams)
    end)

    if success and pages then
        local pageOk, pageData = pcall(function() return pages:GetCurrentPage() end)
        if pageOk and pageData then
            for _, item in ipairs(pageData) do
                table.insert(itemsFound, { Name = item.Name, Id = item.Id })
            end
        end
    end

    if #itemsFound == 0 and type(request) == "function" then
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?category=11&subCategory=38&keyword=" .. HttpService:UrlEncode(query or "") .. "&limit=30"
            local response = request({ Url = url, Method = "GET" })
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, { Name = item.name, Id = item.id })
                    end
                end
            end
        end)
    end

    return itemsFound
end

-- Главная функция для UI: игрок пишет "сядь" → полный цикл → анимация проигрывается сама.
local function RunAISearch(userText)
    if not userText or userText:match("^%s*$") then
        warn("[EmoteAI] Пустой запрос — нечего искать.")
        return
    end

    local englishQuery, err1 = AskGeminiForSearchQuery(userText)
    if not englishQuery then
        StatusLabel.Text = "Ошибка перевода: " .. tostring(err1)
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
        return
    end
    StatusLabel.Text = "Ищу: \"" .. englishQuery .. "\"..."
    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 100)

    local items = CollectSearchResults(englishQuery)
    print("[EmoteAI] Найдено " .. #items .. " результатов каталога по запросу \"" .. englishQuery .. "\"")

    if #items == 0 then
        warn("[EmoteAI] По запросу \"" .. englishQuery .. "\" каталог ничего не вернул.")
        StatusLabel.Text = "Ничего не найдено по запросу \"" .. englishQuery .. "\""
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
        ClearScroll()
        for _, it in ipairs(items) do AddButton(it.Name, it.Id) end
        return
    end

    ClearScroll()
    for _, it in ipairs(items) do AddButton(it.Name, it.Id) end

    local chosen, err2 = AskGeminiToPick(userText, items)
    if not chosen then
        StatusLabel.Text = "ИИ не смог выбрать: " .. tostring(err2) .. " (выбери сам из списка)"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 150, 80)
        return
    end

    StatusLabel.Text = "Играю: " .. chosen.Name
    StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 120)
    PlayEmote(chosen.Id)
end

