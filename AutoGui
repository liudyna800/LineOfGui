local function MyTeam() return LocalPlayer.Team and LocalPlayer.Team.Name or "NoTeam" end
local function IsEnemy(p)
  if p==LocalPlayer then return false end
  if LocalPlayer.Team and p.Team then return LocalPlayer.Team ~= p.Team end
  return true
end
local function TeamColor(p)
  if p.Team and p.Team.Name=="Killers" then return Color3.fromRGB(255,30,30) end
  if p.Team and p.Team.Name=="Survivors" then return Color3.fromRGB(255,225,0) end
  return Color3.fromRGB(255,255,255)
end

--// ПОИСК DAMAGE РЕМОТОВ (для Kill All)
local DamageRemotes = {}
local AllRemotes = {}
local function ScanRemotes()
  DamageRemotes = {}
  AllRemotes = {}
  local keys = {"damage","hit","hurt","kill","shoot","fire","attack","melee","claw","slash","gun","ray","blast","take","deal","swing","knife","sword","punch"}
  for _,d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
      table.insert(AllRemotes, d)
      local ln = string.lower(d.Name)
      for _,k in ipairs(keys) do
        if string.find(ln, k) then table.insert(DamageRemotes, d) break end
      end
    end
  end
  print("[A51v3] Remotes: all="..#AllRemotes.." damage-like="..#DamageRemotes)
  for _,r in ipairs(DamageRemotes) do print("  DMG: "..r:GetFullName()) end
end
pcall(ScanRemotes)

-- пробует убить одного через все найденные ремоуты разными аргументами
local function TryKillPlayer(plr)
  if not plr.Character then return false end
  local char = plr.Character
  local hum = char:FindFirstChildOfClass("Humanoid")
  local hrp = char:FindFirstChild("HumanoidRootPart")
  local head = char:FindFirstChild("Head")
  if not hum or hum.Health<=0 then return false end
  local killed = false
  for _,rem in ipairs(DamageRemotes) do
    -- самые частые сигнатуры в Area51-подобных
    local tries = {
      function() rem:FireServer(char) end,
      function() rem:FireServer(hum) end,
      function() rem:FireServer(hum, 100) end,
      function() rem:FireServer(hum, 9999) end,
      function() rem:FireServer(char, 9999) end,
      function() rem:FireServer(head, 9999) end,
      function() rem:FireServer(plr) end,
      function() rem:FireServer(plr, 9999) end,
      function() rem:FireServer(hrp.Position, hum, 9999) end,
      function() rem:FireServer(hum, hum.MaxHealth) end,
    }
    for _,fn in ipairs(tries) do
      local ok = pcall(fn)
      if ok then
        task.wait()
        if hum.Health<=0 then killed=true break end
      end
    end
    if killed then break end
    -- RemoteFunction вариант
    if rem:IsA("RemoteFunction") then
      pcall(function() rem:InvokeServer(hum, 9999) end)
      pcall(function() rem:InvokeServer(char, 9999) end)
    end
  end
  return hum.Health<=0
end

local function KillAllOnce()
  local cnt=0
  for _,p in ipairs(Players:GetPlayers()) do
    if IsEnemy(p) and p.Character then
      local h = p.Character:FindFirstChildOfClass("Humanoid")
      if h and h.Health>0 then
        if TryKillPlayer(p) then cnt=cnt+1 end
      end
    end
  end
  return cnt
end

-- авто-экип лучшего тула
local function EquipBest()
  pcall(function()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local ch = LocalPlayer.Character
    if not bp or not ch then return end
    if ch:FindFirstChildOfClass("Tool") then return end
    local best=nil
    for _,t in ipairs(bp:GetChildren()) do
      if t:IsA("Tool") then best=t break end
    end
    if best then
      ch:FindFirstChildOfClass("Humanoid"):EquipTool(best)
    end
  end)
end

