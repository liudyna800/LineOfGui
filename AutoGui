		return State.settings.showSelf ~= false
	end
	if State.settings.showAll then return true end
	return entry.isTarget == true
end

local logRowCounter = 0

local function addLogRow(entry)
	logRowCounter = logRowCounter + 1
	local isSelf, isTarget = entry.isSelf == true, entry.isTarget == true

	local row = create("Frame", {
		Parent = logScroll,
		BackgroundColor3 = isTarget and Theme.panel2 or Theme.panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = logRowCounter,
		ClipsDescendants = false,
	})
	uicorner(row, 8)
	uistroke(row, isTarget and Theme.accent or Theme.stroke)
	uipadding(row, 5, 6, 5, 6)
	uilist(row, Enum.FillDirection.Vertical, 3)

	local head = create("Frame", {
		Parent = row, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1,
	})
	local nameColor = isSelf and Theme.accent or (isTarget and Theme.accent2 or Theme.dim)
	makeLabel(head, ("[%s] %s (@%s)"):format(entry.time or "--:--:--",
		entry.display or "?", entry.name or "?"), {
		size = 11, bold = true, color = nameColor,
		size2 = UDim2.new(1, -70, 1, 0), position = UDim2.new(0, 0, 0, 0),
	})

	makeButton(head, "↩", {
		size2 = UDim2.new(0, 30, 1, 0), position = UDim2.new(1, -62, 0, 0),
		textSize = 11, radius = 5, color = Theme.panel3,
		onClick = function()
			App.setReplyContext(entry)
			if entry.userId and entry.userId > 0 and not isSelf and not State.targets[entry.userId] then
				setTarget(entry.userId, true)
			end
			App.focusDraft()
			setStatus("выбрано сообщение для ответа", Theme.warn)
		end,
	})
	makeButton(head, "⚡", {
		size2 = UDim2.new(0, 30, 1, 0), position = UDim2.new(1, -30, 0, 0),
		textSize = 11, radius = 5, color = Theme.panel3,
		onClick = function()
			if App.generateForEntry then App.generateForEntry(entry, true) end
		end,
	})

	makeLabel(row, entry.text or "", {
		size = 12, color = Theme.text, wrapped = true,
		size2 = UDim2.new(1, 0, 0, 0), LayoutOrder = 2,
		-- автоматическая высота под перенос текста
	}).AutomaticSize = Enum.AutomaticSize.Y

	return row
end

local function scrollLogToBottom()
	task.defer(function()
		pcall(function()
			local canvasHeight = logScroll.AbsoluteCanvasSize.Y
			logScroll.CanvasPosition = Vector2.new(0, math.max(0, canvasHeight - logScroll.AbsoluteSize.Y + 8))
		end)
	end)
end

App.renderLog = function()
	for _, child in ipairs(logScroll:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	logRowCounter = 0
	for _, entry in ipairs(State.log) do
		if logEntryVisible(entry) then addLogRow(entry) end
	end
	scrollLogToBottom()
end

App.refreshChatHeader = function()
	local count = 0
	for _ in pairs(State.targets) do count = count + 1 end
	if count == 0 then
		chatHeaderLabel.Text = "лог: цель не выбрана • выбери игрока во вкладке «Цели»"
		chatHeaderLabel.TextColor3 = Theme.warn
	else
		chatHeaderLabel.Text = ("лог: цель %s"):format(targetNames())
		chatHeaderLabel.TextColor3 = Theme.accent2
	end
	if App.setFilterButtonLabel then App.setFilterButtonLabel() end
end

App.clearLogAndNotify = function()
	clearLog()
	App.setReplyContext(nil)
	setStatus("лог очищен", Theme.dim)
end

local function trimLogRows()
	local guiRows = {}
	for _, child in ipairs(logScroll:GetChildren()) do
		if child:IsA("GuiObject") then table.insert(guiRows, child) end
	end
	while #guiRows > 300 do
		local oldest = table.remove(guiRows, 1)
		if oldest then oldest:Destroy() end
	end
end

onChange("log", function(entry, reset)
	if reset then
		App.renderLog()
		return
	end
	if not entry or not logEntryVisible(entry) then return end
	addLogRow(entry)
	trimLogRows()
	scrollLogToBottom()
end)
