--------------------------------------------------------------------------------
-- 1. EMOTE API (Модуль управления и поиска)
--------------------------------------------------------------------------------

local EmoteAPI = {}

function EmoteAPI.Stop()
    if CurrentTrack then
        CurrentTrack:Stop(0.15)
        CurrentTrack = nil
        TrackStartTime = 0
    end
end

local function GetAnimationId(assetId)
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)
    
    if success and objects and #objects > 0 then
        local item = objects[1]
        if item:IsA("Animation") and item.AnimationId ~= "" then
            return item.AnimationId
        end
        local animObj = item:FindFirstChildOfClass("Animation")
        if animObj and animObj.AnimationId ~= "" then
            return animObj.AnimationId
        end
    end
    return "rbxassetid://" .. tostring(assetId)
end

function EmoteAPI.Play(assetId)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid

    EmoteAPI.Stop()

    local realAnimId = GetAnimationId(assetId)
    local animObject = Instance.new("Animation")
    animObject.AnimationId = realAnimId

    local track = animator:LoadAnimation(animObject)
    track.Priority = Enum.AnimationPriority.Action4
    track:Play(0.1, 1, 1)
    
    CurrentTrack = track
    TrackStartTime = os.clock()
end

function EmoteAPI.Search(query)
    local itemsFound = {}
    
    -- Проверка на чистый ID
    local directId = tonumber(query)
    if directId then
        return {{Name = "ID: " .. tostring(directId), Id = directId}}
    end

    -- Метод 1: AvatarEditorService
    local success, pages = pcall(function()
        local searchParams = CatalogSearchParams.new()
        searchParams.SearchKeyword = query or ""
        searchParams.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        return AvatarEditorService:SearchCatalog(searchParams)
    end)

    if success and pages then
        local pageData = pcall(function() return pages:GetCurrentPage() end) and pages:GetCurrentPage() or {}
        for _, item in ipairs(pageData) do
            table.insert(itemsFound, {Name = item.Name, Id = item.Id})
        end
    end

    -- Метод 2: Direct Catalog Request
    if #itemsFound == 0 and request then
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?category=11&subCategory=38&keyword=" .. HttpService:UrlEncode(query or "") .. "&limit=10"
            local response = request({Url = url, Method = "GET"})
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, {Name = item.name, Id = item.id})
                    end
                end
            end
        end)
    end

    return itemsFound
end

--------------------------------------------------------------------------------
-- 2. GEMINI AI API (3 попытки поиска)
--------------------------------------------------------------------------------

local GeminiAPI = {}

local function CallGemini(userPrompt, attempt)
    if not request then return nil end
    
    local systemInstruction = "Ты помощник для поиска эмоций в Roblox Catalog. Пользователь пишет запрос на русском. " ..
        "Твоя задача — вернуть РОВНО 1 английское слово или ключевую фразу для поиска эмоции в каталоге. " ..
        "Попытка №" .. tostring(attempt) .. ". Если прошлые слова не нашли результат, дай другой альтернативный синоним на английском. " ..
        "Отвечай ТОЛЬКО поисковым словом, без лишнего текста и знаков препинания."

    local url = "https://generativelanguage.googleapis.com/v1beta/models/" .. GEMINI_MODEL .. ":generateContent?key=" .. GEMINI_KEY
    local body = {
        contents = {
            {
                role = "user",
                parts = {{ text = systemInstruction .. "\nЗапрос пользователя: " .. userPrompt }}
            }
        }
    }

    local success, response = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(body)
        })
    end)

    if success and response and response.Body then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.candidates and data.candidates[1] and data.candidates[1].content then
            local text = data.candidates[1].content.parts[1].text
            return text:gsub("%s+", ""):lower()
        end
    end
    return nil
end

function GeminiAPI.ProcessSmartEmote(russianPrompt, statusCallback)
    task.spawn(function()
        for attempt = 1, 3 do
            if statusCallback then statusCallback("ИИ ищет ключ (Попытка " .. attempt .. "/3)...") end
            
            local englishKeyword = CallGemini(russianPrompt, attempt)
            
            if englishKeyword and englishKeyword ~= "" then
                if statusCallback then statusCallback("Поиск в каталоге: " .. englishKeyword) end
                
                local results = EmoteAPI.Search(englishKeyword)
                if #results > 0 then
                    if statusCallback then statusCallback("Найдено! Запуск: " .. results[1].Name) end
                    EmoteAPI.Play(results[1].Id)
                    return true
                end
            end
            task.wait(0.5)
        end

        if statusCallback then statusCallback("Ошибка: Ничего не найдено за 3 попытки.") end
        return false
    end)
end

--------------------------------------------------------------------------------
-- 3. Авто-стоп по таймеру и движению
--------------------------------------------------------------------------------

RunService.RenderStepped:Connect(function()
    if not CurrentTrack or not CurrentTrack.IsPlaying then return end
    
    if (os.clock() - TrackStartTime) >= MAX_EMOTE_DURATION then
        EmoteAPI.Stop()
        return
    end

    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local isMoving = humanoid.MoveDirection.Magnitude > 0.05
    local state = humanoid:GetState()
    local isJumpingOrFalling = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)

    if isMoving or isJumpingOrFalling then
        EmoteAPI.Stop()
    end
end)

