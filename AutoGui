local function makeToggle(parent, labelText, initial, callback, opts)
	opts = opts or {}
	local row = create("TextButton", {
		Parent = parent,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.panel,
		BorderSizePixel = 0,
		Size = opts.size2 or UDim2.new(1, 0, 0, opts.height or 30),
		LayoutOrder = opts.order or 0,
	})
	uicorner(row, 7)
	uistroke(row, Theme.stroke)
	makeLabel(row, labelText, {
		size = opts.textSize or 12,
		size2 = UDim2.new(1, -70, 1, 0),
		position = UDim2.new(0, 10, 0, 0),
		color = Theme.text,
	})
	local knobBg = create("Frame", {
		Parent = row,
		BackgroundColor3 = Theme.panel3,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 40, 0, 18),
		Position = UDim2.new(1, -50, 0.5, -9),
	})
	uicorner(knobBg, 9)
	local knob = create("Frame", {
		Parent = knobBg,
		BackgroundColor3 = Theme.dim,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(0, 2, 0.5, -7),
	})
	uicorner(knob, 7)

	local enabled = initial == true
	local function render()
		TweenService:Create(knobBg, TweenInfo.new(0.15), {
			BackgroundColor3 = enabled and Theme.accent or Theme.panel3,
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.15), {
			Position = enabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
			BackgroundColor3 = enabled and Theme.text or Theme.dim,
		}):Play()
	end
	render()
	local function get()
		return enabled
	end
	local function set(value)
		enabled = value == true
		render()
	end
	App.toggleSetters = App.toggleSetters or {}
	App.toggleSetters[labelText] = set
	row.MouseButton1Click:Connect(function()
		enabled = not enabled
		render()
		if callback then
			local ok, err = pcall(callback, enabled)
			if not ok then logInfo("ошибка переключателя:", tostring(err)) end
		end
	end)
	return row, get, set
end

local function makeSegmented(parent, optionsList, initialKey, callback, opts)
	opts = opts or {}
	local row = create("Frame", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = opts.size2 or UDim2.new(1, 0, 0, opts.height or 28),
		LayoutOrder = opts.order or 0,
	})
	uilist(row, Enum.FillDirection.Horizontal, 6)
	local buttons, current = {}, initialKey

	local function render()
		for key, button in pairs(buttons) do
			button.BackgroundColor3 = (key == current) and Theme.accent or Theme.panel2
		end
	end

	for _, option in ipairs(optionsList) do
		local button = makeButton(row, option.text, {
			size2 = UDim2.new(1 / #optionsList, -4, 1, 0),
			textSize = opts.textSize or 12,
			radius = 7,
			noHover = true,
			onClick = function()
				current = option.key
				render()
				if callback then callback(option.key, option.text) end
			end,
		})
		buttons[option.key] = button
	end
	render()
	local function get()
		return current
	end
	local function set(key)
		if buttons[key] then
			current = key
			render()
		end
	end
	return row, get, set
end

