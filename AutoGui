-- 2. GEMINI AI API (С расширенной диагностикой)
--------------------------------------------------------------------------------

local GeminiAPI = {}

local function CallGemini(userPrompt, attempt, logFunc)
    if not request then 
        if logFunc then logFunc("[Gemini Error] Функция 'request' недоступна в твоем инжекторе.") end
        return nil 
    end

    local promptsHistory = {
        [1] = "Дай 1 самое популярное английское слово для поиска этой эмоции в Roblox Catalog.",
        [2] = "Прошлый вариант не дал результатов. Напиши 1 базовый синоним на английском.",
        [3] = "Напиши 1 общее широкое слово категории на английском (например: sit, dance, pose, move, idle)."
    }

    local systemInstruction = "Ты - переводчик команд анимаций для Roblox. Пользователь пишет запрос на русском. " ..
        promptsHistory[attempt] .. " Отвечай ТОЛЬКО одним словом без знаков препинания и кавычек."

    if logFunc then logFunc("[Gemini AI] Отправка HTTP-запроса в Google Gemini (Попытка " .. attempt .. "/3)...") end

    local url = "https://generativelanguage.googleapis.com/v1beta/models/" .. GEMINI_MODEL .. ":generateContent?key=" .. GEMINI_KEY
    local body = {
        contents = {
            {
                role = "user",
                parts = {{ text = systemInstruction .. "\nЗапрос: " .. userPrompt }}
            }
        }
    }

    local success, response = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(body)
        })
    end)

    if success and response and response.Body then
        local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if decodeSuccess and data and data.candidates and data.candidates[1] and data.candidates[1].content then
            local text = data.candidates[1].content.parts[1].text
            local cleanWord = text:gsub("%s+", ""):gsub("[%p]", ""):lower()
            if logFunc then logFunc("[Gemini AI] Ответ от Gemini: '" .. cleanWord .. "'") end
            return cleanWord
        else
            if logFunc then logFunc("[Gemini Error] Ошибка структуры JSON от Gemini: " .. tostring(response.Body):sub(1, 100)) end
        end
    else
        if logFunc then logFunc("[Gemini Error] Сбой отправки HTTP-запроса.") end
    end

    return nil
end

function GeminiAPI.ProcessSmartEmote(russianPrompt, logFunc)
    task.spawn(function()
        if logFunc then logFunc("--- СТАРТ ОБРАБОТКИ ЗАПРОСА: '" .. russianPrompt .. "' ---") end
        
        -- Попытка через Gemini
        for attempt = 1, 3 do
            local englishKeyword = CallGemini(russianPrompt, attempt, logFunc)
            
            if englishKeyword and englishKeyword ~= "" then
                local results = EmoteAPI.Search(englishKeyword, logFunc)
                if #results > 0 then
                    if logFunc then logFunc("[SUCCESS] Анимация найдена! Запуск: " .. results[1].Name .. " (ID: " .. results[1].Id .. ")") end
                    EmoteAPI.Play(results[1].Id)
                    return
                else
                    if logFunc then logFunc("[FAIL] По слову '" .. englishKeyword .. "' ничего не найдено в каталоге.") end
                end
            end
            task.wait(0.3)
        end

        -- Резервный поиск через локальный словарь
        if logFunc then logFunc("[Fallback System] ИИ не справился. Проверка локального словаря...") end
        local lowerInput = russianPrompt:lower()
        for ru, en in pairs(FallbackDictionary) do
            if lowerInput:find(ru) then
                if logFunc then logFunc("[Fallback System] Совпадение найдено: '" .. ru .. "' -> '" .. en .. "'") end
                local results = EmoteAPI.Search(en, logFunc)
                if #results > 0 then
                    if logFunc then logFunc("[SUCCESS] Запуск резервной анимации: " .. results[1].Name) end
                    EmoteAPI.Play(results[1].Id)
                    return
                end
            end
        end

        if logFunc then logFunc("[FATAL] 3 попытки ИИ и локальный словарь исчерпаны. Ничего не найдено.") end
    end)
end

--------------------------------------------------------------------------------
-- 3. Авто-стоп
--------------------------------------------------------------------------------

RunService.RenderStepped:Connect(function()
    if not CurrentTrack or not CurrentTrack.IsPlaying then return end
    
    if (os.clock() - TrackStartTime) >= MAX_EMOTE_DURATION then
        EmoteAPI.Stop()
        return
    end

    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local isMoving = humanoid.MoveDirection.Magnitude > 0.05
    local state = humanoid:GetState()
    local isJumpingOrFalling = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)

    if isMoving or isJumpingOrFalling then
        EmoteAPI.Stop()
    end
end)

