local function ClearScroll()
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function AddButton(name, id)
    local ItemBtn = Instance.new("TextButton")
    ItemBtn.Size = UDim2.new(1, 0, 0, 36)
    ItemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    ItemBtn.Text = "   " .. name
    ItemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
    ItemBtn.Font = Enum.Font.Gotham
    ItemBtn.TextSize = 12
    ItemBtn.Parent = ScrollFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = ItemBtn

    ItemBtn.MouseButton1Click:Connect(function()
        PlayEmote(id)
    end)
end

local function SearchEmotes(query)
    ClearScroll()
    
    local directId = tonumber(query)
    if directId then
        AddButton("Запустить ID: " .. tostring(directId), directId)
        PlayEmote(directId)
        return
    end

    local itemsFound = {}

    local success, pages = pcall(function()
        local searchParams = CatalogSearchParams.new()
        searchParams.SearchKeyword = query or ""
        searchParams.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        return AvatarEditorService:SearchCatalog(searchParams)
    end)

    if success and pages then
        local pageData = pcall(function() return pages:GetCurrentPage() end) and pages:GetCurrentPage() or {}
        for _, item in ipairs(pageData) do
            table.insert(itemsFound, {Name = item.Name, Id = item.Id})
        end
    end

    if #itemsFound == 0 and request then
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items?category=11&subCategory=38&keyword=" .. HttpService:UrlEncode(query or "") .. "&limit=30"
            local response = request({Url = url, Method = "GET"})
            if response and response.Body then
                local data = HttpService:JSONDecode(response.Body)
                if data and data.data then
                    for _, item in ipairs(data.data) do
                        table.insert(itemsFound, {Name = item.name, Id = item.id})
                    end
                end
            end
        end)
    end

    if #itemsFound > 0 then
        for _, item in ipairs(itemsFound) do
            AddButton(item.Name, item.Id)
        end
    else
        local ErrLabel = Instance.new("TextLabel")
        ErrLabel.Size = UDim2.new(1, 0, 0, 40)
        ErrLabel.BackgroundTransparency = 1
        ErrLabel.Text = "Ничего не найдено / Блокировка API"
        ErrLabel.TextColor3 = Color3.fromRGB(200, 80, 80)
        ErrLabel.Font = Enum.Font.Gotham
        ErrLabel.TextSize = 12
        ErrLabel.Parent = ScrollFrame
    end
end

SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SearchEmotes(SearchBox.Text)
    end
end)

SearchEmotes("")
