local function buildSystemPrompt()
	local mode = State.settings.mode or "calm"
	local limit = math.max(40, State.settings.maxChars or 200)
	local parts = math.max(1, State.settings.maxParts or 2)
	local prompt = BASE_PROMPT
	prompt = prompt:gsub("%%MYNAME%%", LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")")
	prompt = prompt:gsub("%%LIMIT%%", tostring(limit))
	prompt = prompt:gsub("%%PARTS%%", tostring(parts))
	prompt = prompt:gsub("%%MODE%%", MODE_PROMPTS[mode] or MODE_PROMPTS.calm)
	return prompt
end

local function buildUserPrompt(opts)
	opts = opts or {}
