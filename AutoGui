local function MyTeam() return LocalPlayer.Team and LocalPlayer.Team.Name or "NoTeam" end
local function IsEnemy(p)
  if p==LocalPlayer then return false end
  if LocalPlayer.Team and p.Team then return LocalPlayer.Team ~= p.Team end
  return true
end
local function TeamColor(p)
  if p.Team and p.Team.Name=="Killers" then return Color3.fromRGB(255,30,30) end
  return Color3.fromRGB(255,225,0)
end

