-- 2. GEMINI AI ENGINE (Модуль ИИ для анализа кастомных запросов)
--------------------------------------------------------------------------------

local GeminiAPI = {}

function GeminiAPI.SendRequest(userPrompt, attempt, logFunc)
    if not request then
        if logFunc then logFunc("[Gemini Error] Инжектор не поддерживает функцию 'request'.") end
        return nil
    end

    -- Настройка инструкций для разных попыток поиска
    local attemptPrompts = {
        [1] = "Выдели 1 ключевое английское слово для поиска анимации в каталоге Roblox.",
        [2] = "Прошлый вариант не дал результатов. Дай 1 простой английский синоним или базовое слово действия.",
        [3] = "Дай 1 максимально общее английское слово категории (например: sit, dance, wave, pose, run, idle)."
    }

    local systemInstruction = "Ты модуль ИИ для игрового движка. Пользователь пишет запрос на русском языке. " ..
        attemptPrompts[attempt] .. " Выдавай В ОТВЕТЕ ТОЛЬКО ОДНО СЛОВО на английском, без знаков препинания, кавычек и форматирования."

    if logFunc then logFunc("[Gemini AI] Попытка " .. attempt .. "/3: Отправка HTTP POST...") end

    local url = "https://generativelanguage.googleapis.com/v1beta/models/" .. GEMINI_MODEL .. ":generateContent?key=" .. GEMINI_KEY
    local body = {
        contents = {
            {
                role = "user",
                parts = {{ text = systemInstruction .. "\nКоманда пользователя: " .. userPrompt }}
            }
        }
    }

    local success, response = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(body)
        })
    end)

    if success and response then
        if response.StatusCode == 200 then
            local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if decodeSuccess and data and data.candidates and data.candidates[1] then
                local rawText = data.candidates[1].content.parts[1].text
                local cleanWord = rawText:gsub("%s+", ""):gsub("[%p]", ""):lower()
                if logFunc then logFunc("[Gemini AI] ИИ вернул ключевик: '" .. cleanWord .. "'") end
                return cleanWord
            end
        else
            if logFunc then 
                logFunc("[Gemini HTTP Error] Код ошибки: " .. tostring(response.StatusCode))
                logFunc("[Gemini Response] " .. tostring(response.Body):sub(1, 150))
            end
        end
    else
        if logFunc then logFunc("[Gemini Error] Ошибка отправки запроса сетью.") end
    end

    return nil
end

function GeminiAPI.ProcessEmoteQuery(russianQuery, logFunc)
    task.spawn(function()
        if logFunc then logFunc("=== СТАРТ ИИ ОБРАБОТКИ: '" .. russianQuery .. "' ===") end

        for attempt = 1, 3 do
            local keyword = GeminiAPI.SendRequest(russianQuery, attempt, logFunc)
            
            if keyword and keyword ~= "" then
                local results = EmoteAPI.SearchCatalog(keyword, logFunc)
                if #results > 0 then
                    local target = results[1]
                    if logFunc then logFunc("[SUCCESS] ИИ успешно выбрал эмоцию: " .. target.Name .. " (ID: " .. target.Id .. ")") end
                    EmoteAPI.Play(target.Id)
                    return
                else
                    if logFunc then logFunc("[FAIL] По слову '" .. keyword .. "' ничего не найдено в каталоге. Переход к следующей попытке.") end
                end
            end
            task.wait(0.4)
        end

        if logFunc then logFunc("[FATAL] ИИ потратил все 3 попытки и не смог подобрать рабочий ключ.") end
    end)
end

--------------------------------------------------------------------------------
-- 3. Авто-стоп (Сброс при движении и по 40-сек таймеру)
--------------------------------------------------------------------------------

RunService.RenderStepped:Connect(function()
    if not CurrentTrack or not CurrentTrack.IsPlaying then return end
    
    if (os.clock() - TrackStartTime) >= MAX_EMOTE_DURATION then
        EmoteAPI.Stop()
        return
    end

    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local isMoving = humanoid.MoveDirection.Magnitude > 0.05
    local state = humanoid:GetState()
    local isJumpingOrFalling = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)

    if isMoving or isJumpingOrFalling then
        EmoteAPI.Stop()
    end
end)

