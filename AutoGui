	local parts = math.max(1, State.settings.maxParts or 2)
	local blocks = {}

	table.insert(blocks, "КОНТЕКСТ ЧАТА (последние сообщения, формат «ник: текст»):\n"
		.. (opts.context or "нет данных"))
	if opts.targetName then
		table.insert(blocks, ("ЦЕЛЬ ОТВЕТА: %s (@%s)"):format(
			opts.targetDisplay or opts.targetName, opts.targetName))
	end
	if opts.theirMessage and trim(opts.theirMessage) ~= "" then
		table.insert(blocks, "ЕГО ПОСЛЕДНЯЯ РЕПЛИКА (отвечай именно на неё):\n" .. trim(opts.theirMessage))
	end
	if opts.draft and trim(opts.draft) ~= "" then
		table.insert(blocks, "МОЙ ЧЕРНОВИК — перепиши своими словами, сохрани смысл, "
			.. "но сделай аргументированнее, короче и увереннее:\n" .. trim(opts.draft))
	else
		table.insert(blocks, "ЧЕРНОВИКА НЕТ: сформулируй ответ сам.")
	end
	if opts.research and opts.research ~= "" then
		table.insert(blocks, opts.research)
	end
	if opts.extra and opts.extra ~= "" then
		table.insert(blocks, opts.extra)
	end
	table.insert(blocks, ("ФОРМАТ ОТВЕТА: только текст для чата. Лимит %d символов на сообщение, частей не больше %d.")
		:format(limit, parts))
	return table.concat(blocks, "\n\n")
end

local function sanitizeReply(text)
	if type(text) ~= "string" then return "" end
	local clean = text
	clean = clean:gsub("```[%w]*", ""):gsub("```", "")
	-- ВАЖНО: Lua-паттерны работают побайтово, поэтому кириллицу в классах
	-- вида [Оо] использовать нельзя — она превращается в набор байтов.
	-- Пишем варианты написания явными строками.
	clean = clean:gsub("^%s*Ответ%s*[:%-]%s*", "")
	clean = clean:gsub("^%s*ответ%s*[:%-]%s*", "")
	clean = clean:gsub("^%s*ИИ%s*[:%-]%s*", "")
	clean = clean:gsub("^%s*ии%s*[:%-]%s*", "")
	clean = clean:gsub("^%s*Бот%s*[:%-]%s*", "")
	clean = clean:gsub("^%s*бот%s*[:%-]%s*", "")
	clean = clean:gsub("^%s*Вариант%s*%d+%s*[:%-.%)]%s*", "")
	clean = clean:gsub("^%s*%d+[%)%.]%s*", "")
	clean = clean:gsub("^\"(.-)\"$", "%1")
	clean = clean:gsub("^«(.-)»$", "%1")
	clean = clean:gsub("%*%*", ""):gsub("__", "")
	clean = clean:gsub("[\r\t]", " ")
	clean = clean:gsub(" +", " ")
	clean = clean:gsub(" *\n *", " ")
	return trim(clean)
end

local function splitReplyParts(text)
	local pieces = splitBySeparator(text, "///")
	local cleaned = {}
	for _, piece in ipairs(pieces) do
		local value = sanitizeReply(piece)
		if value ~= "" then table.insert(cleaned, value) end
	end
	if #cleaned == 0 then
		local fallback = sanitizeReply(text)
		if fallback ~= "" then table.insert(cleaned, fallback) end
	end
	return cleaned
end
