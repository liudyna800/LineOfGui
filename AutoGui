local function httpRequest(opts)
	opts = opts or {}
	local url     = opts.url
	local method  = string.upper(opts.method or "GET")
	local headers = opts.headers or {}
	local body    = opts.body

	if not url then return { ok = false, error = "URL не задан" } end

	if HTTP_FN then
		local ok, res = pcall(HTTP_FN, {
			Url = url, Method = method, Headers = headers, Body = body,
		})
		if ok and type(res) == "table" then
			return {
				ok = true,
				status = tonumber(res.StatusCode or res.Status or res.status) or 200,
				body = res.Body or res.body or "",
			}
		end
		if not ok then
			logInfo("HTTP-функция упала:", tostring(res))
		end
	end

	if method == "GET" then
		local ok, res = pcall(function() return game:HttpGet(url, true) end)
		if ok and type(res) == "string" and #res > 0 then
			return { ok = true, status = 200, body = res }
		end
	end

	local ok, res = pcall(function()
		return HttpService:RequestAsync({ Url = url, Method = method, Headers = headers, Body = body })
	end)
	if ok and type(res) == "table" then
		return { ok = res.Success == true, status = res.StatusCode or 0, body = res.Body or "" }
	end

	return { ok = false, error = "Нет рабочей HTTP-функции (нужен экзекьютор с request())" }
end

local function jsonEncode(tbl)
	local ok, res = pcall(function() return HttpService:JSONEncode(tbl) end)
	if ok then return res end
	return nil
end

local function jsonDecode(str)
	if type(str) ~= "string" or str == "" then return nil end
	local ok, res = pcall(function() return HttpService:JSONDecode(str) end)
	if ok then return res end
	return nil
end

local function trim(str)
	return (tostring(str):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function urlEncode(str)
	return (tostring(str):gsub("[^%w%-%._~]", function(ch)
		return string.format("%%%02X", string.byte(ch))
	end))
end

local function stripTags(str)
	return (tostring(str):gsub("<[^>]*>", " "))
end

local HTML_ENTITIES = {
	["&amp;"] = "&", ["&quot;"] = "\"", ["&#39;"] = "'", ["&apos;"] = "'",
	["&lt;"] = "<", ["&gt;"] = ">", ["&nbsp;"] = " ", ["&mdash;"] = "-",
	["&ndash;"] = "-", ["&laquo;"] = "\"", ["&raquo;"] = "\"", ["&hellip;"] = "...",
}

local function htmlDecode(str)
	local text = tostring(str):gsub("&#(%d+);", function(num)
		local code = tonumber(num)
		if code and code > 0 and code < 1114112 then
			local ok, ch = pcall(utf8.char, code)
			if ok then return ch end
		end
		return "?"
	end)
	text = text:gsub("&#[xX](%x+);", function(hex)
		local code = tonumber(hex, 16)
		if code and code > 0 and code < 1114112 then
			local ok, ch = pcall(utf8.char, code)
			if ok then return ch end
		end
		return "?"
	end)
	for entity, char in pairs(HTML_ENTITIES) do
		text = text:gsub(entity, char)
	end
	return text
end

local function urlDecode(str)
	local text = tostring(str):gsub("+", " ")
	return (text:gsub("%%(%x%x)", function(hex)
		return string.char(tonumber(hex, 16))
	end))
end

local function clampNumber(value, minimum, maximum, fallback)
	local num = tonumber(value)
	if not num then return fallback end
	if num < minimum then return minimum end
	if num > maximum then return maximum end
	return num
end

local function splitBySeparator(text, separator)
	local parts, lastIndex = {}, 1
	while true do
		local startIndex, endIndex = text:find(separator, lastIndex, true)
		if not startIndex then break end
		table.insert(parts, text:sub(lastIndex, startIndex - 1))
		lastIndex = endIndex + 1
	end
	table.insert(parts, text:sub(lastIndex))
	return parts
end

local function containsAny(text, list)
	local lowered = string.lower(text)
	for _, needle in ipairs(list) do
		if string.find(lowered, needle, 1, true) then return true end
	end
	return false
end

