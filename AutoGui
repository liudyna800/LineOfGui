local function create(className, props, children)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				local ok, err = pcall(function() inst[key] = value end)
				if not ok then logInfo("UI: " .. tostring(key) .. " -> " .. tostring(err)) end
			end
		end
	end
	if children then
		for _, child in ipairs(children) do child.Parent = inst end
	end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

local function uicorner(inst, radius)
	return create("UICorner", { Parent = inst, CornerRadius = UDim.new(0, radius or 8) })
end

local function uistroke(inst, color, thickness)
	return create("UIStroke", {
		Parent = inst, Color = color or Theme.stroke,
		Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function uipadding(inst, top, right, bottom, left)
	return create("UIPadding", {
		Parent = inst,
		PaddingTop = UDim.new(0, top or 0), PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0), PaddingLeft = UDim.new(0, left or 0),
	})
end

local function uilist(inst, direction, padding, align)
	return create("UIListLayout", {
		Parent = inst,
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})
end

local function makeLabel(parent, text, opts)
	opts = opts or {}
	return create("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		Text = tostring(text or ""),
		TextColor3 = opts.color or Theme.text,
		TextSize = opts.size or 13,
		Font = opts.bold and Theme.fontBold or Theme.font,
		TextXAlignment = opts.align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = opts.wrapped == true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = opts.size2 or UDim2.new(1, 0, 0, opts.height or 18),
		Position = opts.position or UDim2.new(0, 0, 0, 0),
		LayoutOrder = opts.order or 0,
		ClipsDescendants = true,
	})
end

local function makeButton(parent, text, opts)
	opts = opts or {}
	local baseColor = opts.color or Theme.panel2
	local hoverColor = opts.hover or Theme.panel3
	local button = create("TextButton", {
		Parent = parent,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = baseColor,
		BorderSizePixel = 0,
		Size = opts.size2 or UDim2.new(1, opts.width or 0, 0, opts.height or 28),
		Position = opts.position or UDim2.new(0, 0, 0, 0),
		LayoutOrder = opts.order or 0,
		ClipsDescendants = true,
	})
	uicorner(button, opts.radius or 7)
	uistroke(button, opts.strokeColor or Theme.stroke)
	makeLabel(button, text, {
		size = opts.textSize or 12,
		bold = opts.bold ~= false,
		color = opts.textColor or Theme.text,
		align = Enum.TextXAlignment.Center,
		size2 = UDim2.new(1, -8, 1, 0),
		position = UDim2.new(0, 4, 0, 0),
	})
	button.MouseEnter:Connect(function()
		if opts.noHover then return end
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor }):Play()
	end)
	button.MouseLeave:Connect(function()
		if opts.noHover then return end
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = baseColor }):Play()
	end)
	if opts.onClick then
		button.MouseButton1Click:Connect(function()
			local ok, err = pcall(opts.onClick)
			if not ok then logInfo("ошибка кнопки:", tostring(err)) end
		end)
	end
	return button
end
