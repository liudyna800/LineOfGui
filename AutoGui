local cachedChannel = nil

local function getTextChannel()
	if cachedChannel and cachedChannel.Parent then return cachedChannel end
	local channels = TextChatService:FindFirstChild("TextChannels")
	if channels then
		cachedChannel = channels:FindFirstChild("RBXGeneral")
			or channels:FindFirstChildWhichIsA("TextChannel", true)
	end
	return cachedChannel
end

local function echoOwnMessage(text)
	if State.settings.showSelf == false then return end
	pushLog({
		name = LocalPlayer.Name,
		display = LocalPlayer.DisplayName,
		userId = LocalPlayer.UserId,
		text = text,
		isSelf = true,
		time = os.date("%H:%M:%S"),
	})
end

local function sendChatMessage(text)
	local clean = trim(text)
	if clean == "" then return false, "пустой текст" end

	local channel = getTextChannel()
	if channel then
		local ok = pcall(function() channel:SendAsync(clean) end)
		if ok then
			echoOwnMessage(clean)
			return true
		end
	end

	local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
	local sayRequest = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
	if sayRequest then
		local ok = pcall(function() sayRequest:FireServer(clean, "All") end)
		if ok then
			echoOwnMessage(clean)
			return true
		end
	end

	local remote = ReplicatedStorage:FindFirstChild("SayMessageRequest")
	if remote and remote:IsA("RemoteEvent") then
		local ok = pcall(function() remote:FireServer(clean, "All") end)
		if ok then
			echoOwnMessage(clean)
			return true
		end
	end

	return false, "чат недоступен (нет TextChannel/SayMessageRequest)"
end

local function sendChatText(text, delayBetween)
	local messages = prepareMessages(text)
	local sent = 0
	for index, message in ipairs(messages) do
		local ok, err = sendChatMessage(message)
		if not ok then return false, tostring(err) end
		sent = sent + 1
		if index < #messages then task.wait(delayBetween or 0.9) end
	end
	return true, sent
end

App.sendChatMessage = sendChatMessage
App.sendChatText = sendChatText
