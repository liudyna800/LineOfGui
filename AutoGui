--// Helpers
local function Notify(title, content, dur)
    Rayfield:Notify({
        Title = title,
        Content = content,
        Duration = dur or 3,
        Image = 4483362458,
    })
end

local function MyChar()
    return plr.Character
end

local function MyHRP()
    local c = MyChar()
    if c then return c:FindFirstChild("HumanoidRootPart") end
    return nil
end

local function MyHum()
    local c = MyChar()
    if c then return c:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function GetTools()
    local t = {}
    pcall(function()
        if MyChar() then
            for _, v in pairs(MyChar():GetChildren()) do
                if v:IsA("Tool") then table.insert(t, v) end
            end
        end
        for _, v in pairs(plr.Backpack:GetChildren()) do
            if v:IsA("Tool") then table.insert(t, v) end
        end
    end)
    return t
end

local function GetMainWeaponName()
    local ok, val = pcall(function()
        return plr:WaitForChild("Marketplace", 2)["Main Weapon"].Equipped.Value
    end)
    if ok and val and val ~= "Default" and val ~= "" then
        return val
    end
    return "Bat"
end

