-- ── Конфиг на диске (если у экзекьютора есть writefile) ──────────────────────
local CONFIG_DIR  = APP_NAME .. "_ArgumentEdition"
local CONFIG_FILE = CONFIG_DIR .. "/config.json"

local function hasFileApi()
	return type(writefile) == "function" and type(readfile) == "function"
end

local function saveConfig()
	if not hasFileApi() then return false, "нет writefile/readfile" end
	if type(makefolder) == "function" and type(isfolder) == "function" then
		pcall(function()
			if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
		end)
	end
	local payload = { settings = State.settings, keys = State.keys, targets = {} }
	for userId in pairs(State.targets) do table.insert(payload.targets, userId) end
	local encoded = jsonEncode(payload)
	if not encoded then return false, "не удалось собрать JSON" end
	local ok, err = pcall(writefile, CONFIG_FILE, encoded)
	if not ok then return false, tostring(err) end
	return true
end

local function loadConfig()
	if not hasFileApi() or type(isfile) ~= "function" then return false, "нет isfile/readfile" end
	local exists = false
	pcall(function() exists = isfile(CONFIG_FILE) end)
	if not exists then return false, "config.json не найден" end
	local raw = nil
	pcall(function() raw = readfile(CONFIG_FILE) end)
	local data = jsonDecode(raw)
	if type(data) ~= "table" then return false, "битый config.json" end
	if type(data.settings) == "table" then
		for key, value in pairs(data.settings) do
			if DEFAULTS[key] ~= nil then State.settings[key] = value end
		end
	end
	if type(data.keys) == "table" then
		State.keys.gemini   = data.keys.gemini or State.keys.gemini
		State.keys.deepseek = data.keys.deepseek or State.keys.deepseek
	end
	State.targets = {}
	if type(data.targets) == "table" then
		for _, userId in ipairs(data.targets) do
			local id = tonumber(userId)
			if id then State.targets[id] = true end
		end
	end
	return true
end
-- ── Игроки и цели ────────────────────────────────────────────────────────────
local PlayerInfo = {}   -- [userId] = запись игрока

local function findPlayerByUserId(userId)
	if not userId or userId == 0 then return nil end
	return Players:GetPlayerByUserId(userId)
end

local function findPlayerByName(name)
	if type(name) ~= "string" then return nil end
	local lowered = string.lower(name)
	for _, player in ipairs(Players:GetPlayers()) do
		if string.lower(player.Name) == lowered or string.lower(player.DisplayName) == lowered then
			return player
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(player.Name), lowered, 1, true)
			or string.find(string.lower(player.DisplayName), lowered, 1, true) then
			return player
		end
	end
	return nil
end

local function refreshPlayers()
	local list, seen = {}, {}
	for _, player in ipairs(Players:GetPlayers()) do
		local info = {
			player   = player,
			userId   = player.UserId,
			name     = player.Name,
			display  = player.DisplayName,
			isSelf   = player == LocalPlayer,
			isTarget = State.targets[player.UserId] == true,
		}
		PlayerInfo[player.UserId] = info
		seen[player.UserId] = true
		table.insert(list, info)
	end
	for userId in pairs(PlayerInfo) do
		if not seen[userId] then
			PlayerInfo[userId] = nil
			State.targets[userId] = nil
		end
	end
	table.sort(list, function(a, b)
		if a.isSelf ~= b.isSelf then return a.isSelf == true end
		return string.lower(a.display) < string.lower(b.display)
	end)
	emit("players", list)
	return list
end

local function targetList()
	local list = {}
	for userId in pairs(State.targets) do
		local player = findPlayerByUserId(userId)
		if player then table.insert(list, player) end
	end
	table.sort(list, function(a, b) return a.UserId < b.UserId end)
	return list
end

local function targetNames()
	local names = {}
	for _, player in ipairs(targetList()) do table.insert(names, "@" .. player.Name) end
	return table.concat(names, ", ")
end

local function setTarget(userId, value)
	if value then State.targets[userId] = true else State.targets[userId] = nil end
	if PlayerInfo[userId] then PlayerInfo[userId].isTarget = value == true end
	emit("targets", targetList())
end

local function toggleTarget(userId)
	setTarget(userId, State.targets[userId] ~= true)
end

-- ── Лог чата ─────────────────────────────────────────────────────────────────
local LOG_LIMIT = 250
local recentSignatures = {}

local function isDuplicate(name, text)
	local signature = string.lower(tostring(name)) .. "\1" .. string.lower(tostring(text))
	local now = os.clock()
	local last = recentSignatures[signature]
	recentSignatures[signature] = now
	if last and (now - last) < 1.5 then return true end
	if #State.log > 40 and math.random(1, 20) == 1 then
		local cleaned = {}
		for key, stamp in pairs(recentSignatures) do
			if (now - stamp) < 30 then cleaned[key] = stamp end
		end
		recentSignatures = cleaned
	end
	return false
end

local function pushLog(entry)
	entry.time = entry.time or os.date("%H:%M:%S")
	entry.isTarget = State.targets[entry.userId or 0] == true
	table.insert(State.log, entry)
	if #State.log > LOG_LIMIT then table.remove(State.log, 1) end
	emit("log", entry, false)
	return entry
end

local function clearLog()
	State.log = {}
	recentSignatures = {}
	emit("log", nil, true)
end

local function recentContext(count, onlyTargets)
	count = count or 14
	local lines = {}
	for index = #State.log, 1, -1 do
		local entry = State.log[index]
		local keep = (not onlyTargets) or entry.isTarget or entry.isSelf
		if keep then
			local who = entry.isSelf and (LocalPlayer.DisplayName .. " (я)") or entry.display
			table.insert(lines, 1, who .. ": " .. entry.text)
			if #lines >= count then break end
		end
	end
	return table.concat(lines, "\n")
end

local function lastMessageFrom(userId)
	for index = #State.log, 1, -1 do
		local entry = State.log[index]
		if entry.userId == userId and not entry.isSelf then return entry end
	end
	return nil
end
