--// KILL AURA v3 - ДВА РЕЖИМА
-- Surviv: требует Tool в руках, спамит Activate + touch + remote
-- Monster: работает даже БЕЗ Tool (когти), бьет touch-ем своим телом + remote
task.spawn(function()
  while true do
    task.wait(0.15) -- быстро для баланса против пушек
    local active = S.AuraSurv or S.AuraMonster
    if active then
      pcall(function()
        local ch=LocalPlayer.Character if not ch then return end
        local hrp=ch:FindFirstChild("HumanoidRootPart") if not hrp then return end
        local tool=ch:FindFirstChildOfClass("Tool")
        -- если режим выжившего и нет тула в руках - эквип
        if S.AuraSurv and not tool then EquipBest() tool=ch:FindFirstChildOfClass("Tool") end
        -- монстру тул НЕ нужен, бьем телом
        for _,p in ipairs(Players:GetPlayers()) do
          if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
              local dist=(hrp.Position-p.Character.HumanoidRootPart.Position).Magnitude
              if dist<=S.AuraRadius then
                -- 1. Tool activate (для выживших)
                if tool then
                  -- для монстра с пушкой тоже сойдет
                  tool:Activate()
                  if tool:FindFirstChild("Handle") then
                    pcall(function()
                      firetouchinterest(tool.Handle, p.Character.HumanoidRootPart, 0) task.wait()
                      firetouchinterest(tool.Handle, p.Character.HumanoidRootPart, 1)
                    end)
                    -- дополнительно по голове и торсу
                    for _,partName in ipairs({"Head","UpperTorso","LowerTorso","Torso"}) do
                      local pt=p.Character:FindFirstChild(partName)
                      if pt then pcall(function()
                        firetouchinterest(tool.Handle, pt, 0) task.wait()
                        firetouchinterest(tool.Handle, pt, 1)
                      end) end
                    end
                  end
                else
                  -- 2. MONSTER MODE без тула: бьем своим HRP по врагу
                  for _,myPart in ipairs(ch:GetChildren()) do
                    if myPart:IsA("BasePart") then
                      pcall(function()
                        firetouchinterest(myPart, p.Character.HumanoidRootPart, 0) task.wait()
                        firetouchinterest(myPart, p.Character.HumanoidRootPart, 1)
                      end)
                      break -- одного достаточно чтобы не лагало
                    end
                  end
                end
                -- 3. Remote урон (и выжившим и монстрам)
                if #DamageRemotes>0 then
                  -- не спамим все 10 вариантов каждый тик, только 2 быстрых чтобы не кикнуло
                  for _,rem in ipairs(DamageRemotes) do
                    pcall(function() rem:FireServer(h, 9999) end)
                    pcall(function() rem:FireServer(p.Character, 9999) end)
                  end
                end
              end
            end
          end
        end
      end)
    end
  end
end)

