local function truncateText(text, maxLength)
	if #text <= maxLength then return text end
	return (string.sub(text, 1, maxLength - 3) .. "...")
end

-- Пунктуация для обрезки краёв слова.
-- ВАЖНО: многосимвольную пунктуацию (кавычки, тире) нельзя класть в класс [...],
-- потому что Lua работает побайтово: байты E2/80/9C/9D/9E/93/94/AB пересекаются
-- с вторыми байтами кириллицы (М, Н, О, Г, Д, Ы) и слово разваливалось бы.
-- Поэтому ASCII-пунктуация идёт классом, а многобайтовые символы — отдельными
-- строковыми паттернами (строка в паттерне сравнивается побайтово и целиком).
local EDGE_ASCII = "[\"%[%]{}(),;:!?%.%-_]+"
local EDGE_CHARS = { "«", "»", "“", "”", "„", "…", "—", "–", "‘", "’" }

local function stripEdges(raw)
	local cleaned = raw:gsub("^" .. EDGE_ASCII, ""):gsub(EDGE_ASCII .. "$", "")
	for _, char in ipairs(EDGE_CHARS) do
		cleaned = cleaned:gsub("^" .. char, ""):gsub(char .. "$", "")
	end
	return cleaned
end

local function tokenize(text)
	local tokens, seen = {}, {}
	for raw in string.gmatch(tostring(text), "%S+") do
		local cleaned = stripEdges(raw)
		if #cleaned >= 4 and not string.match(cleaned, "^%d+$") and not seen[cleaned] then
			seen[cleaned] = true
			table.insert(tokens, string.lower(cleaned))
		end
	end
	return tokens
end

local function urbanLookup(term)
	local response = httpRequest({
		url = "https://api.urbandictionary.com/v0/define?term=" .. urlEncode(term),
		headers = { ["Accept"] = "application/json" },
	})
	if not response.ok or response.status ~= 200 then return nil end
	local data = jsonDecode(response.body)
	local list = data and data.list
	if type(list) ~= "table" or #list == 0 then return nil end
	local best = list[1]
	local definition = tostring(best.definition or ""):gsub("%[", ""):gsub("%]", "")
	definition = trim(stripTags(htmlDecode(definition)))
	if #definition < 5 then return nil end
	local example = tostring(best.example or ""):gsub("%[", ""):gsub("%]", "")
	example = trim(stripTags(htmlDecode(example)))
	local text = truncateText(definition, 420)
	if #example > 10 then
		text = text .. " | пример: " .. truncateText(example, 160)
	end
	return { source = "Urban Dictionary", text = text }
end

local function wikiLookup(term)
	for _, lang in ipairs({ "ru", "en" }) do
		local url = ("https://%s.wikipedia.org/w/api.php?action=query&format=json"
			.. "&prop=extracts&exintro=1&explaintext=1&redirects=1&titles=%s")
			:format(lang, urlEncode(term))
		local response = httpRequest({ url = url, headers = { ["Accept"] = "application/json" } })
		if response.ok and response.status == 200 then
			local data = jsonDecode(response.body)
			local pages = data and data.query and data.query.pages
			if type(pages) == "table" then
				for _, page in pairs(pages) do
					local extract = page.extract
					if type(extract) == "string" and #extract > 40 and page.missing ~= true then
						return {
							source = "Wikipedia (" .. lang .. ")",
							text = truncateText(trim(extract), 500),
						}
					end
				end
			end
		end
	end
	return nil
end
local function ddgLookup(query)
	local url = "https://html.duckduckgo.com/html/?q=" .. urlEncode(query) .. "&kl=ru-ru"
	local response = httpRequest({
		url = url,
		headers = {
			["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
			["Accept-Language"] = "ru,en;q=0.8",
		},
	})
	if not response.ok or type(response.body) ~= "string" or #response.body < 200 then return nil end
	local snippets = {}
	for snippet in string.gmatch(response.body, 'result__snippet[^>]*>(.-)</a>') do
		local clean = trim(stripTags(htmlDecode(snippet)))
		if #clean > 30 then table.insert(snippets, clean) end
		if #snippets >= 3 then break end
	end
	if #snippets == 0 then
		for snippet in string.gmatch(response.body, 'result__snippet[^>]*>(.-)</div>') do
			local clean = trim(stripTags(htmlDecode(snippet)))
			if #clean > 30 then table.insert(snippets, clean) end
			if #snippets >= 3 then break end
		end
	end
	if #snippets == 0 then return nil end
	return { source = "DuckDuckGo", text = truncateText(table.concat(snippets, " / "), 600) }
end

local function researchTerm(term)
	if State.researchCache[term] then return State.researchCache[term] end
	local result = urbanLookup(term) or wikiLookup(term) or ddgLookup(term .. " slang meaning")
	State.researchCache[term] = result or { source = "нет данных", text = "" }
	return State.researchCache[term]
end

local function researchText(text, maxTerms)
	if State.settings.useResearch == false then return "" end
	maxTerms = maxTerms or 3
	local candidates = tokenize(text)

	local lines, fetched = {}, 0
	for _, term in ipairs(candidates) do
		if not STOP_WORDS[term] then
			local info = State.researchCache[term]
			if not info then
				if fetched >= maxTerms then break end
				fetched = fetched + 1
				info = researchTerm(term)
			end
			if info and info.text and info.text ~= "" then
				table.insert(lines, ("• «%s» (%s): %s"):format(term, info.source, info.text))
			end
		end
	end
	if #lines == 0 then return "" end
	return "ЛЕКСИКА/ФАКТЫ ИЗ ИНТЕРНЕТА (используй только это, не выдумывай):\n"
		.. table.concat(lines, "\n")
end

local function webSearch(query)
	return ddgLookup(query) or wikiLookup(query)
end

App.researchText = researchText
App.webSearch = webSearch
