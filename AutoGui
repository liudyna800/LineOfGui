local ok3, tools = pcall(buildTools)
if ok3 then safeWrite(FOLDER.."/tools.txt", tools) print("[Scanner] tools.txt OK") else warn("[Scanner] tools fail") end
task.wait(0.5)

local ok4, tree = pcall(buildTree)
if ok4 then safeWrite(FOLDER.."/full_tree.txt", tree) print("[Scanner] full_tree.txt OK ("..#tree.." bytes)") else warn("[Scanner] tree fail: "..tostring(tree)) end

