--[[ 
  INFECTIOUS SMILE SCANNER for Delta (эмулятор)
  Place: Infectious Smile by laughablehaha (5985232436)
  Human vs Smiling. Оружие: Bat/Bottle/Katana/Spear/Chain/Knife/Hatchet - у каждого Cooldown Value=0 = no cooldown (из опен-сорса).

  Запуск: в игре > Execute. Файлы: InfectiousSmile_Dump/
  + окно с текстом для Ctrl+C на эмуляторе.
]]

local FOLDER = "InfectiousSmile_Dump"
if not writefile or not makefolder then warn("[SmileScan] нужен Delta") return end
pcall(function() makefolder(FOLDER) end)

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local WS = game:GetService("Workspace")
local LP = Players.LocalPlayer
local function W(p,c) pcall(function() writefile(p,c) end) end
local function FP(i) local o,r=pcall(function() return i:GetFullName() end) if o then return r else return i.Name end end

local function isSmiler(plr)
  local info = {}
  local ch = plr.Character
  -- 1. атрибуты
  pcall(function()
    for k,v in pairs(plr:GetAttributes()) do info["PAttr:"..k]=tostring(v) end
    if ch then for k,v in pairs(ch:GetAttributes()) do info["CAttr:"..k]=tostring(v) end end
  end)
  -- 2. лицо Winning Smile / теги
  local face = "?"
  pcall(function()
    if ch and ch:FindFirstChild("Head") then
      for _,d in ipairs(ch.Head:GetChildren()) do
        if d:IsA("Decal") then face = d.Texture end
      end
    end
  end)
  -- 3. красный ник / Billboard
  local tag = "?"
  pcall(function()
    if ch and ch:FindFirstChild("Head") then
      for _,b in ipairs(ch.Head:GetChildren()) do
        if b:IsA("BillboardGui") or b:IsA("SurfaceGui") then tag = b.Name..":"..b.ClassName end
      end
    end
  end)
  -- 4. тул Sign (у смайлеров всегда Sign)
  local hasSign = ch and ch:FindFirstChild("Sign") ~= nil
  return info, face, tag, hasSign
end

--// SUMMARY
local L = {}
local function A(s) table.insert(L,s) end
A("=== INFECTIOUS SMILE DUMP ===")
A("Date: "..os.date("%Y-%m-%d %H:%M:%S"))
A("PlaceId: "..tostring(game.PlaceId).." JobId: "..tostring(game.JobId))
A("")
A("--- PLAYERS ("..#Players:GetPlayers()..") ---")
for _,p in ipairs(Players:GetPlayers()) do
  local attrs, face, tag, sign = isSmiler(p)
  A("Player: "..p.Name.." Display:"..p.DisplayName.." Team:"..(p.Team and p.Team.Name or "NIL"))
  A("  Sign in char: "..tostring(sign).." FaceTex: "..tostring(face):sub(1,60).." Tag: "..tostring(tag))
  for k,v in pairs(attrs) do A("    "..k.."="..v) end
  local ls = p:FindFirstChild("leaderstats")
  if ls then for _,v in ipairs(ls:GetChildren()) do A("    LS "..v.Name.."="..tostring(v.Value)) end end
  if p.Character then
    local tools = {}
    for _,t in ipairs(p.Character:GetChildren()) do if t:IsA("Tool") then table.insert(tools,t.Name) end end
    A("    CharTools: "..table.concat(tools,", "))
  end
  local bp = p:FindFirstChild("Backpack")
  if bp and p==LP then
    local bt = {}
    for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(bt,t.Name) end end
    A("    Backpack: "..table.concat(bt,", "))
  end
end
A("")

--// TOOLS + COOLDOWN (главное из опен-сорса)
A("--- TOOLS + COOLDOWN (NoCooldown = Cooldown.Value=0) ---")
local seen = 0
for _,src in ipairs({LP.Character or WS, LP:FindFirstChild("Backpack") or RS, RS, WS}) do
  local ok,nm = pcall(function() return src:GetFullName() end)
  A(">> "..(ok and nm or "?"))
  for _,d in ipairs(src:GetDescendants()) do
    if d:IsA("Tool") and seen < 100 then
      seen = seen+1
      local cd = d:FindFirstChild("Cooldown")
      local cdv = cd and tostring(cd.Value) or "NO Cooldown obj"
      A("[Tool] "..FP(d).." Cooldown="..cdv)
      -- внутренности тула
      for _,c in ipairs(d:GetChildren()) do
        A("    - "..c.ClassName.." "..c.Name..(c:IsA("ValueBase") and ("="..tostring(c.Value)) or ""))
      end
    end
  end
end
A("")

--// LIGHTS (Infecting / Depressing) + Rob + Keys
A("--- LIGHTS / ROB / KEYS / MAP (поиск по именам) ---")
local keys = {"infect","depress","curing","rob","key","safe","slime","sign","taser","potion","giant","grab","smile","wall","fortress","spawn","map"}
local f = 0
for _,d in ipairs(WS:GetDescendants()) do
  if f>250 then break end
  local ln = string.lower(d.Name)
  for _,k in ipairs(keys) do
    if string.find(ln,k) then
      A("["..d.ClassName.."] "..FP(d))
      f=f+1 break
    end
  end
end
A("matches: "..f)
A("")

--// REMOTES
A("--- REMOTES (топ 100, полный список в remotes.txt) ---")
local rc=0
for _,d in ipairs(game:GetDescendants()) do
  if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
    rc=rc+1
    if rc<=100 then A("["..d.ClassName.."] "..FP(d)) end
  end
end
A("TOTAL remotes: "..rc)

W(FOLDER.."/summary.txt", table.concat(L,"\n"))
print("[SmileScan] summary OK")

