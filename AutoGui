--// ESP (короткий)
function ApplyESP(p)
  if p==LocalPlayer then return end
  if not p.Character or not p.Character:FindFirstChild("Head") then return end
  pcall(function()
    local h=p.Character:FindFirstChild("ESP_H") if h then h:Destroy() end
    local b=p.Character:FindFirstChild("ESP_B") if b then b:Destroy() end
  end)
  if not S.ESP then return end
  if not IsEnemy(p) then return end
  local col=TeamColor(p)
  local hl=Instance.new("Highlight") hl.Name="ESP_H"
  hl.FillColor=col hl.OutlineColor=col hl.FillTransparency=0.55
  hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop hl.Parent=p.Character
end
task.spawn(function() while true do task.wait(2) for _,p in ipairs(Players:GetPlayers()) do pcall(ApplyESP,p) end end end)

--// 1. VISUAL BRING + KILL ТВОЙ СПОСОБ
-- Каждый кадр: ставим чужое тело перед собой (визуал) + СРАЗУ касаемся его хитбокса через firetouchinterest (реальный урон)
-- Ты прав: визуал сам не бьет, но связка визуал + firetouch = убивает, т.к. firetouch не проверяет дистанцию
RunService.RenderStepped:Connect(function()
  if not S.BringVisual then return end
  pcall(function()
    local ch=LocalPlayer.Character if not ch then return end
    local myHRP=ch:FindFirstChild("HumanoidRootPart") if not myHRP then return end
    local tool=ch:FindFirstChildOfClass("Tool")
    local touchPart = myHRP
    if tool and tool:FindFirstChild("Handle") then touchPart = tool.Handle end
    local idx=0
    for _,p in ipairs(Players:GetPlayers()) do
      if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        local eHRP=p.Character.HumanoidRootPart
        local hum=p.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health>0 then
          idx=idx+1
          -- сетка перед лицом: 3 в ряд
          local row = math.floor((idx-1)/3)
          local colI = (idx-1)%3 - 1 -- -1,0,1
          local target = myHRP.CFrame * CFrame.new(colI*4, 0.5, -S.BringDist - row*4)
          -- визуально тянем: отключаем коллизию локально чтобы не толкались
          eHRP.CanCollide=false
          eHRP.CFrame=target
          -- ТВОЙ СПОСОБ: сразу касаемся хитбокса - это и дает килл на сервере
          -- визуал без этого не бьет, а с firetouch бьет даже если сервер не видит позицию
          if S.BringKill then
            if tool then tool:Activate() end
            pcall(function()
              firetouchinterest(touchPart, eHRP, 0)
              firetouchinterest(touchPart, eHRP, 1)
            end)
            -- по голове тоже для верности
            local head = p.Character:FindFirstChild("Head")
            if head then
              pcall(function()
                firetouchinterest(touchPart, head, 0)
                firetouchinterest(touchPart, head, 1)
              end)
            end
          end
        end
      end
    end
  end)
end)

--// 2. REAL TELEPORT-KILL - телепортит ТЕБЯ к врагу (сервер это видит!)
-- Обходит проверку "игрок далеко". После удара возвращает назад.
task.spawn(function()
  while true do
    task.wait(S.TeleKillDelay)
    if S.TeleKill then
      pcall(function()
        local ch=LocalPlayer.Character if not ch then return end
        local myHRP=ch:FindFirstChild("HumanoidRootPart") if not myHRP then return end
        local myHum=ch:FindFirstChildOfClass("Humanoid") if not myHum then return end
        local home=myHRP.CFrame
        local tool=ch:FindFirstChildOfClass("Tool")
        for _,p in ipairs(Players:GetPlayers()) do
          if not S.TeleKill then break end
          if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
              local eHRP=p.Character.HumanoidRootPart
              -- прыжок к врагу (серверная позиция!)
              -- ВАЖНО: ставим себя чуть сбоку чтобы не застрять
              myHRP.CFrame=eHRP.CFrame * CFrame.new(0,0,2)
              task.wait(0.08)
              -- удар
              if tool then tool:Activate() end
              if tool and tool:FindFirstChild("Handle") then
                pcall(function()
                  firetouchinterest(tool.Handle, eHRP, 0) task.wait()
                  firetouchinterest(tool.Handle, eHRP, 1)
                end)
              else
                -- монстр без тула: бьем телом
                pcall(function()
                  firetouchinterest(myHRP, eHRP, 0) task.wait()
                  firetouchinterest(myHRP, eHRP, 1)
                end)
              end
              task.wait(0.05)
            end
          end
        end
        -- возврат домой чтобы не убили пока летаешь
        pcall(function() myHRP.CFrame=home end)
      end)
    end
  end
end)

--// 3. AURA + HITBOX (добивание когда все рядом)
task.spawn(function()
  while true do
    task.wait(0.2)
    if S.AuraMonster then
      pcall(function()
        local ch=LocalPlayer.Character if not ch then return end
        local hrp=ch:FindFirstChild("HumanoidRootPart") if not hrp then return end
        local tool=ch:FindFirstChildOfClass("Tool")
        for _,p in ipairs(Players:GetPlayers()) do
          if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 and (hrp.Position-p.Character.HumanoidRootPart.Position).Magnitude<=S.AuraRadius then
              if tool then tool:Activate() end
              if tool and tool:FindFirstChild("Handle") then
                pcall(function() firetouchinterest(tool.Handle,p.Character.HumanoidRootPart,0) task.wait() firetouchinterest(tool.Handle,p.Character.HumanoidRootPart,1) end)
              else
                pcall(function() firetouchinterest(hrp,p.Character.HumanoidRootPart,0) task.wait() firetouchinterest(hrp,p.Character.HumanoidRootPart,1) end)
              end
            end
          end
        end
      end)
    end
  end
end)

task.spawn(function()
  while true do
    task.wait(1)
    if S.Hitbox then
      for _,p in ipairs(Players:GetPlayers()) do
        if IsEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
          pcall(function()
            local r=p.Character.HumanoidRootPart
            r.Size=Vector3.new(S.HitboxSize,S.HitboxSize,S.HitboxSize)
            r.Transparency=0.7 r.CanCollide=false
          end)
        end
      end
    end
  end
end)

