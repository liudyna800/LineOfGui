App.maybeAutoReply = function(entry)
	if State.generating then return end

	local now = os.clock()
	local fresh = {}
	for _, stamp in ipairs(State.autoStamps) do
		if (now - stamp) < 60 then table.insert(fresh, stamp) end
	end
	State.autoStamps = fresh

	local maxPerMinute = math.max(1, State.settings.autoPerMinute or 5)
	if #State.autoStamps >= maxPerMinute then
		setStatus("лимит авто-ответов в минуту исчерпан", Theme.warn)
		return
	end

	local cooldown = math.max(3, State.settings.autoCooldown or 8)
	local lastStamp = State.autoStamps[#State.autoStamps]
	if lastStamp and (now - lastStamp) < cooldown then return end

	table.insert(State.autoStamps, now)
	runGeneration(entry, nil, "send", "авто-ответ")
end
