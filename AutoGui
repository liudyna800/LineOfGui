local function postJson(url, headers, bodyTable)
	local payload = jsonEncode(bodyTable)
	if not payload then return { ok = false, error = "не удалось собрать JSON запроса" } end
	local finalHeaders = {}
	for key, value in pairs(headers or {}) do finalHeaders[key] = value end
	finalHeaders["Content-Type"] = "application/json"
	return httpRequest({ url = url, method = "POST", headers = finalHeaders, body = payload })
end

-- ── Gemini: POST /v1beta/models/{model}:generateContent ──────────────────────
local function geminiCall(cfg, model, useTools, keyInQuery)
	local url = "https://generativelanguage.googleapis.com/v1beta/models/"
		.. model .. ":generateContent"
	local headers = {}
	local apiKey = trim(cfg.apiKey or "")
	if keyInQuery then
		url = url .. "?key=" .. urlEncode(apiKey)
	else
		headers["x-goog-api-key"] = apiKey
	end

	local body = {
		systemInstruction = { parts = { { text = cfg.system } } },
		contents = { { role = "user", parts = { { text = cfg.user } } } },
		generationConfig = {
			temperature = cfg.temperature or 0.7,
			maxOutputTokens = cfg.maxTokens or 512,
			topP = 0.95,
			candidateCount = 1,
		},
		safetySettings = {
			{ category = "HARM_CATEGORY_HARASSMENT", threshold = "BLOCK_ONLY_HIGH" },
			{ category = "HARM_CATEGORY_HATE_SPEECH", threshold = "BLOCK_ONLY_HIGH" },
			{ category = "HARM_CATEGORY_SEXUALLY_EXPLICIT", threshold = "BLOCK_ONLY_HIGH" },
			{ category = "HARM_CATEGORY_DANGEROUS_CONTENT", threshold = "BLOCK_ONLY_HIGH" },
		},
	}
	if useTools then body.tools = { { googleSearch = {} } } end

	local response = postJson(url, headers, body)
	if not response.ok then
		return { ok = false, error = response.error or "нет связи с API", status = 0 }
	end
	local data = jsonDecode(response.body)
	if type(data) ~= "table" then
		return { ok = false, error = "ответ не JSON (HTTP " .. tostring(response.status) .. ")", status = response.status }
	end
	if data.error then
		return {
			ok = false,
			error = tostring(data.error.message or "ошибка API"),
			status = response.status,
		}
	end

	local candidate = data.candidates and data.candidates[1]
	local parts = candidate and candidate.content and candidate.content.parts
	local text = ""
	if type(parts) == "table" then
		for _, part in ipairs(parts) do
			if type(part.text) == "string" then text = text .. part.text end
		end
	end
	if trim(text) == "" then
		local reason = (data.promptFeedback and data.promptFeedback.blockReason)
			or (candidate and candidate.finishReason) or "нет данных"
		return { ok = false, error = "пустой ответ модели (" .. tostring(reason) .. ")", status = response.status }
	end

	local sources = 0
	local grounding = candidate and candidate.groundingMetadata
	if type(grounding) == "table" and type(grounding.groundingChunks) == "table" then
		sources = #grounding.groundingChunks
	end
	return { ok = true, text = text, status = response.status, sources = sources, model = model }
end

local providers = {}

providers.gemini = {
	key = "gemini",
	label = "Google Gemini",
	models = PROVIDER_MODELS.gemini,
	generate = function(cfg)
		local apiKey = trim(cfg.apiKey or "")
		if apiKey == "" then
			return { ok = false, error = "укажи API-ключ Gemini во вкладке «Настройки»" }
		end
		local model = trim(cfg.model or "")
		if model == "" then model = PROVIDER_MODELS.gemini[1] end

		local attempts = {}
		if cfg.useSearch then table.insert(attempts, { tools = true, query = false }) end
		table.insert(attempts, { tools = false, query = false })
		table.insert(attempts, { tools = false, query = true })

		local lastError = nil
		for _, attempt in ipairs(attempts) do
			local result = geminiCall(cfg, model, attempt.tools, attempt.query)
			if result.ok then return result end
			lastError = result
			local lowered = string.lower(tostring(result.error or ""))
			if result.status == 404 or string.find(lowered, "not found", 1, true)
				or string.find(lowered, "not supported", 1, true) then
				break
			end
		end

		for _, fallback in ipairs(PROVIDER_MODELS.gemini) do
			if fallback ~= model then
				local result = geminiCall(cfg, fallback, false, false)
				if result.ok then return result end
				lastError = result
			end
		end
		return lastError or { ok = false, error = "Gemini не ответил" }
	end,
}
-- ── DeepSeek: POST /chat/completions (модель deepseek-flash = V4.1-Flash) ─────
providers.deepseek = {
	key = "deepseek",
	label = "DeepSeek",
	models = PROVIDER_MODELS.deepseek,
	generate = function(cfg)
		local apiKey = trim(cfg.apiKey or "")
		if apiKey == "" then
			return { ok = false, error = "укажи API-ключ DeepSeek во вкладке «Настройки»" }
		end
		local model = trim(cfg.model or "")
		if model == "" then model = PROVIDER_MODELS.deepseek[1] end

		local function attempt(targetModel, withThinkingFlag)
			local body = {
				model = targetModel,
				messages = {
					{ role = "system", content = cfg.system },
					{ role = "user", content = cfg.user },
				},
				stream = false,
				max_tokens = cfg.maxTokens or 512,
				temperature = cfg.temperature or 0.7,
			}
			if withThinkingFlag then body.thinking = { type = "disabled" } end

			local response = postJson("https://api.deepseek.com/chat/completions",
				{ ["Authorization"] = "Bearer " .. apiKey }, body)
			if not response.ok then
				return { ok = false, error = response.error or "нет связи с API", status = 0 }
			end
			local data = jsonDecode(response.body)
			if type(data) ~= "table" then
				return { ok = false, error = "ответ не JSON (HTTP " .. tostring(response.status) .. ")", status = response.status }
			end
			if data.error then
				return { ok = false, error = tostring(data.error.message or "ошибка API"), status = response.status }
			end
			local choice = data.choices and data.choices[1]
			local message = (choice and choice.message) or {}
			local text = message.content
			if type(text) ~= "string" or trim(text) == "" then text = message.reasoning_content end
			if type(text) ~= "string" or trim(text) == "" then
				return { ok = false, error = "пустой ответ модели", status = response.status }
			end
			return { ok = true, text = text, status = response.status, model = targetModel }
		end

		local result = attempt(model, true)
		if not result.ok and result.status == 400 then
			result = attempt(model, false)
		end
		if not result.ok then
			for _, fallback in ipairs(PROVIDER_MODELS.deepseek) do
				if fallback ~= model then
					local retry = attempt(fallback, true)
					if retry.ok then return retry end
					result = retry
				end
			end
		end
		return result
	end,
}

local function getProvider()
	local key = State.settings.provider or "gemini"
	return providers[key] or providers.gemini, providers[key] and key or "gemini"
