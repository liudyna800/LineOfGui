-- Функция проверки ключей у игрока (можно настроить под конкретную игру)
local function GetPlayerKey(player)
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    -- Проверка в рюкзаке и в руках
    local containers = {backpack, character}
    
    local hasRed = false
    local hasGreen = false
    local hasWhite = false

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                local name = item.Name:lower()
                if name:find("red key") or name:find("красный ключ") then
                    hasRed = true
                elseif name:find("green key") or name:find("зеленый ключ") then
                    hasGreen = true
                elseif name:find("key") or name:find("white key") or name:find("белый ключ") then
                    hasWhite = true
                end
            end
        end
    end

    if hasRed then return "Red Key", Color3.fromRGB(255, 75, 75)
    elseif hasGreen then return "Green Key", Color3.fromRGB(75, 255, 75)
    elseif hasWhite then return "Key (White)", Color3.fromRGB(240, 240, 240)
    else return "No Key", Color3.fromRGB(120, 120, 120) end
end

-- Обновление списка игроков
local function UpdatePlayerList()
    -- Очищаем старые элементы
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    -- Заполняем новыми
    for _, player in ipairs(Players:GetPlayers()) do
        local keyText, keyColor = GetPlayerKey(player)

        local PlayerRow = Instance.new("Frame")
        PlayerRow.Size = UDim2.new(1, 0, 0, 26)
        PlayerRow.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        PlayerRow.BorderSizePixel = 0
        
        local RowCorner = Instance.new("UICorner")
        RowCorner.CornerRadius = UDim.new(0, 4)
        RowCorner.Parent = PlayerRow

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(0.6, 0, 1, 0)
        NameLabel.Position = UDim2.new(0, 8, 0, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = player.Name
        NameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        NameLabel.TextSize = 12
        NameLabel.Font = Enum.Font.SourceSans
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.Parent = PlayerRow

        local StatusLabel = Instance.new("TextLabel")
        StatusLabel.Size = UDim2.new(0.4, -8, 1, 0)
        StatusLabel.Position = UDim2.new(0.6, 0, 0, 0)
        StatusLabel.BackgroundTransparency = 1
        StatusLabel.Text = keyText
        StatusLabel.TextColor3 = keyColor
        StatusLabel.TextSize = 12
        StatusLabel.Font = Enum.Font.SourceSansBold
        StatusLabel.TextXAlignment = Enum.TextXAlignment.Right
        StatusLabel.Parent = PlayerRow

        PlayerRow.Parent = ScrollFrame
    end

    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 30)
end

-- Автообновление списка каждую секунду
task.spawn(function()
    while true do
        pcall(UpdatePlayerList)
        task.wait(1)
    end
end)
