local function buildContext(entry)
	local context = recentContext(16, true)
	local targetName, targetDisplay, theirMessage = nil, nil, nil

	if entry then
		targetName = entry.name
		targetDisplay = entry.display
		theirMessage = entry.text
	else
		local targets = targetList()
		if #targets > 0 then
			local player = targets[1]
			targetName = player.Name
			targetDisplay = player.DisplayName
			local last = lastMessageFrom(player.UserId)
			if last then theirMessage = last.text end
		end
	end
	return context, targetName, targetDisplay, theirMessage
end

local function modeLabel()
	local names = { calm = "спокойный", mid = "средний", hard = "жёсткий" }
	return names[State.settings.mode] or "спокойный"
end

-- entry — сообщение цели (может быть nil), draft — мой черновик,
-- action — "draft" (вставить в поле) | "send" (сразу отправить)
local function runGeneration(entry, draft, action, label)
	if State.generating then
		setStatus("запрос уже выполняется, подожди", Theme.warn)
		return
	end

	local context, targetName, targetDisplay, theirMessage = buildContext(entry)
	if not targetName and (not draft or trim(draft) == "") then
		setStatus("нужна цель (вкладка «Цели») или свой черновик в поле", Theme.warn)
		return
	end

	State.generating = true
	setStatus(("⏳ %s • режим: %s"):format(label or "ИИ думает", modeLabel()), Theme.accent)

	task.spawn(function()
		local research = ""
		if State.settings.useResearch ~= false then
			local source = tostring(theirMessage or "") .. " " .. tostring(draft or "")
			local ok, text = pcall(researchText, source, 2)
			if ok and type(text) == "string" then research = text end
		end

		local result = generateReply({
			context = context,
			targetName = targetName,
			targetDisplay = targetDisplay,
			theirMessage = theirMessage,
			draft = draft,
			research = research,
			useSearch = true,
		})
		State.generating = false

		if not result.ok then
			setStatus("ошибка ИИ: " .. tostring(result.error), Theme.danger)
			return
		end

		local suffix = result.sources > 0 and (" • источников: %d"):format(result.sources) or ""

		if action == "send" then
			local messages = result.messages
			for index, message in ipairs(messages) do
				local ok, err = sendChatMessage(message)
				if not ok then
					setStatus("не отправлено: " .. tostring(err), Theme.danger)
					return
				end
				if index < #messages then task.wait(0.9) end
			end
			setStatus(("отправлено: %d сообщ. • %s%s"):format(#messages, tostring(result.model), suffix),
				Theme.accent2)
		else
			App.setDraft(result.text)
			setStatus("текст готов — проверь в поле ввода и жми «Отправить»" .. suffix, Theme.accent2)
		end
	end)
end

