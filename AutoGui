--------------------------------------------------------------------------------
-- 3. Механика перетаскивания (Drag)
--------------------------------------------------------------------------------

local dragging, dragInput, dragStart, startPos

local function updateDrag(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateDrag(input)
    end
end)

--------------------------------------------------------------------------------
-- 4. Поиск в каталоге и генерация карточек
--------------------------------------------------------------------------------

local function SearchEmotes(keyword)
    -- Очистка старых результатов
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    -- Настройка параметров поиска
    local searchParams = CatalogSearchParams.new()
    searchParams.SearchKeyword = keyword or ""
    searchParams.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
    searchParams.CategoryFilter = Enum.CatalogCategoryFilter.None
    searchParams.SalesTypeFilter = Enum.SalesTypeFilter.All
    searchParams.IncludeOffSale = true
    searchParams.Limit = 20

    local success, pages = pcall(function()
        return AvatarEditorService:SearchCatalog(searchParams)
    end)

    if not success or not pages then return end

    local pageData = pages:GetCurrentPage()

    for _, item in ipairs(pageData) do
        -- Кнопка эмоции
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Size = UDim2.new(1, 0, 0, 36)
        ItemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        ItemBtn.Text = "   " .. (item.Name or "Unknown Emote")
        ItemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
        ItemBtn.Font = Enum.Font.Gotham
        ItemBtn.TextSize = 12
        ItemBtn.Parent = ScrollFrame

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 6)
        BtnCorner.Parent = ItemBtn

        -- Обработка нажатия на элемент списка
        ItemBtn.MouseButton1Click:Connect(function()
            PlayEmote(item.Id)
        end)
    end
end

-- Вызов поиска при нажатии Enter в TextBox
SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SearchEmotes(SearchBox.Text)
    end
end)

-- Автоматический начальный поиск при запуске
SearchEmotes("")
