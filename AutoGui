-- Simple Fly (работает на Delta mobile: кнопка + джойстик)
local flyConn, flyGyro, flyVel
TabPlayer:CreateToggle({
    Name = "Fly (мобильный)",
    CurrentValue = false,
    Flag = "FlyToggle",
    Callback = function(v)
        State.Fly = v
        local hrp = MyHRP()
        if not hrp then return end
        if v then
            flyGyro = Instance.new("BodyGyro", hrp)
            flyGyro.P = 9e4
            flyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            flyGyro.cframe = hrp.CFrame
            flyVel = Instance.new("BodyVelocity", hrp)
            flyVel.velocity = Vector3.new(0,0,0)
            flyVel.maxForce = Vector3.new(9e9, 9e9, 9e9)
            flyConn = RunService.RenderStepped:Connect(function()
                if not State.Fly or not MyHRP() then return end
                local hum = MyHum()
                if hum then hum.PlatformStand = true end
                local move = hum and hum.MoveDirection or Vector3.new(0,0,0)
                local up = 0
                if UIS:IsKeyDown(Enum.KeyCode.Space) then up = 1 end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then up = -1 end
                pcall(function()
                    flyVel.velocity = (move * State.FlySpeed) + Vector3.new(0, up * State.FlySpeed, 0)
                    flyGyro.cframe = workspace.CurrentCamera.CFrame
                end)
            end)
            Notify("Fly", "Fly ВКЛ. На телефоне используй джойстик для движения", 4)
        else
            if flyConn then flyConn:Disconnect() flyConn = nil end
            if flyGyro then flyGyro:Destroy() flyGyro = nil end
            if flyVel then flyVel:Destroy() flyVel = nil end
            pcall(function() MyHum().PlatformStand = false end)
        end
    end,
})

